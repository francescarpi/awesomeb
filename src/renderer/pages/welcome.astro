---
import Layout from '#/layouts/Base.astro';
import logo from '../assets/icon.png';
---

<Layout>
  <div class="bg-black fixed inset-0 flex flex-col justify-center items-center" id="container">
    <img src={logo.src} alt="AwesomeB" width="64" height="64" />
    <p class="text-white text-2xl mt-4 absolute font-mono">
      Welcome to <b>AwesomeB(rowser)</b>
    </p>
    <button class="btn absolute mt-25">Continue</button>
  </div>
</Layout>

<script>
  abWelcome.ready();
</script>

<style>
  img {
    width: 100%;
    height: auto;
    animation: imgAnimation 2s ease-in-out forwards;
  }

  p {
    animation: pAnimation 3s ease-in-out forwards;
  }

  button {
    animation: btnAnimation 4s ease-in-out forwards;
  }

  @keyframes imgAnimation {
    0% {
      filter: grayscale(1) blur(6px);
      transform: scale(1);
    }
    30% {
      filter: grayscale(0) blur(0);
      transform: scale(1);
    }
    100% {
      transform: translate(0, -100px) scale(0.1);
    }
  }

  @keyframes pAnimation {
    0% {
      filter: opacity(0);
      transform: translateY(0);
    }
    55% {
      filter: opacity(0);
      transform: translateY(0);
    }
    100% {
      filter: opacity(1);
      transform: translateY(-50%);
    }
  }
  @keyframes btnAnimation {
    0% {
      filter: opacity(0);
    }
    75% {
      filter: opacity(0);
    }
    100% {
      filter: opacity(1);
    }
  }
</style>
