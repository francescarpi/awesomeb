---
import BlackBgWithTitle from '#/layouts/BlackBgWithTitle.astro';
---

<BlackBgWithTitle title="pages:bookmarks.title">
  <div id="content" class="fixed top-16 bottom-4 right-4 left-4"></div>
</BlackBgWithTitle>

<script>
  import { type IBookmark, EBookmarkType, type IFolderBookmark } from '~/types';
  import { Renderer, h, c, type VNode, icon } from '#/scripts';
  import Folder from '#/icons/folder.svg?raw';
  import ArrowDown from '#/icons/arrow-down.svg?raw';

  const t = await abI18n.t(-1, [
    { key: 'save' },
    { key: 'move' },
    { key: 'delete' },
    { key: 'pages:bookmarks.deleteConfirm' },
    { key: 'pages:bookmarks.selectNewParent' },
    { key: 'pages:bookmarks.root' },
    { key: 'pages:bookmarks.title' },
    { key: 'pages:bookmarks.noBookmarks' },
  ]);

  document.title = t['pages:bookmarks.title'];

  const renderer = new Renderer(h('div', null)).render('content');

  abBookmarks.get().then((bookmarks) => {
    renderBookmarks(bookmarks);
  });

  function renderBookmarks(bookmarks: IBookmark[]) {
    if (bookmarks.length === 0) {
      renderer.update(h('div', {}, t['pages:bookmarks.noBookmarks']));
      return;
    }

    renderer.update(
      h(
        'div',
        { class: c('grid', 'grid-cols-[290px_2fr]', 'gap-2', 'h-full') },
        h('div', { class: c('bg-white/40', 'p-2') }, ...renderFolders(bookmarks)),
        h('div', {}, 'Content'),
      ),
    );
  }

  function renderFolders(items: IBookmark[], level: number = 0): VNode[] {
    const response: VNode[] = [];

    for (const item of items) {
      if (item.type === EBookmarkType.Url) {
        continue;
      }

      const hasFolders = item.children.some((c) => c.type === EBookmarkType.Folder);

      response.push(
        h(
          'div',
          { class: c(`ml-[${level}rem]`, 'mb-2', 'flex', 'items-center', 'gap-1') },
          h('div', { class: c(!hasFolders && 'invisible') }, icon(ArrowDown, 'text-black', '7')),
          h('div', {}, icon(Folder, 'text-black', '4')),
          h('div', {}, item.title),
        ),
      );

      if (item.children.length > 0) {
        response.push(...renderFolders(item.children, level + 1));
      }
    }
    return response;
  }
</script>
