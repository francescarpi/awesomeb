---

<div class="flex items-center justify-between gap-2" id="desktops"></div>

<script>
  import { IDesktopEntity } from '~/types';
  import { getSearchParams } from '#/scripts';

  const { winId } = getSearchParams();
  const desktopsContainer = document.getElementById('desktops')!;

  // Load and render desktops on initialization
  const desktops = await abEntities.fetch<IDesktopEntity>(winId, 'desktops');
  renderDesktops(desktops);

  // Subscribe to desktop updates
  abDesktops.onRefresh((_event, desktops) => {
    renderDesktops(desktops);
  });

  /**
   * Renders the list of desktops in the UI
   * @param desktops - Array of desktop entities to render
   */
  function renderDesktops(desktops: IDesktopEntity[]) {
    desktopsContainer.innerHTML = '';
    const totalDesktops = desktops.length.toString();
    for (const desktop of desktops) {
      renderDesktop(
        desktop,
        desktop.id === '1' ? 'first' : desktop.id === totalDesktops ? 'last' : 'other',
      );
    }
  }

  /**
   * Renders a single desktop item in the UI
   * @param desktop - The desktop entity to render
   * @return void
   */
  function renderDesktop(desktop: IDesktopEntity, position: 'first' | 'last' | 'other') {
    const container = document.createElement('div');
    container.classList.add('group', 'relative');

    const desktopElement = document.createElement('div');
    desktopElement.classList.add(
      'border',
      'rounded-full',
      'sidebar:w-9',
      'sidebar:h-9',
      'sidebar:text-sm',
      'w-7',
      'h-7',
      'text-xs',
      'cursor-pointer',
      'sidebar:flex',
      'items-center',
      'justify-center',
      'hidden',
      'group-[.selected]:flex',
    );
    desktopElement.style = 'app-region: no-drag;';
    desktopElement.textContent = desktop.id.toString();

    if (desktop.selected) {
      container.classList.add('selected');
      desktopElement.classList.add('bg-white/20');
    }

    const desktopName = document.createElement('span');
    desktopName.classList.add(
      'sidebar:group-[.selected]:block',
      'sidebar:group-hover:block',
      'hidden',
      'text-[10px]',
      'absolute',
      'mt-1',
      'whitespace-nowrap',
    );
    desktopName.textContent = desktop.name;

    if (position === 'first') {
      desktopName.classList.add('left-0');
    } else if (position === 'last') {
      desktopName.classList.add('right-0');
    } else {
      desktopName.classList.add('left-1/2', '-translate-x-1/2');
    }

    container.appendChild(desktopElement);
    container.appendChild(desktopName);

    desktopsContainer.appendChild(container);
  }
</script>
