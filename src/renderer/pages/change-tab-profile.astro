---
import ListWithSearch from '#/components/common/ListWithSearch.astro';
import Modal from '#/layouts/Modal.astro';
import Title from '#/components/common/Title.astro';
---

<Modal>
  <Title><span id="title-tab-change-profile">Change Tab Profile</span></Title>
  <ListWithSearch placeholder="Select new tab's profile..." id="list" />
</Modal>

<script>
  import { getSearchParams, listWithSearchManager } from '#/scripts';
  import {
    initI18n,
    setText,
    setPlaceholder,
    setListEmptyText,
    onLocaleChange,
  } from '#/scripts/i18n';

  await initI18n();

  function apply() {
    setText('title-tab-change-profile', 'pages.tabChangeProfile.title');
    setPlaceholder('list', 'pages.tabChangeProfile.listPlaceholder');
    setListEmptyText();
  }
  apply();
  onLocaleChange(apply);

  const { winId } = getSearchParams();

  listWithSearchManager('list', {
    entity: 'partitions',
    onAccept: (item) => {
      abCommands.perform(winId, 'change-tab-profile', { partitionId: item.id });
    },
    onEscape: () => {
      abModal.close(winId);
    },
  });
</script>
