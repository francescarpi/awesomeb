---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<h1 class="text-lg mb-2 opacity-30" data-title={title}><slot /></h1>

<script>
  import { getSearchParams } from '#/scripts';

  const { winId } = getSearchParams();

  const h1 = document.querySelector('h1[data-title]') as HTMLElement;
  h1.textContent = await abI18n.t(winId, h1.dataset.title as string);
</script>
