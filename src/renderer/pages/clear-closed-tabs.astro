---
import Modal from '#/layouts/Modal.astro';
---

<Modal>
  <div id="container"></div>
</Modal>

<script>
  import { Renderer, h, getSearchParams, confirmButtons } from '#/scripts';

  const { winId } = getSearchParams();

  const [btns, registerBtnsEvents] = await confirmButtons({
    winId,
    onConfirm: () => abCommands.perform(winId, 'clear-closed-tabs'),
    onCancel: () => abModal.close(winId),
  });

  const t = await abI18n.t({ winId }, [{ key: 'pages:clearClosedTabs.message' }]);

  new Renderer(
    h(
      'div',
      { classs: 'flex flex-col gap-3' },
      h('p', { class: 'text-md my-6' }, t['pages:clearClosedTabs.message']),
      h('div', { class: 'flex justify-center gap-3' }, ...btns),
    ),
  ).render('container', { onRendered: registerBtnsEvents });
</script>
