---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div class="bg-linear-to-br from-gray-800 to-gray-900 border border-gray-700 rounded p-4">
  <h1 class="text-md text-primary">{title}</h1>
  <p class="text-xs text-gray-400">{description}</p>
  <div class="mt-2">
    <slot />
  </div>
</div>
