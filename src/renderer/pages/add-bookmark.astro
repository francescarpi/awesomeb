---
import BlackBgWithTitle from '#/layouts/BlackBgWithTitle.astro';
---

<BlackBgWithTitle>
  <div class="flex flex-col gap-4">
    <input
      class="input w-full text-black rounded-full"
      placeholder="Folder name..."
      id="folder-name"
    />
    <input class="input w-full text-black rounded-full" placeholder="Title..." id="title" />
    <input class="input w-full text-black rounded-full" placeholder="Url..." id="url" />
  </div>
</BlackBgWithTitle>

<script>
  import { getSearchParams, inputManager } from '#/scripts';

  const { winId, searchParams } = getSearchParams();

  const title = searchParams.get('title')!;
  const url = searchParams.get('url')!;
  const folderId = searchParams.get('folderId')!;
  const folderName = searchParams.get('folderName')!;
  const createFolder = searchParams.get('createFolder');
  const h1 = document.querySelector('h1')!;

  const {
    setVisible: setFolderNameVisible,
    focus: focusFolderName,
    getValue: getFolderName,
  } = inputManager('folder-name', {
    onAccept: () => handleSubmit(),
    onCancel: () => abModal.close(winId),
  });

  const {
    focus: focusTitle,
    setDefaultValue: setDefaultTitle,
    getValue: getTitle,
  } = inputManager('title', {
    onAccept: () => handleSubmit(),
    onCancel: () => abModal.close(winId),
  });

  const { setDefaultValue: setDefaultURL, getValue: getURL } = inputManager('url', {
    onAccept: () => handleSubmit(),
    onCancel: () => abModal.close(winId),
  });

  setDefaultTitle(title);
  setDefaultURL(url);

  if (createFolder) {
    h1.textContent = `Create folder and add bookmark to: ${folderName}`;
    setFolderNameVisible(true);
    focusFolderName();
  } else {
    h1.textContent = `Add bookmark to: ${folderName}`;
    setFolderNameVisible(false);
    focusTitle(true);
  }

  function handleSubmit() {
    const folderName = getFolderName();
    const title = getTitle();
    const url = getURL();
    abBookmarks.add(winId, folderId, title, url, folderName);
  }
</script>
