{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "bundler",
    "types": [],
    "paths": {
      "@/*": ["./src/main/*"],
      "~/*": ["./src/shared/*"]
    }
  }
}
