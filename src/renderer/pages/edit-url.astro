---
import Modal from '#/layouts/Modal.astro';
import Title from '#/components/common/Title.astro';
---

<Modal width="800px">
  <Title title="pages:editURL.title" />
  <div id="content"></div>
</Modal>

<script>
  import {
    Renderer,
    h,
    c,
    confirmButtons,
    getSearchParams,
    input,
    btnIcon,
    buildURL,
    parseURL,
  } from '#/scripts';
  import type { UrlParts } from '#/scripts';
  import deleteIcon from '#/icons/delete.svg?raw';
  import type { ITabEntity } from '~/types';

  const { winId, searchParams } = getSearchParams();
  const tabId = searchParams.get('tabId');

  const tabsEntitites = (await abEntities.fetch(winId, 'tabs')) as ITabEntity[];
  const selectedTab = tabId
    ? tabsEntitites.find((d: ITabEntity) => d.id === tabId)!
    : tabsEntitites.find((d) => d.selected)!;

  const t = await abI18n.t(winId, [
    { key: 'pages:editURL.option1Title' },
    { key: 'pages:editURL.option2Title' },
    { key: 'pages:editURL.url' },
    { key: 'pages:editURL.protocol' },
    { key: 'pages:editURL.hostname' },
    { key: 'pages:editURL.port' },
    { key: 'pages:editURL.pathname' },
    { key: 'pages:editURL.hash' },
    { key: 'pages:editURL.queryParams' },
    { key: 'pages:editURL.add' },
    { key: 'pages:editURL.key' },
    { key: 'pages:editURL.value' },
  ]);

  const [btns, registerBtnsEvents] = await confirmButtons({
    winId,
    onConfirm: () => {
      const fullURLEl = document.getElementById('fullURL') as HTMLInputElement;
      abCommands.perform(winId, 'edit-url', {
        tabId: parseInt(selectedTab.id, 10),
        url: fullURLEl.value,
      });
      abModal.close(winId);
    },
    onCancel: () => {
      abModal.close(winId);
    },
  });

  const initialUrl = selectedTab.url || '';
  let initialParts: UrlParts | null = null;
  try {
    initialParts = parseURL(initialUrl);
  } catch {
    // Invalid or empty URL, leave everything blank
  }

  const urlState = {
    fullURL: initialUrl,
    protocol: initialParts?.protocol || '',
    hostname: initialParts?.hostname || '',
    port: initialParts?.port || '',
    pathname: initialParts?.pathname || '',
    hash: initialParts?.hash || '',
    queryParams:
      initialParts && initialParts.searchParams.length > 0
        ? initialParts.searchParams
        : [{ key: '', value: '' }],
  };

  let isUpdating = false;

  const syncStateFromDOM = () => {
    urlState.fullURL = (document.getElementById('fullURL') as HTMLInputElement)?.value || '';
    urlState.protocol = (document.getElementById('protocol') as HTMLInputElement)?.value || '';
    urlState.hostname = (document.getElementById('hostname') as HTMLInputElement)?.value || '';
    urlState.port = (document.getElementById('port') as HTMLInputElement)?.value || '';
    urlState.pathname = (document.getElementById('pathname') as HTMLInputElement)?.value || '';
    urlState.hash = (document.getElementById('hash') as HTMLInputElement)?.value || '';

    urlState.queryParams = [];
    let i = 0;
    while (true) {
      const keyEl = document.getElementById(`key_${i}`) as HTMLInputElement | null;
      const valEl = document.getElementById(`value_${i}`) as HTMLInputElement | null;
      if (!keyEl || !valEl) break;
      urlState.queryParams.push({ key: keyEl.value, value: valEl.value });
      i++;
    }
  };

  const updateFullURL = () => {
    if (isUpdating) return;
    isUpdating = true;

    const parts: UrlParts = {
      protocol: urlState.protocol,
      hostname: urlState.hostname,
      port: urlState.port,
      pathname: urlState.pathname,
      hash: urlState.hash,
      hashParams: [],
      searchParams: urlState.queryParams,
    };

    try {
      const url = buildURL(parts, false);
      (document.getElementById('fullURL') as HTMLInputElement).value = url;
    } catch (e) {
      // Invalid URL, do not update
    }

    isUpdating = false;
  };

  const parseFullURL = () => {
    if (isUpdating) return;
    isUpdating = true;

    syncStateFromDOM();

    try {
      const parts = parseURL(urlState.fullURL);
      urlState.protocol = parts.protocol;
      urlState.hostname = parts.hostname;
      urlState.port = parts.port;
      urlState.pathname = parts.pathname;
      urlState.hash = parts.hash;
      urlState.queryParams =
        parts.searchParams.length > 0 ? parts.searchParams : [{ key: '', value: '' }];

      renderer.update(buildVDOM(urlState));
    } catch (e) {
      // Invalid URL
    }

    isUpdating = false;
  };

  const buildVDOM = (state: typeof urlState) => {
    return h(
      'div',
      { class: c('flex', 'flex-col', 'gap-2') },
      h(
        'div',
        { class: c('flex', 'flex-col', 'gap-2') },
        h(
          'div',
          { class: c('flex', 'flex-col', 'gap-2') },
          h('h1', null, t['pages:editURL.option1Title']),
          input('fullURL', t['pages:editURL.url'], state.fullURL, {
            onInput: parseFullURL,
            autofocus: true,
            select: true,
          }),
        ),
        h(
          'div',
          { class: c('flex', 'flex-col', 'gap-2', 'mt-3') },
          h('h1', null, t['pages:editURL.option1Title']),
          input('protocol', 'Protocol', state.protocol, {
            onInput: () => {
              syncStateFromDOM();
              updateFullURL();
            },
          }),
          input('hostname', t['pages:editURL.hostname'], state.hostname, {
            onInput: () => {
              syncStateFromDOM();
              updateFullURL();
            },
          }),
          input('port', t['pages:editURL.port'], state.port, {
            onInput: () => {
              syncStateFromDOM();
              updateFullURL();
            },
          }),
          input('pathname', t['pages:editURL.pathname'], state.pathname, {
            onInput: () => {
              syncStateFromDOM();
              updateFullURL();
            },
          }),
          input('hash', t['pages:editURL.hash'], state.hash, {
            onInput: () => {
              syncStateFromDOM();
              updateFullURL();
            },
          }),
          h('h2', { class: c('text-sm') }, t['pages:editURL.queryParams']),
          h(
            'div',
            { class: c('grid', 'grid-cols-[auto_auto_20px]', 'gap-2', 'items-center') },
            ...state.queryParams
              .map((param, index) => [
                input(`key_${index}`, t['pages:editURL.key'], param.key, {
                  onInput: (value) => {
                    state.queryParams[index].key = value;
                    updateFullURL();
                  },
                }),
                input(`value_${index}`, t['pages:editURL.value'], param.value, {
                  onInput: (value) => {
                    state.queryParams[index].value = value;
                    updateFullURL();
                  },
                }),
                state.queryParams.length > 1
                  ? btnIcon(deleteIcon, {
                      doubleConfirmation: true,
                      onClick: () => {
                        state.queryParams.splice(index, 1);
                        updateFullURL();
                        renderer.update(buildVDOM(urlState));
                      },
                    })
                  : h('span', null, ''),
              ])
              .flat(),
          ),
          h(
            'div',
            null,
            h(
              'button',
              {
                class: c('btn', 'btn-sm', 'btn-ghost'),
                onClick: () => {
                  state.queryParams.push({ key: '', value: '' });
                  updateFullURL();
                  renderer.update(buildVDOM(urlState));
                },
              },
              t['pages:editURL.add'],
            ),
          ),
        ),
      ),
      h('div', { class: c('flex', 'justify-end', 'gap-2', 'mt-4') }, ...btns),
    );
  };

  const renderer = new Renderer(buildVDOM(urlState));

  renderer.render('content', {
    onRendered: () => {
      registerBtnsEvents();
    },
  });
</script>
