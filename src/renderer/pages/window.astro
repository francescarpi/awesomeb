---
import Layout from '#/layouts/Base.astro';
---

<Layout>
  <div id="window-container"></div>
</Layout>

<script>
  import { getSearchParams, h, Renderer, c } from '#/scripts';
  import type { ITheme, ILayoutData } from '~/types';
  import { acceleratorToDisplay, isMacPlatform } from '~/utils/shortcuts';

  interface IWindowState extends ILayoutData {
    theme: ITheme;
    shortcuts: string[];
  }

  const { winId, searchParams } = getSearchParams();

  const t = await abI18n.t({ winId }, [
    { key: 'pages:window.newTabSuffix' },
    { key: 'pages:window.commandsSuffix' },
    { key: 'pages:window.title' },
  ]);

  document.title = t['pages:window.title'];

  const BORDER_WIDTH = 2;

  const renderer = new Renderer(h('div', {})).render('window-container');
  let state: IWindowState = {
    theme: { primary: '#2b7fff', secondary: '#1c398e', degrees: 238 },
    areaMaximized: searchParams.get('areaMaximized') === 'true',
    sidebarCollapsed: searchParams.get('sidebarCollapsed') === 'true',
    hasVisibleTabs: false,
    selectedTabBounds: null,
    selectedTabPartitionColor: null,
    shortcuts: [],
  };

  abDesktops.getTheme(winId).then((theme) => {
    state.theme = theme;
    renderContent();
    abWindow.readyToShow(winId);
  });

  abDesktops.onThemeRefresh((_e, theme) => {
    state.theme = theme;
    renderContent();
  });

  abWindow.onRefreshLayoutData((_e, data: ILayoutData) => {
    state = { ...state, ...data };
    renderContent();
  });

  let shortcutsRequestVersion = 0;

  loadShortcuts();
  abShortcuts.onChange(() => {
    loadShortcuts();
  });

  function renderContent() {
    const left = state.areaMaximized ? 5 : state.sidebarCollapsed ? 40 : 254;
    const top = state.areaMaximized ? 5 : state.sidebarCollapsed ? 34 : 34;
    const style = state.selectedTabBounds
      ? `left: ${state.selectedTabBounds.x - BORDER_WIDTH}px; top: ${state.selectedTabBounds.y - BORDER_WIDTH}px; width: ${state.selectedTabBounds.width + BORDER_WIDTH * 2}px; height: ${state.selectedTabBounds.height + BORDER_WIDTH * 2}px; border-color: ${state.selectedTabPartitionColor || 'yellow'};`
      : '';

    const content = h(
      'div',
      {
        class: 'fixed inset-0',
        style: `background-image: linear-gradient(${state.theme.degrees}deg, ${state.theme.primary}, ${state.theme.secondary})`,
      },
      h('div', {
        class: c(
          'border-2',
          'border-dotted',
          'bg-white',
          'bg-clip-padding',
          'absolute',
          'rounded-[14px]',
          !state.selectedTabBounds && 'hidden',
        ),
        style,
      }),
      h(
        'div',
        {
          class:
            'bg-white/20 border border-white/15 rounded-xl text-white opacity-50 flex flex-col items-center justify-center absolute right-1 bottom-1 select-none text-right px-3 py-2 text-sm',
          style: `left: ${left}px; top: ${top}px;`,
        },
        ...state.shortcuts.map((s) => h('p', { class: c(state.hasVisibleTabs && 'hidden') }, s)),
      ),
    );

    renderer.update(content);
  }

  async function loadShortcuts() {
    const requestVersion = ++shortcutsRequestVersion;

    try {
      const map = await abShortcuts.active(winId);

      if (requestVersion !== shortcutsRequestVersion) return;

      const platform = isMacPlatform() ? 'mac' : 'win';
      const shortcuts = [map.shortcuts.newTab, map.shortcuts.performCommand].filter((shortcut) =>
        shortcut?.key?.trim(),
      );

      state.shortcuts = shortcuts.map(
        (shortcut) => `${acceleratorToDisplay(shortcut.key, platform)} ${shortcut.label}`,
      );

      renderContent();
    } catch (error) {
      console.error('Failed to load active shortcuts', error);
    }
  }
</script>
