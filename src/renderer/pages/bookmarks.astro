---
import BlackBgWithTitle from '#/layouts/BlackBgWithTitle.astro';
---

<BlackBgWithTitle title="Bookmarks">
  <div class="flex gap-2">
    <!-- Bookmarks tree navigation (left panel) -->
    <div id="bookmarks-tree" class="w-75 flex flex-col gap-2 p-2 overflow-y-auto border-r"></div>

    <!-- Selected bookmark details panel (right panel) -->
    <div id="bookmark-details" class="p-4 w-full"></div>
  </div>
</BlackBgWithTitle>

<!-- Template for folder bookmark items -->
<template id="folder-template">
  <div class="flex flex-col gap-1">
    <div class="flex">
      <button class="btn btn-sm btn-ghost block flex-1 truncate text-left"></button>
      <button class="btn btn-sm btn-ghost flex">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
          ><path
            fill="currentColor"
            d="M11.625 14.913q-.175-.063-.325-.213l-4.6-4.6q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l3.9 3.9l3.9-3.9q.275-.275.7-.275t.7.275t.275.7t-.275.7l-4.6 4.6q-.15.15-.325.213t-.375.062t-.375-.062"
          ></path></svg
        >
        <svg
          class="hidden"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          ><path
            fill="currentColor"
            d="m12 10.8l-3.9 3.9q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7l4.6-4.6q.3-.3.7-.3t.7.3l4.6 4.6q.275.275.275.7t-.275.7t-.7.275t-.7-.275z"
          ></path></svg
        >
      </button>
    </div>
    <div class="folder-content"></div>
  </div>
</template>

<template id="url-template">
  <div>
    <button class="btn btn-sm btn-ghost block w-full truncate text-left"></button>
  </div>
</template>

<template id="details-template">
  <div class="flex flex-col gap-4">
    <input class="input input-sm w-full" data-placeholder="title" />
    <input class="input input-sm w-full" data-placeholder="url" />
    <input type="hidden" />
    <div class="flex justify-between gap-2">
      <button class="btn btn-sm delete" data-label="delete"></button>
      <div class="flex gap-2">
        <button class="btn btn-sm move" data-label="move"></button>
        <button class="btn btn-sm btn-primary save" data-label="save"></button>
      </div>
    </div>
  </div>
</template>

<script>
  import { IBookmark, IFolderBookmark, IUrlBookmark, EBookmarkType } from '~/types';
  import { dialogConfirm, dialogWithSelect, type IOption } from '#/scripts';
  import { initI18n, t, onLocaleChange } from '#/scripts/i18n';

  await initI18n();

  function applyTitle() {
    document.title = t('pages.bookmarks.title');
    const h1 = document.querySelector('h1.text-lg.mb-10');
    if (h1) h1.textContent = t('pages.bookmarks.title');
  }
  applyTitle();

  const bookmarksTree = document.getElementById('bookmarks-tree') as HTMLElement;
  const bookmarkDetails = document.getElementById('bookmark-details') as HTMLElement;
  const folderTemplate = document.getElementById('folder-template') as HTMLTemplateElement;
  const urlTemplate = document.getElementById('url-template') as HTMLTemplateElement;
  const detailsTemplate = document.getElementById('details-template') as HTMLTemplateElement;

  function refreshDetailsPlaceholders() {
    const titleInput = detailsTemplate.content.querySelector(
      'input[data-placeholder="title"]',
    ) as HTMLInputElement;
    const urlInput = detailsTemplate.content.querySelector(
      'input[data-placeholder="url"]',
    ) as HTMLInputElement;
    const deleteBtn = detailsTemplate.content.querySelector('.delete') as HTMLButtonElement;
    const moveBtn = detailsTemplate.content.querySelector('.move') as HTMLButtonElement;
    const saveBtn = detailsTemplate.content.querySelector('.save') as HTMLButtonElement;
    if (titleInput) titleInput.placeholder = t('pages.bookmarks.titlePlaceholder');
    if (urlInput) urlInput.placeholder = t('pages.bookmarks.urlPlaceholder');
    if (deleteBtn) deleteBtn.textContent = t('pages.bookmarks.delete');
    if (moveBtn) moveBtn.textContent = t('pages.bookmarks.move');
    if (saveBtn) saveBtn.textContent = t('pages.bookmarks.save');
  }
  refreshDetailsPlaceholders();

  abBookmarks.get().then((bookmarks) => {
    renderBookmarks(bookmarks);
  });

  function renderBookmarks(bookmarks: IBookmark[]) {
    bookmarksTree.innerHTML = '';

    for (const bookmark of bookmarks) {
      if (bookmark.type === 'folder') {
        renderBookmarkFolder(bookmarks, bookmark, bookmarksTree);
      } else {
        renderBookmarkUrl(bookmarks, bookmark, bookmarksTree);
      }
    }
  }

  function renderBookmarkFolder(
    bookmarks: IBookmark[],
    folder: IFolderBookmark,
    container: HTMLElement,
  ) {
    const folderElement = folderTemplate.content.cloneNode(true) as HTMLElement;
    const titleButton = folderElement.querySelector('button:nth-child(1)') as HTMLButtonElement;
    const toggleButton = folderElement.querySelector('button:nth-child(2)') as HTMLButtonElement;
    const folderContent = folderElement.querySelector('.folder-content') as HTMLElement;
    const chevronDown = toggleButton.querySelector('svg:nth-child(1)') as HTMLElement;
    const chevronUp = toggleButton.querySelector('svg:nth-child(2)') as HTMLElement;

    titleButton.textContent = folder.title;
    titleButton.addEventListener('click', () => renderSelectedBookmark(bookmarks, folder));

    toggleButton.addEventListener('click', () => {
      folderContent.classList.toggle('hidden');
      chevronDown.classList.toggle('hidden');
      chevronUp.classList.toggle('hidden');
    });

    if (folder.children) {
      folderContent.classList.add('pl-5', 'hidden');

      for (const child of folder.children) {
        if (child.type === 'folder') {
          renderBookmarkFolder(bookmarks, child, folderContent);
        } else {
          renderBookmarkUrl(bookmarks, child, folderContent);
        }
      }
    }

    container.appendChild(folderElement);
  }

  function renderBookmarkUrl(bookmarks: IBookmark[], url: IUrlBookmark, container: HTMLElement) {
    const urlElement = urlTemplate.content.cloneNode(true) as HTMLElement;
    const button = urlElement.querySelector('button') as HTMLButtonElement;

    button.textContent = url.title;
    button.addEventListener('click', () => renderSelectedBookmark(bookmarks, url));

    container.appendChild(urlElement);
  }

  function renderSelectedBookmark(bookmarks: IBookmark[], bookmark: IBookmark) {
    const detailsElement = detailsTemplate.content.cloneNode(true) as HTMLElement;

    const titleInput = detailsElement.querySelector(
      'input[data-placeholder="title"]',
    ) as HTMLInputElement;
    const urlInput = detailsElement.querySelector(
      'input[data-placeholder="url"]',
    ) as HTMLInputElement;
    const bookmarkIdInput = detailsElement.querySelector(
      'input[type="hidden"]',
    ) as HTMLInputElement;

    const saveButton = detailsElement.querySelector('.save') as HTMLButtonElement;
    const deleteButton = detailsElement.querySelector('.delete') as HTMLButtonElement;
    const moveButton = detailsElement.querySelector('.move') as HTMLButtonElement;

    bookmarkDetails.innerHTML = '';

    bookmarkIdInput.value = bookmark.id;
    titleInput.value = bookmark.title;
    titleInput.placeholder = t('pages.bookmarks.titlePlaceholder');
    urlInput.placeholder = t('pages.bookmarks.urlPlaceholder');
    saveButton.textContent = t('pages.bookmarks.save');
    deleteButton.textContent = t('pages.bookmarks.delete');
    moveButton.textContent = t('pages.bookmarks.move');

    if (bookmark.type === 'folder') {
      urlInput.value = '';
      urlInput.classList.add('hidden');
    } else {
      urlInput.value = bookmark.url;
      urlInput.disabled = false;
    }

    setupSaveHandler(saveButton, bookmarks);
    setupDeleteHandler(deleteButton, bookmarks, bookmark);
    setupMoveHandler(moveButton, bookmarks, bookmark);

    bookmarkDetails.appendChild(detailsElement);
  }

  function clearSelectedBookmark() {
    bookmarkDetails.innerHTML = '';
  }

  function setupSaveHandler(button: HTMLButtonElement, bookmarks: IBookmark[]) {
    button.addEventListener('click', () => {
      saveActiveBookmark(bookmarks);
    });
  }

  function setupDeleteHandler(
    button: HTMLButtonElement,
    bookmarks: IBookmark[],
    bookmark: IBookmark,
  ) {
    button.addEventListener('click', () => {
      dialogConfirm(t('pages.bookmarks.deleteConfirm'), {
        onAccept: () => {
          const newBookmarks = deleteBookmarkInList(bookmarks, bookmark.id);
          abBookmarks.update(newBookmarks).then(() => {
            renderBookmarks(newBookmarks);
            clearSelectedBookmark();
          });
        },
      });
    });
  }

  function setupMoveHandler(
    button: HTMLButtonElement,
    bookmarks: IBookmark[],
    bookmark: IBookmark,
  ) {
    button.addEventListener('click', () => {
      const options = [
        { label: t('pages.bookmarks.rootOption'), value: 'root' },
        ...bookmarksToOptions(bookmarks, bookmark.id, 1),
      ];

      dialogWithSelect(t('pages.bookmarks.selectParent'), options, {
        onAccept: (selectedFolderId) => {
          let newBookmarks = deleteBookmarkInList(bookmarks, bookmark.id);

          if (selectedFolderId === 'root') {
            newBookmarks.push(bookmark);
          } else {
            newBookmarks = addBookmarkToParent(newBookmarks, selectedFolderId, bookmark);
          }

          abBookmarks.update(newBookmarks).then(() => {
            renderBookmarks(newBookmarks);
            clearSelectedBookmark();
          });
        },
      });
    });
  }

  function saveActiveBookmark(bookmarks: IBookmark[]) {
    const titleInput = bookmarkDetails.querySelector(
      'input[data-placeholder="title"]',
    ) as HTMLInputElement;
    const urlInput = bookmarkDetails.querySelector('input[data-placeholder="url"]') as
      HTMLInputElement | undefined;
    const idInput = bookmarkDetails.querySelector('input[type="hidden"]') as HTMLInputElement;

    const newBookmarks = updateBookmarkInList(
      bookmarks,
      idInput.value,
      titleInput.value,
      urlInput?.value,
    );

    abBookmarks.update(newBookmarks).then(() => {
      renderBookmarks(newBookmarks);
    });
  }

  function updateBookmarkInList(
    bookmarks: IBookmark[],
    id: string,
    title: string,
    url?: string,
  ): IBookmark[] {
    return bookmarks.map((bookmark) => {
      if (bookmark.id === id) {
        return {
          ...bookmark,
          title,
          ...(bookmark.type === EBookmarkType.Url && url ? { url } : {}),
        };
      } else if (bookmark.type === EBookmarkType.Folder) {
        return {
          ...bookmark,
          children: updateBookmarkInList(bookmark.children, id, title, url),
        };
      }
      return bookmark;
    });
  }

  function deleteBookmarkInList(bookmarks: IBookmark[], id: string): IBookmark[] {
    return bookmarks
      .filter((bookmark) => bookmark.id !== id)
      .map((bookmark) => {
        if (bookmark.type === EBookmarkType.Folder) {
          return {
            ...bookmark,
            children: deleteBookmarkInList(bookmark.children, id),
          };
        }
        return bookmark;
      });
  }

  function addBookmarkToParent(
    bookmarks: IBookmark[],
    parentId: string,
    newBookmark: IBookmark,
  ): IBookmark[] {
    return bookmarks.map((bookmark) => {
      if (bookmark.id === parentId && bookmark.type === EBookmarkType.Folder) {
        return {
          ...bookmark,
          children: [...bookmark.children, newBookmark],
        };
      } else if (bookmark.type === EBookmarkType.Folder) {
        return {
          ...bookmark,
          children: addBookmarkToParent(bookmark.children, parentId, newBookmark),
        };
      }
      return bookmark;
    });
  }

  function bookmarksToOptions(bookmarks: IBookmark[], ignoreId: string, level: number): IOption[] {
    let options: IOption[] = [];

    for (const bookmark of bookmarks) {
      if (bookmark.id === ignoreId) {
        continue;
      }

      if (bookmark.type === EBookmarkType.Folder) {
        options.push({
          label: `${'--'.repeat(level ?? 0)} ${bookmark.title}`,
          value: bookmark.id,
        });
        options = options.concat(bookmarksToOptions(bookmark.children, ignoreId, (level ?? 0) + 1));
      }
    }

    return options;
  }

  onLocaleChange(() => {
    applyTitle();
    refreshDetailsPlaceholders();
  });
</script>
