---
import BlackBgWithTitle from '../layouts/BlackBgWithTitle.astro';
---

<BlackBgWithTitle title="Tab Switcher"><ul></ul></BlackBgWithTitle>

<script>
  import { TTabId, ITabSwitcherTab } from '~/types';
  import { getSearchParams } from '../scripts/url';

  const { winId } = getSearchParams();
  let selectedIndex = 0;

  abTabSwitcher.refresh((_event, tabs) => renderTabs(tabs));

  function handleKeyUp(event: KeyboardEvent) {
    if (event.key === 'Control') {
      event.preventDefault();

      const selectedLi = document.querySelectorAll('ul li')[selectedIndex] as
        | HTMLLIElement
        | undefined;

      if (selectedLi) {
        const tabId = parseInt(selectedLi.dataset.tabId!, 10);
        abTabSwitcher.close(winId);
        abCommands.perform(winId, 'select-tab', {
          tabId,
        });
      } else {
        abTabSwitcher.close(winId);
      }
    }
  }

  function handleKeyDown(event: KeyboardEvent) {
    const totalTabs = document.querySelectorAll('ul li').length;

    if (event.key === 'Tab' && event.ctrlKey && !event.shiftKey) {
      event.preventDefault();
      selectedIndex = (selectedIndex + 1) % totalTabs;
      updateSelection();
    } else if (event.key === 'Tab' && event.shiftKey && event.ctrlKey) {
      event.preventDefault();
      selectedIndex = (selectedIndex - 1 + totalTabs) % totalTabs;
      updateSelection();
    }
  }

  window.addEventListener('keydown', handleKeyDown);
  window.addEventListener('keyup', handleKeyUp);

  function renderTabs(tabs: ITabSwitcherTab[]) {
    const ul = document.querySelector('ul')!;

    ul.innerHTML = '';
    selectedIndex = 0;

    tabs.forEach((tab) => {
      const li = document.createElement('li');
      li.dataset.tabId = tab.id.toString();

      const div = document.createElement('div');
      div.classList.add('p-2', 'flex', 'gap-2', 'items-center');

      li.appendChild(div);
      ul.appendChild(li);

      const favicon = document.createElement('img');
      favicon.classList.add('w-5', 'h-5');

      const title = document.createElement('span');
      title.classList.add('truncate', 'w-full');
      title.textContent = tab.title;

      const partitionColor = document.createElement('span');
      partitionColor.classList.add('w-3', 'h-3');
      partitionColor.style.backgroundColor = tab.partitionColor || '#000';

      div.appendChild(favicon);
      div.appendChild(title);
      div.appendChild(partitionColor);

      updateFavicon(tab.id);
    });

    updateSelection();
  }

  function updateSelection() {
    const items = document.querySelectorAll('ul li div');
    items.forEach((item, idx) => {
      if (idx === selectedIndex) {
        item.classList.add('bg-white/20');
      } else {
        item.classList.remove('bg-white/20');
      }
    });
  }

  async function updateFavicon(tabId: TTabId) {
    const favicon = await abFavicons.get(winId, tabId);
    const img = document.querySelector(`li[data-tab-id="${tabId}"] img`) as HTMLImageElement;
    if (favicon) {
      img.src = favicon;
    } else {
      img.src = '';
    }
  }
</script>
