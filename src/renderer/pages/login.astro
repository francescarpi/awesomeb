---
import BlackBgWithTitle from '#/layouts/BlackBgWithTitle.astro';
---

<BlackBgWithTitle title="Login">
  <div class="flex flex-col gap-4">
    <p>
      This site (<i>XXX</i>) requires a username and password to continue.
    </p>
    <p id="realm"></p>
    <input
      class="input w-full text-black rounded-full"
      placeholder="Username"
      autofocus
      id="username"
    />
    <input
      class="input w-full text-black rounded-full"
      placeholder="Password"
      type="password"
      id="password"
    />
  </div>
</BlackBgWithTitle>

<script>
  import { inputManager, getSearchParams } from '#/scripts';

  const { winId, searchParams } = getSearchParams();

  const host = searchParams.get('host')!;
  const realm = searchParams.get('realm')!;
  const tabId = parseInt(searchParams.get('tabId')!, 10);

  document.querySelector('i')!.textContent = host;
  if (realm.trim() !== '') {
    document.getElementById('realm')!.textContent = realm;
  }

  inputManager('username', {
    onAccept: () => performLogin(),
    onCancel: () => performCancel(),
  });

  inputManager('password', {
    onAccept: () => performLogin(),
    onCancel: () => performCancel(),
  });

  function performLogin() {
    const username = (document.getElementById('username') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;
    abTabs.login(winId, tabId, { username, password });
  }

  function performCancel() {
    abTabs.login(winId, tabId, null);
  }
</script>
