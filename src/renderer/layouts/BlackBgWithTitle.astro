---
import Base from './Base.astro';

interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<Base>
  <div class="bg-linear-to-br from-gray-900 to-gray-800 text-gray-200 p-4 fixed inset-0">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-lg mb-2 text-primary">{title}</h1>
      <slot />
    </div>
  </div>
</Base>
