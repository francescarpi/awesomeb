<div id="app-updater-container" class="hidden sidebar:block"></div>

<script>
  import { Renderer, h, c, getSearchParams } from '#/scripts';
  import type { IAppUpdaterInfo } from '~/types';

  const { winId } = getSearchParams();

  const renderer = new Renderer(h('div', null)).render('app-updater-container');

  abAppUpdater.onRefreshVersionAvailable((_event, data) => {
    renderButton(data);
  });

  const data = await abAppUpdater.versionAvailable(winId);
  if (data) {
    renderButton(data);
  }

  function renderButton(data: IAppUpdaterInfo) {
    renderer.update(
      h(
        'div',
        null,
        h(
          'button',
          {
            class: c(
              'btn',
              'btn-xs',
              'btn-outline',
              data.status === 'available' ? 'inline-flex' : 'hidden',
            ),
            style: 'app-region: no-drag;',
            id: 'appupdater-info-btn',
            onclick: () => {
              const bounds = (
                document.getElementById('appupdater-info-btn') as HTMLButtonElement
              ).getBoundingClientRect();
              abModal.openContextual(winId, 'contextual-app-updater', {
                bounds: {
                  x: bounds.x,
                  y: bounds.y,
                  width: bounds.width,
                  height: bounds.height,
                },
                anchor: 'top-left',
              });
            },
          },
          'Update available',
        ),
        h(
          'span',
          {
            class: c(
              'btn',
              'btn-xs',
              'btn-outline',
              data.status === 'downloading' ? 'inline-flex' : 'hidden',
            ),
          },
          `Progress ${data.progress.toFixed(0)}%`,
        ),
        h(
          'button',
          {
            class: c(
              'btn',
              'btn-xs',
              'btn-outline',
              data.status === 'downloaded' ? 'inline-flex' : 'hidden',
            ),
            style: 'app-region: no-drag;',
            onclick: () => {
              abAppUpdater.install(winId);
            },
          },
          'Quit & Install',
        ),
      ),
    );
  }
</script>
