---
import Layout from '#/layouts/Base.astro';
---

<Layout backgroundColor="#000" borderRadius="12px">
  <div id="container"></div>
</Layout>

<script>
  import { Renderer, h, c, inputManager, getSearchParams, type VNode } from '#/scripts';
  import type { IFindInPageResult } from '~/types';
  import Close from '#/icons/close.svg';
  import Previous from '#/icons/previous.svg';
  import Next from '#/icons/next.svg';

  const { searchParams } = getSearchParams();
  const tabId = parseInt(searchParams.get('tabId')!, 10);

  const renderer = new Renderer(render()).render('container');

  const { inputEl } = inputManager('search', {
    onAccept: (value) => abTabs.findInPageAction(tabId, 'next', value),
    onCancel: () => abTabs.closeFindInTab(tabId),
    onChange: (value) => abTabs.findInPageAction(tabId, 'start', value),
  });

  abTabs.onRefreshFindInPage((_event, result: IFindInPageResult | null) => {
    renderer.update(render(result));
  });

  function render(result?: IFindInPageResult | null): VNode {
    return h(
      'div',
      { class: c('flex', 'items-center', 'gap-2', 'p-2') },
      h(
        'img',
        {
          src: Close.src,
          class: c('w-4', 'h-4', 'cursor-pointer', 'hover:bg-white/30'),
          onclick: () => abTabs.closeFindInTab(tabId),
        },
        '',
      ),
      h(
        'input',
        {
          class: c('input', 'input-xs', 'text-black', 'rounded-full'),
          placeholder: 'Find in page...',
          autofocus: true,
          onfocus: (event) => (event.target as HTMLInputElement).select(),
          id: 'search',
        },
        '',
      ),
      h(
        'img',
        {
          src: Previous.src,
          class: c('w-4', 'h-4', 'cursor-pointer', 'invert', 'hover:bg-black/30'),
          onclick: () => abTabs.findInPageAction(tabId, 'previous', inputEl.value),
        },
        '',
      ),
      h(
        'img',
        {
          src: Next.src,
          class: c('w-4', 'h-4', 'cursor-pointer', 'invert', 'hover:bg-black/30'),
          onclick: () => abTabs.findInPageAction(tabId, 'next', inputEl.value),
        },
        '',
      ),
      result
        ? h(
            'div',
            { class: c('text-sm', 'ml-4') },
            `${result.activeMatch} of ${result.matches} ${
              result.matches === 1 ? 'match' : 'matches'
            }`,
          )
        : null,
    );
  }
</script>
