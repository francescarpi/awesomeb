---
interface Props {
  placeholder: string;
  id: string;
  className?: string;
  oneColumn?: boolean;
}

const { placeholder, id, className, oneColumn } = Astro.props;
---

<div class={`h-full grid grid-rows-[40px_auto] gap-3 ${className}`} id={id}>
  <input class="input w-full text-black rounded-full" placeholder={placeholder} autofocus />
  <ul class="list border rounded-xl overflow-y-auto mb-9">
    <li class="list-row border-b border-white/50">
      <div>
        <p>Empty...</p>
      </div>
    </li>
  </ul>

  <template id="row-template">
    <li
      class={`list-row border-b border-white/50 grid ${oneColumn ? 'grid-cols-1' : 'grid-cols-2'}`}
    >
      <p class="truncate [&>mark]:text-primary [&>mark]:bg-transparent"></p>
      <small class="justify-self-end text-right"></small>
    </li>
  </template>
</div>
