---
import Modal from '#/layouts/Modal.astro';
import Title from '#/components/common/Title.astro';
---

<Modal>
  <Title><span id="title-login">Login</span></Title>
  <div id="content"></div>
</Modal>

<script>
  import { Renderer, h, c, getSearchParams, confirmButtons } from '#/scripts';
  import { initI18n, setText, onLocaleChange, t } from '#/scripts/i18n';

  await initI18n();

  setText('title-login', 'pages.login.title');
  onLocaleChange(() => setText('title-login', 'pages.login.title'));

  const { winId, searchParams } = getSearchParams();
  const host = searchParams.get('host') as string;
  const realm = searchParams.get('realm') as string;
  const tabId = parseInt(searchParams.get('tabId') as string, 10);

  const [btns, registerBtnsEvents] = confirmButtons({
    onConfirm: () => performLogin(),
    onCancel: () => performCancel(),
  });

  new Renderer(
    h(
      'div',
      { class: c('flex', 'flex-col', 'gap-4') },
      h('p', null, t('pages.login.description', { host })),
      h('p', { class: c(!realm || realm.trim() === '' ? 'hidden' : '') }, realm),
      h('input', {
        class: c('input', 'input-sm', 'w-full'),
        placeholder: t('pages.login.usernamePlaceholder'),
        autofocus: true,
        id: 'username',
      }),
      h('input', {
        class: c('input', 'input-sm', 'w-full'),
        placeholder: t('pages.login.passwordPlaceholder'),
        type: 'password',
        id: 'password',
      }),
      h('div', { class: c('flex', 'justify-end', 'gap-2', 'mt-4') }, ...btns),
    ),
  ).render('content', {
    onRendered: () => {
      const usernameEl = document.getElementById('username') as HTMLInputElement;
      const passwordEl = document.getElementById('password') as HTMLInputElement;
      usernameEl.placeholder = t('pages.login.usernamePlaceholder');
      passwordEl.placeholder = t('pages.login.passwordPlaceholder');
      registerBtnsEvents();
    },
  });

  function performLogin() {
    const usernameEl = document.getElementById('username') as HTMLInputElement;
    const username = usernameEl.value.trim();

    const passwordEl = document.getElementById('password') as HTMLInputElement;
    const password = passwordEl.value;

    if (username && password) {
      abTabs.login(winId, tabId, { username, password });
    }
  }

  function performCancel() {
    abTabs.login(winId, tabId, null);
  }
</script>
