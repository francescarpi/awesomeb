---
import Modal from '#/layouts/Modal.astro';
import Title from '#/components/common/Title.astro';
---

<Modal width="600px" height="550px">
  <Title title="pages:bookmarksDesktopToBookmarks.title" />
  <div id="content"></div>
</Modal>

<script>
  import { Renderer, h, getSearchParams, type VNode, confirmButtons } from '#/scripts';
  import type { ITabEntity, IBookmarkEntity, TTabId } from '~/types';

  const { winId, searchParams } = getSearchParams();

  const t = await abI18n.t({ winId }, [
    { key: 'common:loading' },
    { key: 'pages:bookmarksDesktopToBookmarks.intro' },
    { key: 'pages:bookmarksDesktopToBookmarks.rootFolder' },
    { key: 'pages:bookmarksDesktopToBookmarks.createFolder' },
    { key: 'pages:bookmarksDesktopToBookmarks.folderName' },
    { key: 'pages:bookmarksDesktopToBookmarks.close' },
    { key: 'pages:bookmarks.root' },
  ]);

  const renderer = new Renderer(h('div', { class: 'text-sm' }, t['common:loading'])).render(
    'content',
  );

  const allTabs = await abEntities.fetch<ITabEntity>(winId, 'tabs');
  const bookmarks = await abEntities.fetch<IBookmarkEntity>(winId, 'bookmarks');
  const desktopId = searchParams.get('desktopId') ?? '';
  const desktopLabel = searchParams.get('desktopLabel') ?? '';
  const tabs = desktopId
    ? allTabs.filter((t) => t.desktopId === parseInt(desktopId) && t.windowId === winId)
    : [];
  const bookmarksFolders = bookmarks
    .filter((b) => b.folderId)
    .reduce<{ path: string; id: string }[]>(
      (prev, curr) => {
        if (!prev.find((i) => i.path === (curr.extra as string))) {
          prev.push({ path: curr.extra as string, id: curr.folderId });
        }
        return prev;
      },
      [{ path: t['pages:bookmarks.root'], id: 'root' }],
    );

  const [btns, registerBtnsEvents, setLoading] = await confirmButtons({
    winId,
    confirmDisabled: true,
    onConfirm: async () => {
      try {
        const tabs = getSelectedTabs();
        const folder = getFolder();
        setLoading(true);

        await abBookmarks.add(
          winId,
          folder.parentFolderId,
          folder.createFolder && folder.newFolderName && folder.newFolderName.length > 0
            ? folder.newFolderName
            : null,
          tabs.map((tab) => ({ title: tab.title, url: tab.url })),
        );

        const closeTabs = document.querySelector<HTMLInputElement>('input#close-tabs')!.checked;
        if (closeTabs) {
          await abTabs.close(
            winId,
            tabs.map((t) => t.id),
          );
        }

        abModal.close(winId);
      } catch (error) {
        console.error(error);
      } finally {
        setLoading(false);
      }
    },
    onCancel: () => {
      abModal.close(winId);
    },
  });

  renderer.update(
    h(
      'div',
      { class: 'flex flex-col gap-3' },
      h('p', {}, t['pages:bookmarksDesktopToBookmarks.intro']),
      h(
        'div',
        { class: 'w-full bg-base-300 rounded-md p-4 h-[240px] overflow-y-auto' },
        h(
          'div',
          { class: 'mb-3 flex flex-col gap-2' },
          h(
            'div',
            {},
            renderRow(`d-${desktopId}`, desktopLabel, function (this: HTMLInputElement) {
              document
                .querySelectorAll<HTMLInputElement>(`input[value^="${this.value}"]`)
                .forEach((input) => (input.checked = this.checked));
              checkConfirmButtonStatus();
            }),
          ),
          h(
            'div',
            { class: 'ml-4 flex flex-col gap-2' },
            ...tabs.map((tab) =>
              renderRow(
                `d-${tab.desktopId}-t-${tab.id}`,
                tab.label,
                function (this: HTMLInputElement) {
                  const desktopId = this.value.split('-')[1];
                  document.querySelector<HTMLInputElement>(
                    `input[value="d-${desktopId}"]`,
                  )!.checked = false;
                  checkConfirmButtonStatus();
                },
              ),
            ),
          ),
        ),
      ),
      h(
        'div',
        { class: 'flex flex-col gap-2' },
        h('span', {}, t['pages:bookmarksDesktopToBookmarks.rootFolder']),
        h(
          'div',
          { class: 'flex gap-2' },
          h(
            'select',
            {
              id: 'parentFolder',
              class: 'select select-sm w-full',
              value: undefined,
            },
            ...bookmarksFolders.map((folder) => h('option', { value: folder.id }, folder.path)),
          ),
        ),
      ),
      h(
        'div',
        { class: 'flex gap-2' },
        h(
          'label',
          { class: 'flex gap-2 items-center cursor-pointer text-sm' },
          h(
            'input',
            {
              type: 'checkbox',
              class: 'checkbox checkbox-sm',
              checked: false,
              id: 'create-folder',
              onchange: function () {
                const input = document.querySelector('input#child-folder')!;
                if (this.checked) {
                  input.classList.remove('invisible');
                } else {
                  input.classList.add('invisible');
                }
                checkConfirmButtonStatus();
              },
            },
            '',
          ),
          t['pages:bookmarksDesktopToBookmarks.createFolder'],
        ),
        h(
          'input',
          {
            id: 'child-folder',
            class: 'input input-sm invisible',
            placeholder: t['pages:bookmarksDesktopToBookmarks.folderName'],
            onkeyup: () => {
              checkConfirmButtonStatus();
            },
          },
          '',
        ),
      ),
      h(
        'div',
        {},
        h(
          'label',
          { class: 'flex gap-2 items-center cursor-pointer text-sm' },
          h(
            'input',
            {
              type: 'checkbox',
              class: 'checkbox checkbox-sm',
              checked: false,
              id: 'close-tabs',
            },
            '',
          ),
          t['pages:bookmarksDesktopToBookmarks.close'],
        ),
      ),
      h('div', { class: 'flex gap-2 justify-end' }, ...btns),
    ),
    { onUpdated: registerBtnsEvents },
  );

  function renderRow(value: string, label: string, onClick?: () => void): VNode {
    return h(
      'label',
      { class: 'flex gap-2 items-center cursor-pointer text-sm' },
      h(
        'input',
        {
          type: 'checkbox',
          class: 'checkbox checkbox-sm',
          checked: false,
          value,
          onClick,
        },
        '',
      ),
      label,
    );
  }

  function getSelectedTabs(): { id: TTabId; url: string; title: string }[] {
    const pat = /^d-\d+-t-\d+$/;
    return [...document.querySelectorAll<HTMLInputElement>('input:checked')]
      .filter((el) => pat.test(el.value))
      .map((el) => {
        const tabId = el.value.split('-')[3];
        const tab = allTabs.find((t) => t.id === tabId)!;
        return {
          id: parseInt(tabId),
          title: tab.label,
          url: tab.url as string,
        };
      })
      .filter((tab) => !!tab.url);
  }

  function getFolder(): { parentFolderId: string; createFolder: boolean; newFolderName: string } {
    const parentFolderId = document.querySelector<HTMLSelectElement>('select#parentFolder')!.value;
    const createFolder = document.querySelector<HTMLInputElement>('input#create-folder')!.checked;
    const newFolderName = document
      .querySelector<HTMLInputElement>('input#child-folder')!
      .value.trim();
    return { parentFolderId, createFolder, newFolderName };
  }

  function checkConfirmButtonStatus() {
    const tabs = getSelectedTabs();
    const folder = getFolder();
    const btn = document.querySelector<HTMLButtonElement>('button#confirm')!;
    btn.disabled = tabs.length === 0 || (folder.createFolder && folder.newFolderName.length === 0);
  }
</script>
