---
import BlackBgWithTitle from '#/layouts/BlackBgWithTitle.astro';
import ListWithSearch from '#/components/common/ListWithSearch.astro';
---

<BlackBgWithTitle title="Select Desktop">
  <ListWithSearch placeholder="Filter and select desktop..." id="list" />
</BlackBgWithTitle>

<script>
  import { getSearchParams, listWithSearchManager } from '#/scripts';

  const { winId } = getSearchParams();

  listWithSearchManager('list', {
    entity: 'desktops',
    onAccept: (item) => {
      abCommands.perform(winId, 'select-desktop', { desktopId: parseInt(item.id, 10) });
    },
    onEscape: () => {
      abModal.close(winId);
    },
  });
</script>
