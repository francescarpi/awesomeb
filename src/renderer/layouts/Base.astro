---
import '../assets/app.css';

interface Props {
  backgroundColor?: string;
  borderRadius?: string;
  noDrag?: boolean;
}

const { backgroundColor, borderRadius, noDrag } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="cupcake">
  <head>
    <meta charset="UTF-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' awesomeb: data: https:; connect-src 'self' ws:; worker-src blob:;"
    />
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    <meta http-equiv="Expires" content="0" />
    <meta http-equiv="Last-Modified" content="0" />
    <meta http-equiv="Cache-Control" content="no-cache, mustrevalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <script is:inline>
      (function () {
        const params = new URLSearchParams(window.location.search);
        const theme = params.get('theme');
        if (theme) document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body style={noDrag ? 'app-region: no-drag' : ''}>
    <div class="rootContainer fixed inset-0 text-white">
      <slot />
    </div>
  </body>
</html>

<style
  define:vars={{
    backgroundColor: backgroundColor || 'transparent',
    borderRadius: borderRadius || '0px',
  }}
>
  .rootContainer {
    background-color: var(--backgroundColor);
    border-radius: var(--borderRadius);
  }
</style>

<script>
  import { getSearchParams } from '#/scripts';
  import { initI18n, getLocale, onLocaleChange } from '#/scripts/i18n';
  import type { IConfig } from '~/types';

  await initI18n();
  document.documentElement.lang = getLocale();
  onLocaleChange(() => {
    document.documentElement.lang = getLocale();
  });

  const { winId } = getSearchParams();

  const config = await abConfig.get(winId);
  applyTheme(config);

  abConfig.refresh((_e, config) => {
    applyTheme(config);
  });

  function applyTheme(config: IConfig) {
    document.documentElement.setAttribute('data-theme', config.uiTheme);
  }
</script>
