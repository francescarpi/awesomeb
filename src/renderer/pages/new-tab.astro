---
import BlackBgWithTitle from '../layouts/BlackBgWithTitle.astro';
import ListWithSearch from '../components/common/ListWithSearch.astro';
---

<BlackBgWithTitle title="New Tab">
  <div id="pagesIndicator"></div>
  <ListWithSearch placeholder="Enter a query or a valid url..." id="query" />
  <ListWithSearch placeholder="Select a profile..." id="partition" />
  <ListWithSearch placeholder="Select a target" id="target" />

  <script>
    import { listWithSearchManager } from '../scripts/list-with-search';
    import { getSearchParams } from '../scripts/url';
    import { IEntity, IPartitionEntity } from '~/types';

    const queryEl = document.getElementById('query')!;
    const partitionEl = document.getElementById('partition')!;
    const targetEl = document.getElementById('target')!;

    let activePage = queryEl;
    const pages = [queryEl, partitionEl, targetEl];
    const { winId } = getSearchParams();

    let query = '';
    let searchEngine: IEntity | null = null;
    let partition: IPartitionEntity | null = null;
    let target: IEntity | null = null;

    // ------------------------------------------------------
    refreshPageVisible();
    refreshPageIndicator();

    // ------------------------------------------------------
    listWithSearchManager(queryEl, {
      entity: 'searchEngines',
      filtering: false,
      onEscape: () => abModal.close(winId),
      onTab: () => nextPage(),
      onShiftTab: () => previousPage(),
      onChange: (inputValue, entity) => {
        searchEngine = entity;
        query = inputValue;
      },
      onAccept: (searchEngine) => {
        searchEngine = searchEngine;
        handleSelect();
      },
    });

    listWithSearchManager(partitionEl, {
      entity: 'partitions',
      onEscape: () => abModal.close(winId),
      onTab: () => nextPage(),
      onShiftTab: () => previousPage(),
      renderExtra: (item, rowEl) => {
        const entity = item as IPartitionEntity;
        const style = `background-color: ${entity.color}`;
        rowEl.innerHTML = `<div class="w-[15px] h-[15px] border" style="${style}"></div>`;
      },
      onChange: (_inputValue, entity) => {
        partition = entity as IPartitionEntity;
      },
      onAccept: (selectedPartition) => {
        partition = selectedPartition as IPartitionEntity;
        handleSelect();
      },
    });

    listWithSearchManager(targetEl, {
      entity: 'targets',
      onEscape: () => abModal.close(winId),
      onTab: () => nextPage(),
      onShiftTab: () => previousPage(),
      onChange: (_inputValue, entity) => {
        target = entity;
      },
      onAccept: (selectedTarget) => {
        target = selectedTarget;
        handleSelect();
      },
    });

    // ------------------------------------------------------
    function refreshPageVisible() {
      for (const page of pages) {
        if (page === activePage) {
          page.style.display = 'grid';
          page.querySelector('input')!.focus();
        } else {
          page.style.display = 'none';
        }
      }
    }

    // ------------------------------------------------------
    function refreshPageIndicator() {
      const pagesIndicatorEl = document.getElementById('pagesIndicator')!;
      pagesIndicatorEl.innerHTML = '';

      pages.forEach((page) => {
        const dot = document.createElement('span');
        dot.className = 'mx-1 text-white select-none';
        dot.innerText = page === activePage ? '●' : '○';
        pagesIndicatorEl.appendChild(dot);
      });
    }

    // ------------------------------------------------------
    function nextPage() {
      const currentIndex = pages.indexOf(activePage);
      const nextIndex = (currentIndex + 1) % pages.length;
      activePage = pages[nextIndex];
      refreshPageVisible();
      refreshPageIndicator();
    }

    // ------------------------------------------------------
    function previousPage() {
      const currentIndex = pages.indexOf(activePage);
      const previousIndex = (currentIndex - 1 + pages.length) % pages.length;
      activePage = pages[previousIndex];
      refreshPageVisible();
      refreshPageIndicator();
    }

    // ------------------------------------------------------
    function handleSelect() {
      if (query.trim().length > 0) {
        abCommands.perform(winId, 'new-tab', {
          query,
          partitionId: partition!.id,
          searchEngineCode: searchEngine!.id,
          targetId: target!.id,
        });
      }
    }
  </script>
</BlackBgWithTitle>
