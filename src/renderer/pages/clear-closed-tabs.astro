---
import Modal from '#/layouts/Modal.astro';
---

<Modal>
  <div id="container"></div>
</Modal>

<script>
  import { Renderer, h, c, getSearchParams, confirmButtons } from '#/scripts';
  import { initI18n, t } from '#/scripts/i18n';

  await initI18n();

  const { winId } = getSearchParams();

  const [btns, registerBtnsEvents] = confirmButtons({
    onConfirm: () => abCommands.perform(winId, 'clear-closed-tabs'),
    onCancel: () => abModal.close(winId),
  });

  new Renderer(
    h(
      'div',
      { classs: c('flex', 'flex-col', 'gap-3') },
      h('p', { class: c('text-md', 'my-6') }, t('pages.closedTabsClear.confirmMessage')),
      h('div', { class: c('flex', 'justify-center', 'gap-3') }, ...btns),
    ),
  ).render('container', { onRendered: registerBtnsEvents });
</script>
