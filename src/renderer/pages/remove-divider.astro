---
import ListWithSearch from '#/components/common/ListWithSearch.astro';
import Modal from '#/layouts/Modal.astro';
import Title from '#/components/common/Title.astro';
---

<Modal width="400px" height="500px">
  <Title title="pages:removeDivider.title" />
  <ListWithSearch placeholder="pages:removeDivider.placeholder" id="list" oneColumn />
</Modal>

<script>
  import { getSearchParams, listWithSearchManager } from '#/scripts';

  const { winId } = getSearchParams();

  listWithSearchManager('list', {
    entity: 'tabContainers',
    onAccept: (item) => {
      abCommands.perform(winId, 'remove-divider', { tabContainerId: parseInt(item.id, 10) });
    },
    onEscape: () => {
      abModal.close(winId);
    },
  });
</script>
