---
import BlackBgWithTitle from '#/layouts/BlackBgWithTitle.astro';
---

<BlackBgWithTitle title="Certificate Info">
  <div id="content"></div>
</BlackBgWithTitle>

<script>
  import { getSearchParams, h, cls, Renderer } from '#/scripts';
  import dayjs from 'dayjs';

  const { winId } = getSearchParams();

  const renderer = new Renderer(
    h('div', {}, h('span', { class: cls('loading', 'loading-dots', 'loading-xs') }, '')),
    'content',
  ).render();

  abCertificates.info(winId).then((data) => {
    if (data) {
      const vnode = h(
        'div',
        { class: cls('grid', 'grid-cols-2') },
        h('span', { class: cls('font-bold') }, 'Common Name:'),
        h('span', {}, data.subject.CN),
        h('span', { class: cls('font-bold') }, 'Issuer Country:'),
        h('span', {}, data.issuer.C),
        h('span', { class: cls('font-bold') }, 'Issuer Organization:'),
        h('span', {}, data.issuer.O),
        h('span', { class: cls('font-bold') }, 'Issuer Common Name:'),
        h('span', {}, data.issuer.CN),
        h('span', { class: cls('font-bold') }, 'Valid From:'),
        h('span', {}, dayjs(data.valid_from).format('ddd, D MMM YYYY HH:mm:ss')),
        h('span', { class: cls('font-bold') }, 'Valid To:'),
        h('span', {}, dayjs(data.valid_to).format('ddd, D MMM YYYY HH:mm:ss')),
        h(
          'div',
          { class: cls('col-span-2', 'mt-6') },
          h(
            'button',
            { class: cls('btn', 'btn-sm'), onclick: () => abModal.close(winId) },
            'Close',
          ),
        ),
      );
      renderer.update(vnode);
    } else {
      const vnode = h(
        'div',
        { class: cls('flex', 'flex-col', 'gap-2', 'items-start') },
        h('p', { class: cls('text-error', 'text-sm') }, 'Failed to get certificate info.'),
        h('button', { class: cls('btn', 'btn-sm'), onclick: () => abModal.close(winId) }, 'Close'),
      );
      renderer.update(vnode);
    }
  });

  // TODO: Check how to redim the modal size based on content.
</script>
