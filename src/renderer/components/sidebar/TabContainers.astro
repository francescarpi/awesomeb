---
---

<div id="tabContainers"></div>

<script>
  import { getSearchParams, h, type VNode, c, Renderer, btnIcon } from '#/scripts';
  import type { ITabContainer, IDesktopEntity, TDesktopId, ITab } from '~/types';
  import TabPreview from '#/icons/tab-preview.svg?raw';
  import Muted from '#/icons/muted.svg?raw';
  import Favicon from '#/icons/favicon.white.svg';
  import Minus from '#/icons/minus.svg?raw';
  import Close from '#/icons/close.svg?raw';
  import Warning from '#/icons/warning.svg?raw';

  const { winId } = getSearchParams();

  // Memo shared by every renderTab call (see renderTab below). Declared BEFORE
  // the first renderTabContainers() invocation: the initial render at module
  // top runs ahead of the rest of the top-level body, so a memo declared further
  // down would still be in the temporal dead zone when the first rows render.
  const tabMemo = new WeakMap<ITab, VNode>();

  // Tab containers...
  let currentTabContainers = await abTabs.getTabContainers(winId);
  const renderer = new Renderer(await renderTabContainers(currentTabContainers)).render(
    'tabContainers',
  );

  abTabs.onRefreshTabContainers((_event, tabContainers) => {
    currentTabContainers = tabContainers;
    renderTabContainers(tabContainers).then((vnode) => renderer.update(vnode));
  });

  // Single-tab updates: keep the snapshot in sync and let the VDOM diff apply
  // only the changed tab instead of re-serializing the whole tree from main.
  abTabs.onRefreshOne((_event, tab) => {
    const updated = updateTabInContainers(currentTabContainers, tab);
    if (!updated) {
      return;
    }
    currentTabContainers = updated;
    renderTabContainers(currentTabContainers).then((vnode) => renderer.update(vnode));
  });

  // Selected desktop...
  const desktops = (await abEntities.fetch(winId, 'desktops')) as IDesktopEntity[];
  const selected = parseInt(desktops.find((d) => d.selected)!.id, 10);
  refreshSelectedDesktop(selected);

  abDesktops.onRefreshSelected((_event, desktopId) => {
    refreshSelectedDesktop(desktopId);
  });

  // ----------------------------------------------------------------------
  function refreshSelectedDesktop(id: TDesktopId) {
    document.getElementById('tabContainers')!.className = `group desktop-${id}`;
  }

  // ----------------------------------------------------------------------
  async function renderTabContainers(tabContainers: ITabContainer[]): Promise<VNode> {
    return h(
      'div', // Container
      {
        class: 'flex flex-col gap-1.5 select-none',
        style: 'app-region: no-drag;',
      },
      ...(await Promise.all(
        tabContainers.map(async (tc) => {
          const openCount = tc.children.filter((t) => !t.isClosed).length;
          const r = await abI18n.t({ winId }, [
            { key: 'pages:tabContainers.collapsedTabs', params: { count: openCount } },
          ]);
          const collapsedText = r['pages:tabContainers.collapsedTabs'];

          return h(
            'div', // Tab Container
            {
              key: tc.id,
              class: c(
                'hidden',
                tc.isClosed ? 'hidden' : `group-[.desktop-${tc.desktopId}]:flex`,
                tc.divider && 'border-b border-white/20 border-dashed pb-1.5',
                'flex-col',
              ),
            },
            h(
              'div',
              {
                class: 'items-center gap-1 flex',
              },
              h(
                'span', // Tab container shortcut (is a number between 1 and 9)
                {
                  class: 'text-xs pl-1 text-white/20 hidden sidebar:block w-1.5',
                },
                tc.shortcut?.toString(),
              ),
              h(
                'div', // Tab container's tabs list (in vertical)
                {
                  class: c(
                    'flex',
                    'flex-col',
                    'w-full',
                    'mx-1',
                    tc.isSplit && 'border border-white/20 border-dashed rounded',
                  ),
                },
                ...tc.tabs.map((t) => renderTab(t)),
              ),
            ),
            ...tc.children.map((tcc) =>
              h(
                'div',
                {
                  key: tcc.id,
                  class: c('ml-1', 'sidebar:ml-6', 'mr-1', tc.collapseChildren && 'hidden'),
                },
                ...tcc.tabs.map((tcct) => renderTab(tcct)),
              ),
            ),
            h(
              'div',
              {
                class: c(
                  !tc.collapseChildren ? 'hidden' : 'hidden sidebar:block',
                  'text-xs',
                  'ml-4',
                  'text-white/40',
                ),
              },
              collapsedText,
            ),
          );
        }),
      )),
    );
  }

  // Stable handlers used by every tab row. They read the tab id from a data
  // attribute instead of capturing it in a closure, so the VDOM sees the same
  // function reference on every rebuild and does not re-register the listeners.
  function selectTabFromEvent(e: Event) {
    const tabId = tabIdFromEvent(e);
    if (tabId !== null) {
      abCommands.perform(winId, 'select-tab', { tabId });
    }
  }

  function openTabMenuFromEvent(e: Event) {
    const tabId = tabIdFromEvent(e);
    if (tabId !== null) {
      abMenu.contextMenu(winId, 'tab', { tabId });
    }
  }

  // Single-confirm action buttons (Close/Minus) route through stable handlers
  // too: they read the row's tab id via closest() at event time, and the
  // btnIcon delegation mode forwards data-action so the row's select handler
  // never fires (each of these stops propagation first).
  function closeTabFromEvent(e: Event) {
    e.stopPropagation();
    const tabId = tabIdFromEvent(e);
    if (tabId !== null) {
      abCommands.perform(winId, 'close-tab', { tabId });
    }
  }

  function suspendTabFromEvent(e: Event) {
    e.stopPropagation();
    const tabId = tabIdFromEvent(e);
    if (tabId !== null) {
      abCommands.perform(winId, 'suspend-tab', { tabId });
    }
  }

  function tabIdFromEvent(e: Event): number | null {
    const row = (e.currentTarget as HTMLElement | null)?.closest(
      '[data-tab-id]',
    ) as HTMLElement | null;
    const raw = row?.dataset.tabId;
    return raw === undefined ? null : Number(raw);
  }

  // Memoize each tab's VNode by tab object reference (tabMemo declared at the
  // top of the module, before the first renderTabContainers() call). All other
  // tabs untouched by updateTabInContainers hit the memo and the diff collapses
  // their subtrees to NONE. Memoized VNodes are never mutated in place.

  function renderTab(t: ITab): VNode {
    const hit = tabMemo.get(t);
    if (hit) return hit;
    const v = buildTabVNode(t);
    tabMemo.set(t, v);
    return v;
  }

  function buildTabVNode(t: ITab): VNode {
    return h(
      'div', // Tab
      {
        'data-tab-id': String(t.id),
        key: t.id,
        class: c(
          'py-1.5',
          'cursor-pointer',
          'gap-1',
          'items-start',
          'grid',
          'grid-cols-1',
          'sidebar:grid-cols-[24px_auto_25px]',
          'sidebar:rounded-tl',
          'sidebar:rounded-bl',
          'relative',
          !t.selected && 'hover:bg-white/10',
          t.suspended ? 'group/suspended opacity-50' : 'group/active',
          t.isClosed && 'hidden',
        ),
        onclick: selectTabFromEvent,
        oncontextmenu: openTabMenuFromEvent,
      },
      h('div', {
        class: c(
          'absolute',
          'inset-0',
          'bg-white/20',
          'transition-opacity',
          'duration-200',
          'pointer-events-none',
          'z-0',
          t.selected ? 'opacity-100' : 'opacity-0',
        ),
      }),
      h(
        'span', // Loading spinner
        {
          class: c(
            'relative',
            'z-10',
            'loading',
            'loading-spinner',
            'loading-xs',
            'ml-auto',
            'mr-auto',
            'sidebar:ml-1',
            'sidebar:mr-0',
            'mt-0.5',
            t.loading ? 'block' : 'hidden',
          ),
        },
        '',
      ),
      h(
        'img', // Favicon
        {
          src: t.favicon || Favicon.src,
          onerror: `this.onerror=null;this.src="${Favicon.src}";`,
          class: c(
            'relative',
            'z-10',
            'w-5',
            'h-5',
            'sidebar:w-[16px]',
            'sidebar:h-[16px]',
            'mt-0.5',
            'ml-auto',
            'mr-auto',
            'sidebar:ml-1',
            'sidebar:mr-0',
            'text-white',
            t.loading ? 'hidden' : 'block',
          ),
        },
        '',
      ),
      h(
        'div', // Title + indicators container
        {
          class: 'relative z-10 hidden sidebar:flex flex-col min-w-0',
        },
        h(
          'span', // Title
          { class: 'text-sm overflow-hidden text-ellipsis text-nowrap' },
          t.title,
        ),
        h(
          'div', // Indicators container
          { class: 'flex gap-1' },
          highlightIcon(TabPreview, t.hasTabPreview, 'text-white'),
          highlightIcon(Muted, t.isMuted, 'text-white'),
          highlightIcon(Warning, t.requireAttention, 'text-red-500'),
        ),
      ),
      h(
        'div', // Partition and actions container
        { class: 'relative z-10 hidden sidebar:flex justify-end' },
        h(
          'div', // Partition/Profile color
          {
            class: 'w-1 h-5 mr-1 group-hover/suspended:hidden group-hover/active:hidden',
            style: { backgroundColor: t.partition.color },
          },
          '',
        ),
        btnIcon(Close, {
          classNames: ['text-white', 'hidden', 'group-hover/suspended:block'],
          size: 5,
          dataAction: 'close-tab',
          onClick: closeTabFromEvent,
        }),
        btnIcon(Minus, {
          classNames: ['text-white', 'hidden', 'group-hover/active:block'],
          size: 5,
          dataAction: 'suspend-tab',
          onClick: suspendTabFromEvent,
        }),
      ),
    );
  }

  function highlightIcon(icon: string, visible: boolean, color: string): VNode {
    return h(
      'div',
      {
        class: c(
          'w-3.5',
          'h-3.5',
          visible ? 'block' : 'hidden',
          color,
          '[&>svg]:w-full',
          '[&>svg]:h-full',
        ),
        innerHTML: icon,
      },
      '',
    );
  }

  // Immutable-ish in-place merge: returns a shallow-copied tree with the given
  // tab replaced by id, or null when the tab is not present in the tree.
  function updateTabInContainers(containers: ITabContainer[], tab: ITab): ITabContainer[] | null {
    let found = false;

    const result = containers.map((tc) => {
      const tabIndex = tc.tabs.findIndex((t) => t.id === tab.id);
      if (tabIndex !== -1) {
        found = true;
        const tabs = [...tc.tabs];
        tabs[tabIndex] = tab;
        return { ...tc, tabs };
      }

      let childFound = false;
      const children = tc.children.map((tcc) => {
        const childTabIndex = tcc.tabs.findIndex((t) => t.id === tab.id);
        if (childTabIndex !== -1) {
          childFound = true;
          found = true;
          const tabs = [...tcc.tabs];
          tabs[childTabIndex] = tab;
          return { ...tcc, tabs };
        }
        return tcc;
      });

      return childFound ? { ...tc, children } : tc;
    });

    return found ? result : null;
  }
</script>
