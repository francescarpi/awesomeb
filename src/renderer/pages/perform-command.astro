---
import Layout from '../layouts/Base.astro';
import ListWithSearch from '../components/common/ListWithSearch.astro';
---

<Layout>
  <div class="bg-black text-white p-4 flex flex-col gap-2 h-full">
    <h1 class="text-lg">Perform Command</h1>
    <ListWithSearch placeholder="Start typing to search commands..." id="list" />
  </div>
</Layout>

<script>
  import { getWinId } from '../scripts/window';
  import { manageListWithSearch } from '../scripts/list-with-search';

  const winId = getWinId();
  const commandsEl = document.getElementById('list')!;
  manageListWithSearch(
    commandsEl,
    'commands',
    (item) => {
      abCommands.perform(winId, item.id, {});
    },
    () => {
      abModal.closeModal(winId);
    },
  );
</script>
