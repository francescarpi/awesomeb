---
import Base from '#/layouts/Base.astro';
---

<Base>
  <div
    class="bg-linear-to-br from-gray-900 to-gray-800 text-gray-200 p-4 fixed inset-0"
    id="container"
  >
  </div>
</Base>

<script>
  import { Renderer, h, cls, getSearchParams } from '#/scripts';

  const { searchParams, winId } = getSearchParams();

  const message = searchParams.get('message')!;
  const url = new URL(searchParams.get('url')!);

  new Renderer(
    h(
      'div',
      { classs: cls('flex', 'flex-col', 'gap-3') },
      h('h1', { class: cls('text-lg') }, `${url.hostname} says`),
      h('p', { class: cls('text-md', 'my-6') }, message),
      h(
        'div',
        { class: cls('flex', 'justify-center', 'gap-3') },
        h(
          'button',
          {
            class: cls('btn', 'btn-sm', 'flex-1'),
            onclick: () => abPrompts.response(winId, false),
          },
          'Cancel',
        ),
        h(
          'button',
          {
            class: cls('btn', 'btn-primary', 'btn-sm', 'flex-1'),
            onclick: () => abPrompts.response(winId, true),
          },
          'OK',
        ),
      ),
    ),
    'container',
  ).render();
</script>
