---

<div id="downloads-content"></div>

<script>
  import { Renderer, h, btnIcon, getSearchParams, c } from '#/scripts';
  import IdleIcon from '#/icons/downloads.svg?raw';
  import AnimatedIcon from '#/icons/downloads-animated.svg?raw';

  const { winId } = getSearchParams();

  const renderer = new Renderer(h('div', null)).render('downloads-content');

  renderIcon(false);

  abDownloads.onRefresh((_event, data) => {
    renderIcon(data.downloading, data.items.length);
  });

  function renderIcon(downloading: boolean, itemsCount = 0) {
    renderer.update(
      h(
        'div',
        {
          style: 'app-region: no-drag;',
          class: c('relative'),
        },
        h(
          'span',
          {
            class: c(
              itemsCount === 0 && 'hidden',
              'bg-error',
              'w-3',
              'h-3',
              'text-[9px]',
              'rounded-full',
              'flex',
              'items-center',
              'justify-center',
              'absolute',
              '-top-2',
              '-right-1.5',
            ),
          },
          itemsCount,
        ),
        btnIcon(downloading ? AnimatedIcon : IdleIcon, {
          classNames: ['text-white'],
          size: 5,
          id: 'downloads-icon',
          onClick: () => {
            const bounds = (
              document.getElementById('downloads-icon') as HTMLButtonElement
            ).getBoundingClientRect();
            abModal.openContextual(winId, 'contextual-downloads-modal', {
              bounds: {
                x: bounds.x,
                y: bounds.y,
                width: bounds.width,
                height: bounds.height,
              },
              anchor: 'bottom-left',
            });
          },
        }),
      ),
    );
  }
</script>
