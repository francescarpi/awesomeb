---
import Modal from '#/layouts/Modal.astro';
import ListWithSearch from '#/components/common/ListWithSearch.astro';
import Title from '#/components/common/Title.astro';
import Pagination from '#/components/common/Pagination.astro';
---

<Modal width="700px" height="600px">
  <Title>New Tab</Title>
  <div class="h-full">
    <Pagination />
    <div id="pageQuery" class="h-full relative">
      <div id="history" class="absolute top-10.5 left-1"></div>
      <ListWithSearch
        placeholder="Enter a query or a valid url..."
        id="query"
        className="[&>ul]:mt-2"
      />
    </div>
    <ListWithSearch placeholder="Select a profile..." id="partition" />
    <ListWithSearch placeholder="Select a target" id="target" />
  </div>
</Modal>

<script>
  import {
    listWithSearchManager,
    getSearchParams,
    paginatorManager,
    Renderer,
    h,
    cls,
  } from '#/scripts';
  import { IPartitionEntity } from '~/types';
  import { TFindUrlResult } from '@/core';

  const { winId } = getSearchParams();

  let query = '';

  const { nextPage, previousPage, refreshPageVisibility, refreshPageIndicator } = paginatorManager(
    'pagesIndicator',
    ['pageQuery', 'partition', 'target'],
  );

  refreshPageVisibility();
  refreshPageIndicator();

  const historyRenderer = new Renderer(h('div', {}, ''), 'history').render();
  renderHistory([]);

  // ------------------------------------------------------
  const { getSelected: getSearchEngine } = await listWithSearchManager('query', {
    entity: 'searchEngines',
    filtering: false,
    onEscape: () => abModal.close(winId),
    onTab: () => nextPage(),
    onShiftTab: () => previousPage(),
    onChange: async (inputValue, _entity, _inputEl) => {
      query = await searchInHistory(inputValue);
    },
    onAccept: () => handleSelect(),
  });

  const { getSelected: getPartition } = await listWithSearchManager('partition', {
    entity: 'partitions',
    onEscape: () => abModal.close(winId),
    onTab: () => nextPage(),
    onShiftTab: () => previousPage(),
    renderExtra: (item, rowEl) => {
      const entity = item as IPartitionEntity;
      const style = `background-color: ${entity.color}`;
      rowEl.innerHTML = `<div class="w-[15px] h-[15px] border" style="${style}"></div>`;
    },
    onAccept: () => handleSelect(),
  });

  const { getSelected: getTarget } = await listWithSearchManager('target', {
    entity: 'targets',
    onEscape: () => abModal.close(winId),
    onTab: () => nextPage(),
    onShiftTab: () => previousPage(),
    onAccept: () => handleSelect(),
  });

  // ------------------------------------------------------
  function handleSelect() {
    if (query.trim().length > 0) {
      const partitionId = getPartition()!.id;
      const searchEngineCode = getSearchEngine()!.id;
      const targetId = getTarget()!.id;

      abCommands.perform(winId, 'new-tab', {
        query,
        partitionId,
        searchEngineCode,
        targetId,
      });
    }
  }

  // ------------------------------------------------------
  async function searchInHistory(query: string): Promise<string> {
    const matches: TFindUrlResult[] = await abOpenURLHistory.find(winId, query);
    renderHistory(matches);
    return query;
  }

  // ------------------------------------------------------
  function renderHistory(matches: TFindUrlResult[]) {
    if (matches.length === 0) {
      historyRenderer.update(h('div', { class: cls('text-xs') }, 'Empty'));
      return;
    }

    historyRenderer.update(h('div', { class: cls('bg-primary', 'p-2') }, ''));
  }
</script>
