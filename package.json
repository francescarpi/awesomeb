  "dependencies": {
    "@electron-webauthn/macos": "1.3.1",
    "@thednp/color-picker": "2.0.4",
    "dayjs": "1.11.23",
    "electron-context-menu": "5.1.0",
    "electron-dl": "5.0.0",
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
