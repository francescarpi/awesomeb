---

---

<div id="tabContainers"></div>

<script>
  import { getSearchParams, h, type VNode, render, cls, diff, patch } from '#/scripts';
  import type { ITabContainer, IDesktopEntity, TDesktopId } from '~/types';
  import TabPreview from '#/icons/tab-preview.svg';
  import Muted from '#/icons/muted.svg';
  import Favicon from '#/icons/favicon.svg';
  import Minus from '#/icons/minus.svg';
  import Close from '#/icons/close.svg';

  const { winId } = getSearchParams();

  // Tab containers...
  const tabContainers = await abTabs.getTabContainers(winId);
  let tabContainersVDom = renderTabContainers(tabContainers);
  const tabContainersEl = render(tabContainersVDom);
  document.getElementById('tabContainers')!.appendChild(tabContainersEl);

  abTabs.onRefreshTabContainers((_event, tabContainers) => {
    const newTabContainersVDom = renderTabContainers(tabContainers);
    const domDiff = diff(tabContainersVDom, newTabContainersVDom);
    patch(tabContainersEl, domDiff);
    tabContainersVDom = newTabContainersVDom;
  });

  // Selected desktop...
  const desktops = (await abEntities.fetch(winId, 'desktops')) as IDesktopEntity[];
  const selected = parseInt(desktops.find((d) => d.selected)!.id, 10);
  refreshSelectedDesktop(selected);

  abDesktops.onRefreshSelected((_event, desktopId) => {
    refreshSelectedDesktop(desktopId);
  });

  // const favicon = await abFavicons.get(winId, this._tab.id);

  // ----------------------------------------------------------------------
  function refreshSelectedDesktop(id: TDesktopId) {
    document.getElementById('tabContainers')!.className = `group desktop-${id}`;
  }

  // ----------------------------------------------------------------------
  function renderTabContainers(tabContainers: ITabContainer[]): VNode {
    return h(
      'div', // Container
      {
        class: cls('flex', 'flex-col', 'gap-1.5'),
        style: 'app-region: no-drag;',
      },
      ...tabContainers.map((tc) =>
        h(
          'div', // Tab container
          {
            class: cls(
              'items-center',
              'gap-1',
              'hidden',
              `group-[.desktop-${tc.desktopId}]:flex`,
              tc.divider && 'border-b border-white/20 border-dashed pb-1.5',
            ),
          },
          h(
            'span', // Tab container shortcut (is a number between 1 and 9)
            { class: cls('text-xs', 'pl-1', 'text-white/20', 'hidden', 'sidebar:block') },
            tc.shortcut?.toString(),
          ),
          h(
            'div', // Tab container's tabs list (in vertical)
            { class: cls('flex', 'flex-col', 'w-full') },
            ...tc.tabs.map((t) =>
              h(
                'div', // Tab
                {
                  class: cls(
                    'py-1.5',
                    'cursor-pointer',
                    'hover:bg-white/20',
                    'gap-1',
                    'items-start',
                    'grid',
                    'grid-cols-1',
                    'sidebar:grid-cols-[24px_auto_25px]',
                    'select-none',
                    'sidebar:rounded-tl',
                    'sidebar:rounded-bl',
                    t.selected && 'bg-white/20',
                    t.suspended ? 'group/suspended opacity-50' : 'group/active',
                  ),
                  onclick: () => abCommands.perform(winId, 'select-tab', { tabId: t.id }),
                  oncontextmenu: () => abMenu.contextMenu(winId, 'tab', { tabId: t.id }),
                  ondblclick: () => abModal.open(winId, 'rename-tab'),
                },
                h(
                  'span', // Loading spinner
                  {
                    class: cls(
                      'loading',
                      'loading-spinner',
                      'loading-xs',
                      'ml-1',
                      'mt-0.5',
                      t.loading ? 'block' : 'hidden',
                    ),
                  },
                  '',
                ),
                h(
                  'img', // Favicon
                  {
                    src: Favicon.src,
                    class: cls(
                      'w-6',
                      'h-6',
                      'sidebar:w-[16px]',
                      'sidebar:h-[16px]',
                      'mt-0.5',
                      'ml-auto',
                      'mr-auto',
                      'sidebar:ml-1',
                      'sidebar:mr-0',
                      'text-white',
                      t.loading ? 'hidden' : 'block',
                    ),
                  },
                  '',
                ),
                h(
                  'div', // Title + indicators container
                  { class: cls('hidden', 'sidebar:flex', 'flex-col', 'min-w-0') },
                  h(
                    'span', // Title
                    { class: cls('text-sm', 'overflow-hidden', 'text-ellipsis', 'text-nowrap') },
                    t.title,
                  ),
                  h(
                    'div', // Indicators container
                    { class: cls('flex', 'gap-1') },
                    h(
                      'img', // Tab preview indicator
                      {
                        src: TabPreview.src,
                        class: cls('w-3.5', 'h-3.5', t.hasTabPreview ? 'block' : 'hidden'),
                      },
                      '',
                    ),
                    h(
                      'img', // Muted indicator
                      {
                        src: Muted.src,
                        class: cls('w-3.5', 'h-3.5', t.isMuted ? 'block' : 'hidden'),
                      },
                      '',
                    ),
                  ),
                ),
                h(
                  'div', // Partition and actions container
                  { class: cls('hidden', 'sidebar:flex', 'justify-end') },
                  h(
                    'div', // Partition/Profile color
                    {
                      class: cls('w-1', 'h-5', 'mr-1', 'group-hover/suspended:hidden'),
                      style: { backgroundColor: t.partition.color },
                    },
                    '',
                  ),
                  h(
                    'img', // Close button (to close the tab)
                    {
                      src: Close.src,
                      onclick: (e) => {
                        e.stopPropagation();
                        abCommands.perform(winId, 'close-tab', { tabId: t.id });
                      },
                      class: cls(
                        'w-5',
                        'h-5',
                        'mr-1',
                        'hover:bg-white/30',
                        'rounded',
                        'hidden',
                        'group-hover/suspended:block',
                      ),
                    },
                    '',
                  ),
                  h(
                    'img', // Suspend button (to suspend the tab)
                    {
                      src: Minus.src,
                      onclick: (e) => {
                        e.stopPropagation();
                        abCommands.perform(winId, 'suspend-tab', { tabId: t.id });
                      },
                      class: cls(
                        'w-5',
                        'h-5',
                        'mr-1',
                        'hover:bg-white/30',
                        'rounded',
                        'hidden',
                        'group-hover/active:block',
                      ),
                    },
                    '',
                  ),
                ),
              ),
            ),
          ),
        ),
      ),
    );
  }
</script>
