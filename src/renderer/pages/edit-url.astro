---
import BlackBgWithTitle from '../layouts/BlackBgWithTitle.astro';
import Option1 from '../components/edit-url/Option1.astro';
import Option2 from '../components/edit-url/Option2.astro';
---

<BlackBgWithTitle title="Edit URL">
  <div class="h-full">
    <Option1 />
    <Option2 />
  </div>
</BlackBgWithTitle>

<script>
  import { ITabEntity } from '~/types';
  import { getSearchParams } from '../scripts/url';
  import { inputManager } from '../scripts/inputs';

  const { winId, searchParams } = getSearchParams();
  const tabId = searchParams.get('tabId');

  const fullURLEl = document.querySelector('#input-full-url')! as HTMLInputElement;

  async function setup() {
    // Fetch tabs
    const tabsEntitites = (await abEntities.fetch(winId, 'tabs')) as ITabEntity[];

    // Find selected tab
    const selectedTab = tabId
      ? tabsEntitites.find((d: ITabEntity) => d.id === tabId)!
      : tabsEntitites.find((d) => d.selected)!;

    const { setDefaultValue } = inputManager(
      fullURLEl,
      (newValue: string) => {
        abCommands.perform(winId, 'edit-url', {
          tabId: parseInt(selectedTab.id, 10),
          url: newValue,
        });
      },
      () => abModal.close(winId),
    );

    setDefaultValue(selectedTab.url || '');
  }

  setup();
</script>
