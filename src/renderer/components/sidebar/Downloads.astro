---

---

<div id="downloads-content"></div>

<script>
  import { Renderer, h, btnIcon, getSearchParams, c } from '#/scripts';
  import IdleIcon from '#/icons/downloads.svg?raw';
  import AnimatedIcon from '#/icons/downloads-animated.svg?raw';
  import CompletedIcon from '#/icons/downloads-completed.svg?raw';

  const { winId } = getSearchParams();

  const renderer = new Renderer(h('div', null)).render('downloads-content');

  let downloading = false;
  let itemsCount = 0;
  let completedFlash = false;
  let completedFlashTimer: ReturnType<typeof setTimeout> | undefined;

  renderIcon();

  abDownloads.onRefresh((_event, data) => {
    downloading = data.downloading;
    itemsCount = data.activeCount;
    renderIcon();
  });

  abDownloads.onCompleted(() => {
    const iconEl = document.getElementById('downloads-icon');
    if (completedFlash && iconEl) {
      iconEl.classList.remove('icon-bounce');
      void iconEl.offsetWidth;
      iconEl.classList.add('icon-bounce');
    } else {
      completedFlash = true;
      renderIcon();
    }
    clearTimeout(completedFlashTimer);
    completedFlashTimer = setTimeout(() => {
      completedFlash = false;
      renderIcon();
    }, 1600);
  });

  function renderIcon() {
    const icon = completedFlash ? CompletedIcon : downloading ? AnimatedIcon : IdleIcon;
    renderer.update(
      h(
        'div',
        {
          style: 'app-region: no-drag;',
          class: c('relative', 'select-none'),
        },
        h(
          'span',
          {
            class: c(
              itemsCount === 0 && 'hidden',
              'bg-error',
              'text-error-content',
              'w-3',
              'h-3',
              'text-[9px]',
              'rounded-full',
              'flex',
              'items-center',
              'justify-center',
              'absolute',
              '-top-2',
              '-right-1.5',
            ),
          },
          itemsCount,
        ),
        btnIcon(icon, {
          classNames: ['text-white', completedFlash && 'icon-bounce'],
          size: 5,
          id: 'downloads-icon',
          onClick: () => {
            const bounds = (
              document.getElementById('downloads-icon') as HTMLButtonElement
            ).getBoundingClientRect();
            abModal.openContextual(winId, 'contextual-downloads-modal', {
              bounds: {
                x: bounds.x,
                y: bounds.y,
                width: bounds.width,
                height: bounds.height,
              },
              anchor: 'bottom-left',
            });
          },
        }),
      ),
    );
  }
</script>
