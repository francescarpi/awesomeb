---
import ListWithSearch from '#/components/common/ListWithSearch.astro';
import Modal from '#/layouts/Modal.astro';
import Title from '#/components/common/Title.astro';
import Pagination from '#/components/common/Pagination.astro';
---

<Modal width="500px" height="600px">
  <Title><span id="title-tab-duplicate">Duplicate Tab</span></Title>
  <div class="h-full">
    <Pagination />
    <ListWithSearch placeholder="Select tab..." id="tab" />
    <ListWithSearch placeholder="Select a profile..." id="partition" />
    <ListWithSearch placeholder="Select a target" id="target" />
  </div>
</Modal>

<script>
  import { listWithSearchManager, paginatorManager, getSearchParams } from '#/scripts';
  import { IPartitionEntity } from '~/types';
  import {
    initI18n,
    setText,
    setPlaceholder,
    setListEmptyText,
    onLocaleChange,
  } from '#/scripts/i18n';

  await initI18n();

  function apply() {
    setText('title-tab-duplicate', 'pages.tabDuplicate.title');
    setPlaceholder('tab', 'pages.tabDuplicate.tabPlaceholder');
    setPlaceholder('partition', 'pages.tabDuplicate.profilePlaceholder');
    setPlaceholder('target', 'pages.tabDuplicate.targetPlaceholder');
    setListEmptyText();
  }
  apply();
  onLocaleChange(apply);

  const { winId } = getSearchParams();

  const { nextPage, previousPage, refreshPageVisibility, refreshPageIndicator } = paginatorManager(
    'pagesIndicator',
    ['tab', 'partition', 'target'],
  );

  refreshPageVisibility();
  refreshPageIndicator();

  const { getSelected: getTab } = await listWithSearchManager('tab', {
    entity: 'tabs',
    onEscape: () => abModal.close(winId),
    onTab: () => nextPage(),
    onShiftTab: () => previousPage(),
    onAccept: () => handleAccept(),
  });

  const { getSelected: getPartition } = await listWithSearchManager('partition', {
    entity: 'partitions',
    onEscape: () => abModal.close(winId),
    onTab: () => nextPage(),
    onShiftTab: () => previousPage(),
    renderExtra: (item, rowEl) => {
      const entity = item as IPartitionEntity;
      const style = `background-color: ${entity.color}`;
      rowEl.innerHTML = `<div class="w-[15px] h-[15px] border" style="${style}"></div>`;
    },
    onAccept: () => handleAccept(),
  });

  const { getSelected: getTarget } = await listWithSearchManager('target', {
    entity: 'targets',
    onEscape: () => abModal.close(winId),
    onTab: () => nextPage(),
    onShiftTab: () => previousPage(),
    onAccept: () => handleAccept(),
  });

  function handleAccept() {
    const tabId = parseInt(getTab()!.id, 10);
    const partitionId = getPartition()!.id;
    const targetId = getTarget()!.id;

    abCommands.perform(winId, 'duplicate-tab', {
      tabId,
      partitionId,
      targetId,
    });
  }
</script>
