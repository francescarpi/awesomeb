---
const PAGES = [
  { id: 'general', name: 'General', section: '' },
  { id: 'profiles', name: 'Profiles', section: 'profiles' },
  { id: 'themes', name: 'Themes', section: 'themes' },
  { id: 'permissions', name: 'Permissions', section: 'permissions' },
];
---

<div role="tablist" class="tabs tabs-box my-4">
  {
    PAGES.map((page) => (
      <a role="tab" class="tab [--tab-bg:black]" href={`?${page.section}`}>
        {page.name}
      </a>
    ))
  }
</div>

<script>
  function updateActiveTab() {
    const section = window.location.search.substring(1);
    const tabs = document.querySelectorAll('.tab');

    tabs.forEach((tab) => {
      tab.classList.remove('tab-active');

      const href = tab.getAttribute('href');
      if (href === `?${section}`) {
        tab.classList.add('tab-active');
      }
    });

    const containers = document.querySelectorAll('.tab-content');
    containers.forEach((container) => {
      container.classList.add('hidden');

      console.log(container.id, section);
      if (container.id === `tab-${section}`) {
        container.classList.remove('hidden');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => updateActiveTab());
  document.addEventListener('hashchange', () => updateActiveTab());
</script>
