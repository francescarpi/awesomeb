---
import BlackBgWithTitle from '#/layouts/BlackBgWithTitle.astro';
---

<BlackBgWithTitle title="pages:bookmarks.title">
  <div id="content" class="h-full"></div>
</BlackBgWithTitle>

<script>
  import { type IBookmark, EBookmarkType, type IFolderBookmark } from '~/types';
  import {
    Renderer,
    h,
    c,
    type VNode,
    icon,
    btnIcon,
    editBookmark,
    dialogConfirm,
    dialogWithSelect,
    type IOption,
  } from '#/scripts';
  import Folder from '#/icons/folder.svg?raw';
  import Link from '#/icons/link.svg?raw';
  import ArrowDown from '#/icons/arrow-down.svg?raw';
  import Edit from '#/icons/edit.svg?raw';
  import Delete from '#/icons/delete.svg?raw';
  import Move from '#/icons/move.svg?raw';

  const t = await abI18n.t({}, [
    { key: 'save' },
    { key: 'move' },
    { key: 'delete' },
    { key: 'pages:bookmarks.deleteConfirm' },
    { key: 'pages:bookmarks.selectNewParent' },
    { key: 'pages:bookmarks.root' },
    { key: 'pages:bookmarks.title' },
    { key: 'pages:bookmarks.noBookmarks' },
    { key: 'pages:bookmarks.root' },
  ]);

  document.title = t['pages:bookmarks.title'];

  const state: { foldersOpened: string[]; folderSelected: IBookmark | null } = {
    foldersOpened: [],
    folderSelected: null,
  };

  const renderer = new Renderer(h('div', null)).render('content');
  let originalBookmarks: IBookmark[] = [];

  await reload();

  function renderBookmarks(bookmarks: IBookmark[]) {
    if (bookmarks.length === 0) {
      renderer.update(h('div', {}, t['pages:bookmarks.noBookmarks']));
      return;
    }

    renderer.update(
      h(
        'div',
        { class: c('grid', 'grid-cols-[290px_2fr]', 'gap-2', 'h-full') },
        h(
          'div',
          { class: c('bg-white/40', 'p-2', 'rounded') },
          ...renderFolders(filterFolders(bookmarks)),
        ),
        h('div', { class: c('min-w-0') }, renderContent()),
      ),
    );
  }

  function renderContent(): VNode {
    if (!state.folderSelected || state.folderSelected.children.length === 0) {
      return h(
        'div',
        { class: c('mx-auto', 'flex', 'flex-col', 'gap-2', 'bg-white/40', 'rounded', 'p-2') },
        t['pages:bookmarks.noBookmarks'],
      );
    }

    return h(
      'div',
      {
        class: c(
          'mx-auto',
          'w-full',
          'min-w-0',
          'flex',
          'flex-col',
          'gap-2',
          'bg-white/40',
          'rounded',
          'p-2',
        ),
      },
      ...state.folderSelected.children.map((child: IBookmark) =>
        h(
          'div',
          { class: c('flex', 'flex-col', 'w-full', 'min-w-0') },
          h(
            'div',
            { class: c('flex', 'gap-2', 'items-center', 'justify-between') },
            h(
              'div',
              { class: c('flex', 'items-center', 'gap-2') },
              h(
                'div',
                {},
                icon(child.type === EBookmarkType.Folder ? Folder : Link, 'text-black', '4'),
              ),
              h('div', {}, child.title),
            ),
            h(
              'div',
              { class: c('flex', 'gap-1') },
              btnIcon(Edit, {
                size: 4,
                classNames: ['hover:bg-white!'],
                onClick: async () => {
                  await editBookmark(child, async (result) => {
                    child.title = result.title;
                    if (child.type === EBookmarkType.Url && result.url) {
                      child.url = result.url;
                    }
                    await updateBookmarks(originalBookmarks);
                    refresh();
                  });
                },
              }),
              btnIcon(Move, {
                size: 4,
                classNames: ['hover:bg-white!'],
                onClick: async () => {
                  const options = bookmarksToOptions(originalBookmarks, child.id, 1);
                  await dialogWithSelect(t['pages:bookmarks.selectNewParent'], options, {
                    onAccept: async (selectedFolderId: string) => {
                      let newBookmarks = deleteBookmarkInList(originalBookmarks, child.id);

                      if (selectedFolderId === 'root') {
                        newBookmarks.push(child);
                      } else {
                        newBookmarks = addBookmarkToParent(newBookmarks, selectedFolderId, child);
                      }

                      await updateBookmarks(newBookmarks);
                      reload();
                    },
                  });
                },
              }),
              btnIcon(Delete, {
                size: 4,
                classNames: ['hover:bg-white!'],
                onClick: async () => {
                  await dialogConfirm(t['pages:bookmarks.deleteConfirm'], {
                    onAccept: async () => {
                      const newBookmarks = deleteBookmarkInList(originalBookmarks, child.id);
                      await updateBookmarks(newBookmarks);
                      reload();
                    },
                  });
                },
              }),
            ),
          ),
          h(
            'a',
            {
              class: c(
                'block',
                'w-full',
                'ml-6.5',
                'opacity-50',
                'truncate',
                'cursor-pointer',
                'text-sm',
                'pr-16',
              ),
              title: child.url,
              onclick: () => {
                abBookmarks.open(child.id);
              },
            },
            child.url,
          ),
        ),
      ),
    );
  }

  function renderFolders(folders: IFolderBookmark[], level: number = 0): VNode[] {
    const response: VNode[] = [];

    for (const folder of folders) {
      const children = filterFolders(folder.children);
      const hasChildren = children.length > 0;
      const selected = state.folderSelected?.id === folder.id;

      response.push(
        h(
          'div',
          {
            class: c(
              'mb-1',
              'flex',
              'items-center',
              'gap-1',
              'cursor-pointer',
              'rounded',
              'select-none',
              selected ? 'bg-primary text-primary-content' : 'hover:bg-black/10',
            ),
            onclick: () => {
              state.folderSelected = folder;
              refresh();
            },
          },
          h(
            'div',
            {
              class: c(!hasChildren && 'invisible', `ml-[${level}rem]`),
            },
            icon(ArrowDown, 'text-black', '7'),
          ),
          h('div', {}, icon(Folder, 'text-black', '4')),
          h('div', {}, folder.title),
        ),
      );

      if (children.length > 0) {
        response.push(...renderFolders(children, level + 1));
      }
    }
    return response;
  }

  async function reload() {
    const bookmarks = await abBookmarks.get();
    const bookmarksWithRoot = [
      {
        id: 'root',
        title: t['pages:bookmarks.root'],
        type: EBookmarkType.Folder,
        children: bookmarks,
      },
    ];

    originalBookmarks = bookmarksWithRoot;

    selectFirstFolder();

    refresh();
  }

  function refresh() {
    renderBookmarks(originalBookmarks);
  }

  function filterFolders(bookmarks: IBookmark[]): IFolderBookmark[] {
    return bookmarks.filter((b) => b.type === EBookmarkType.Folder);
  }

  function selectFirstFolder() {
    const folders = filterFolders(originalBookmarks);
    if (folders.length) {
      state.folderSelected = folders[0];
    }
  }

  function deleteBookmarkInList(bookmarks: IBookmark[], id: string): IBookmark[] {
    return bookmarks
      .filter((bookmark) => bookmark.id !== id)
      .map((bookmark) => {
        if (bookmark.type === EBookmarkType.Folder) {
          return {
            ...bookmark,
            children: deleteBookmarkInList(bookmark.children, id),
          };
        }
        return bookmark;
      });
  }

  async function updateBookmarks(bookmarks: IBookmark[]) {
    await abBookmarks.update(bookmarks[0].children);
  }

  function bookmarksToOptions(bookmarks: IBookmark[], ignoreId: string, level: number): IOption[] {
    let options: IOption[] = [];

    for (const bookmark of bookmarks) {
      if (bookmark.id === ignoreId) {
        continue;
      }

      if (bookmark.type === EBookmarkType.Folder) {
        options.push({
          label: `${'--'.repeat(level ?? 0)} ${bookmark.title}`,
          value: bookmark.id,
        });
        options = options.concat(bookmarksToOptions(bookmark.children, ignoreId, (level ?? 0) + 1));
      }
    }
    return options;
  }

  function addBookmarkToParent(
    bookmarks: IBookmark[],
    parentId: string,
    newBookmark: IBookmark,
  ): IBookmark[] {
    return bookmarks.map((bookmark) => {
      if (bookmark.id === parentId && bookmark.type === EBookmarkType.Folder) {
        return {
          ...bookmark,
          children: [...bookmark.children, newBookmark],
        };
      } else if (bookmark.type === EBookmarkType.Folder) {
        return {
          ...bookmark,
          children: addBookmarkToParent(bookmark.children, parentId, newBookmark),
        };
      }
      return bookmark;
    });
  }
</script>
