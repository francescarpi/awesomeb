---
import Layout from '#/layouts/Base.astro';
---

<Layout borderRadius="10px">
  <div id="content"></div>
</Layout>

<script>
  import { getSearchParams, Renderer, h, c } from '#/scripts';
  import alert from '#/icons/alert.svg?raw';

  const { winId, searchParams } = getSearchParams();
  const url = searchParams.get('url')!;
  const error = searchParams.get('error')!;
  const tabId = parseInt(searchParams.get('tabId')!, 10);

  const t = await abI18n.t({ winId }, [
    { key: 'pages:tabCertificateError.title' },
    { key: 'pages:tabCertificateError.message', params: { url, error } },
    { key: 'pages:tabCertificateError.button' },
  ]);

  new Renderer(
    h(
      'div',
      {
        class: c('bg-base-200', 'text-base-content', 'rounded-xl', 'fixed', 'inset-0'),
      },
      h(
        'div',
        {
          class: c(
            'max-w-6xl',
            'mx-auto',
            'flex',
            'flex-col',
            'items-center',
            'justify-center',
            'h-full',
            'gap-4',
          ),
        },
        h('div', {
          innerHTML: alert,
          class: c('w-30', 'h-30', 'text-error', '[&>svg]:w-full', '[&>svg]:h-full'),
        }),
        h('h6', { class: c('font-bold') }, t['pages:tabCertificateError.title']),
        h('p', {
          class: c('w-full', 'px-10'),
          innerHTML: t['pages:tabCertificateError.message'],
        }),
        h(
          'button',
          {
            class: c('btn', 'btn-sm', 'btn-error'),
            onclick: () => abTabs.trustCertificateError(tabId),
          },
          t['pages:tabCertificateError.button'],
        ),
      ),
    ),
  ).render('content');
</script>
