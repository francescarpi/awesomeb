---
import ListWithSearch from '#/components/common/ListWithSearch.astro';
import Modal from '#/layouts/Modal.astro';
---

<Modal height="400px">
  <h1 class="text-lg mb-2 text-primary">Add Tab Container Divider</h1>
  <ListWithSearch placeholder="Filter and select a tab container..." id="list" />
</Modal>

<script>
  import { getSearchParams, listWithSearchManager } from '#/scripts';

  const { winId } = getSearchParams();

  listWithSearchManager('list', {
    entity: 'tabContainers',
    onAccept: (item) => {
      abCommands.perform(winId, 'add-divider', { tabContainerId: parseInt(item.id, 10) });
    },
    onEscape: () => {
      abModal.close(winId);
    },
  });
</script>
