---

<div class="flex items-center justify-between gap-2" id="desktops"></div>

<script>
  import { IDesktopEntity } from '~/types';
  import { getSearchParams } from '#/scripts';

  const { winId } = getSearchParams();
  const container = document.getElementById('desktops')!;

  // Load and render desktops on initialization
  const desktops = await abEntities.fetch<IDesktopEntity>(winId, 'desktops');
  renderDesktops(desktops);

  // Subscribe to desktop updates
  abDesktops.onRefresh((_event, desktops) => {
    renderDesktops(desktops);
  });

  /**
   * Renders the list of desktops in the UI
   * @param desktops - Array of desktop entities to render
   */
  function renderDesktops(desktops: IDesktopEntity[]) {
    container.innerHTML = '';
    for (const desktop of desktops) {
      renderDesktop(desktop);
    }
  }

  /**
   * Renders a single desktop item in the UI
   * @param desktop - The desktop entity to render
   * @return void
   */
  function renderDesktop(desktop: IDesktopEntity) {
    // Desktop container
    const desktopContainer = document.createElement('div');
    desktopContainer.classList.add(
      'group',
      'relative',
      'hidden',
      'sidebar:block',
      '[.selected]:block',
    );

    // Desktop circle
    const desktopElement = document.createElement('div');
    desktopElement.classList.add(
      'border',
      'rounded-full',
      'sidebar:w-9',
      'sidebar:h-9',
      'sidebar:text-sm',
      'w-7',
      'h-7',
      'text-xs',
      'cursor-pointer',
      'sidebar:flex',
      'items-center',
      'justify-center',
      'flex',
    );
    desktopElement.style = 'app-region: no-drag;';
    desktopElement.textContent = desktop.id.toString();
    desktopElement.onclick = () => abDesktops.select(winId, parseInt(desktop.id, 10));
    desktopElement.oncontextmenu = () => {
      abMenu.contextMenu(winId, 'desktop', {
        desktopId: parseInt(desktop.id, 10),
      });
    };

    if (desktop.selected) {
      desktopContainer.classList.add('selected');
      desktopElement.classList.add('bg-white/20');
    }

    if (desktop.hasActiveTabs) {
      const hasTabsIndicator = document.createElement('div');
      hasTabsIndicator.classList.add(
        'w-[3px]',
        'h-[3px]',
        'rounded-full',
        'absolute',
        'bottom-1',
        'left-1/2',
        '-translate-x-1/2',
        'bg-white',
      );
      desktopContainer.appendChild(hasTabsIndicator);
    } else if (desktop.hasTabs) {
      const hasTabsIndicator = document.createElement('div');
      hasTabsIndicator.classList.add(
        'w-[3px]',
        'h-[3px]',
        'rounded-full',
        'absolute',
        'bottom-1',
        'left-1/2',
        '-translate-x-1/2',
        'bg-white/20',
      );
      desktopContainer.appendChild(hasTabsIndicator);
    }

    // Desktop name
    const desktopName = document.createElement('span');
    desktopName.classList.add(
      'text-[10px]',
      'absolute',
      'mt-1',
      'whitespace-nowrap',
      'left-1/2',
      '-translate-x-1/2',
      'sidebar:hidden',
      'sidebar:group-[.selected]:block',
      'sidebar:group-hover:block',
    );
    desktopName.textContent = desktop.name;

    desktopContainer.appendChild(desktopElement);
    desktopContainer.appendChild(desktopName);

    container.appendChild(desktopContainer);
  }
</script>
