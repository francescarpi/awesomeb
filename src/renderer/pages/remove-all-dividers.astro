---
import ListWithSearch from '#/components/common/ListWithSearch.astro';
import Modal from '#/layouts/Modal.astro';
import Title from '#/components/common/Title.astro';
---

<Modal width="400px" height="400px">
  <Title><span id="title-dividers-remove-all">Remove all dividers from a desktop</span></Title>
  <ListWithSearch placeholder="Filter and select a desktop..." id="list" />
</Modal>

<script>
  import { getSearchParams, listWithSearchManager } from '#/scripts';
  import {
    initI18n,
    setText,
    setPlaceholder,
    setListEmptyText,
    onLocaleChange,
  } from '#/scripts/i18n';

  await initI18n();

  function apply() {
    setText('title-dividers-remove-all', 'pages.dividersRemoveAll.title');
    setPlaceholder('list', 'pages.dividersRemoveAll.listPlaceholder');
    setListEmptyText();
  }
  apply();
  onLocaleChange(apply);

  const { winId } = getSearchParams();

  listWithSearchManager('list', {
    entity: 'desktops',
    onAccept: (item) => {
      abCommands.perform(winId, 'remove-all-dividers', { desktopId: parseInt(item.id, 10) });
    },
    onEscape: () => {
      abModal.close(winId);
    },
  });
</script>
