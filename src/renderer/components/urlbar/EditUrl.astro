---
import ButtonIcon from '../../components/common/ButtonIcon.astro';
---

<ButtonIcon icon="edit" className="disabled" />

<script>
  import { getSearchParams } from '../../scripts/url';
  const { winId } = getSearchParams();
  const iconEl = document.querySelector('svg#edit')!;

  function handleEdit() {
    abModal.open(winId, 'edit-url');
  }

  abUrlBar.onRefresh((_event, data) => {
    if (data.url.trim().length === 0) {
      iconEl.classList.add('disabled');
      iconEl.removeEventListener('click', handleEdit);
    } else {
      iconEl.classList.remove('disabled');
      iconEl.addEventListener('click', handleEdit);
    }
  });
</script>
