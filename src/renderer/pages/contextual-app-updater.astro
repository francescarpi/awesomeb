---
import ContextualModal from '#/components/common/ContextualModal.astro';
---

<ContextualModal width="w-[500px]" />

<script>
  import { getSearchParams, Renderer, c, h } from '#/scripts';

  const { winId } = getSearchParams();

  const renderer = new Renderer(h('div', null)).render('content');

  const t = await abI18n.t(winId, [
    { key: 'pages:appUpdater.current' },
    { key: 'pages:appUpdater.new' },
    { key: 'pages:appUpdater.failed' },
  ]);

  const data = await abAppUpdater.versionAvailable(winId);
  if (data) {
    renderer.update(
      h(
        'div',
        {},
        h(
          'div',
          { class: c('flex', 'items-center', 'justify-between', 'mb-4') },
          h('span', null, t['pages:appUpdater.current'], h('strong', null, ` ${data.current}`)),
          h('span', null, t['pages:appUpdater.new'], h('strong', null, ` ${data.version}`)),
          h(
            'button',
            {
              class: c('btn', 'btn-primary', 'btn-sm'),
              onclick: () => {
                abAppUpdater.download(winId);
              },
            },
            'Update now',
          ),
        ),
        h('div', { class: c('h-90', 'overflow-y-auto'), innerHTML: data.releaseNotes }),
      ),
    );
  } else {
    renderer.update(h('div', null, t['pages:appUpdater.failed']));
  }
</script>

<style is:global>
  h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
</style>
