---
interface Props {
  placeholder: string;
  id: string;
  className?: string;
  oneColumn?: boolean;
  title?: string;
}

const { placeholder, id, className, oneColumn, title } = Astro.props;
---

<div class={`h-full grid grid-rows-[40px_auto] gap-3 relative ${className}`} id={id}>
  <input class="input input-sm w-full" data-placeholder={placeholder} autofocus />
  {title && <h2 class="absolute left-0 bottom-6.25 text-[9px] px-2 w-full text-center">{title}</h2>}
  <ul class="menu block overflow-y-auto mb-11 w-full">
    <li>
      <div>
        <p>Empty...</p>
      </div>
    </li>
  </ul>

  <template id="row-template">
    <li class={`grid ${oneColumn ? 'grid-cols-1' : 'grid-cols-2'}`}>
      <p class="block truncate [&>mark]:text-info [&>mark]:bg-transparent"></p>
      <small class={`justify-self-end text-right ${oneColumn ? 'hidden' : ''}`}></small>
    </li>
  </template>
</div>

<script>
  import { getSearchParams } from '#/scripts';

  const { winId } = getSearchParams();

  const inputs = document.querySelectorAll<HTMLInputElement>('input[data-placeholder]');
  const keys: { key: string }[] = [];
  for (const input of inputs) {
    keys.push({ key: input.dataset.placeholder as string });
  }

  const t = await abI18n.t(winId, keys);
  for (const input of inputs) {
    input.placeholder = t[input.dataset.placeholder as tring];
    keys.push({ key: input.dataset.placeholder as string });
  }
</script>
