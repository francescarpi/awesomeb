---
import ListWithSearch from '#/components/common/ListWithSearch.astro';
import Modal from '#/layouts/Modal.astro';
import Title from '#/components/common/Title.astro';
---

<Modal width="500px" height="600px">
  <Title><span id="title-open-closed">Open Closed Tab</span></Title>
  <ListWithSearch placeholder="Filter and select a tab..." id="list" />
</Modal>

<script>
  import { getSearchParams, listWithSearchManager } from '#/scripts';
  import {
    initI18n,
    setText,
    setPlaceholder,
    setListEmptyText,
    onLocaleChange,
  } from '#/scripts/i18n';

  await initI18n();

  function apply() {
    setText('title-open-closed', 'pages.closedTabsOpen.title');
    setPlaceholder('list', 'pages.closedTabsOpen.listPlaceholder');
    setListEmptyText();
  }
  apply();
  onLocaleChange(apply);

  const { winId } = getSearchParams();

  listWithSearchManager('list', {
    entity: 'closedTabs',
    onAccept: (item) => {
      abCommands.perform(winId, 'open-closed', { id: item.id });
    },
    onEscape: () => {
      abModal.close(winId);
    },
  });
</script>
