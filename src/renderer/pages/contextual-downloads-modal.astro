---
import ContextualModal from '#/components/common/ContextualModal.astro';
---

<ContextualModal>
  <div>
    <div id="no-downloads" class="text-center mt-2 hidden">No downloads for this session.</div>
    <ul id="downloads-list" class="divide-y mt-2">
      <!-- Downloads will be rendered here -->
    </ul>
    <div class="flex justify-end mt-4 border-t pt-2">
      <button class="btn btn-xs" id="show-all">Show all downloads</button>
    </div>
  </div>
</ContextualModal>

<script>
  import { onClick, getSearchParams } from '#/scripts';
  import { EDownloadStatus, IDownloads, IDownloadItem } from '~/types';

  const { winId } = getSearchParams();

  onClick('show-all', () => {
    abDownloads.openPage(winId);
  });

  abDownloads.onRefresh((_event, data) => renderDownloads(data));
  abDownloads.get(winId).then((data) => renderDownloads(data));

  function renderDownloads(data: IDownloads) {
    const noDownloadsEl = document.getElementById('no-downloads')!;
    if (data.items.length === 0) {
      noDownloadsEl.classList.remove('hidden');
      return;
    }

    const downloadsListEl = document.getElementById('downloads-list')!;
    downloadsListEl.innerHTML = '';

    for (const item of data.items) {
      const li = createRow(item);

      const name = createFileName(item);

      const content = document.createElement('div');
      content.classList.add('flex', 'items-center', 'gap-2');

      if (item.status === EDownloadStatus.Cancelled) {
        content.classList.add('opacity-30');
      }

      const progress = document.createElement('progress');
      progress.className = 'progress progress-primary';
      progress.value = item.progress;
      progress.max = 100;

      const progressText = document.createElement('span');
      progressText.textContent = `${item.progress}%`;
      progressText.className = 'text-xs';

      content.appendChild(progress);
      content.appendChild(progressText);

      li.appendChild(name);
      li.appendChild(content);
      downloadsListEl.appendChild(li);
    }
  }

  function createRow(item: IDownloadItem): HTMLLIElement {
    const li = document.createElement('li');
    li.classList.add('py-2');

    if (item.status === EDownloadStatus.Paused) {
      li.classList.add('opacity-30');
    }

    return li;
  }

  function createFileName(item: IDownloadItem): HTMLDivElement {
    const nameContainer = document.createElement('div');
    nameContainer.classList.add('flex', 'gap-2');

    const name = document.createElement('span');
    name.classList.add('truncate');
    name.textContent = item.fileName;
    nameContainer.appendChild(name);

    if (item.status === EDownloadStatus.Cancelled) {
      name.classList.add('line-through');
    }

    if (item.status === EDownloadStatus.InProgress) {
      const btn = document.createElement('button') as HTMLButtonElement;
      btn.className = 'btn btn-xs btn-error';
      btn.textContent = 'X';
      btn.onclick = () => abDownloads.action(item.savePath, 'cancel', winId);

      nameContainer.appendChild(btn);
    } else if (item.status === EDownloadStatus.Completed) {
      const btn = document.createElement('button') as HTMLButtonElement;
      btn.className = 'btn btn-xs';
      btn.textContent = 'Show in folder';
      btn.onclick = () => abDownloads.action(item.savePath, 'open', winId);

      nameContainer.appendChild(btn);
    }

    return nameContainer;
  }
</script>
