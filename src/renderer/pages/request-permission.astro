---
import Modal from '#/layouts/Modal.astro';
import Title from '#/components/common/Title.astro';
---

<Modal>
  <Title title="pages:requestPermission.title" />
  <div id="content"></div>
</Modal>

<script>
  import { Renderer, h, c, getSearchParams, confirmButtons } from '#/scripts';

  const { searchParams, winId } = getSearchParams();
  const host = searchParams.get('host') as string;
  const permission = searchParams.get('permission') as string;
  const tabId = parseInt(searchParams.get('tabId')!, 10);
  const t = await abI18n.t({ winId }, [
    { key: 'pages:requestPermission.message', params: { host, permission } },
  ]);

  const [btns, registerBtnsEvents] = await confirmButtons({
    winId,
    onConfirm: () => {
      abTabs.grantPermission(winId, tabId, true);
      abModal.close(winId);
    },
    onCancel: () => {
      abTabs.grantPermission(winId, tabId, false);
      abModal.close(winId);
    },
  });

  new Renderer(
    h(
      'div',
      { class: c('flex', 'flex-col', 'gap-2') },
      h('p', {
        innerHTML: t['pages:requestPermission.message'],
      }),
      h('div', { class: c('flex', 'justify-end', 'gap-2', 'mt-4') }, ...btns),
    ),
  ).render('content', { onRendered: registerBtnsEvents });
</script>
