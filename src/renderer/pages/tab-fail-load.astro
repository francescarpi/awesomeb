---
import Layout from '#/layouts/Base.astro';
---

<Layout borderRadius="10px">
  <div id="content"></div>
</Layout>

<script>
  import { getSearchParams, Renderer, h, c, confirmButtons } from '#/scripts';
  import alert from '#/icons/alert.svg?raw';

  const { searchParams, winId } = getSearchParams();
  const url = searchParams.get('url');
  const code = searchParams.get('code');
  const description = searchParams.get('description');
  const tabId = parseInt(searchParams.get('tabId')!, 10);

  const t = await abI18n.t({ winId }, [
    { key: 'pages:tabFailLoad.title' },
    { key: 'pages:tabFailLoad.message', params: { url } },
    { key: 'pages:tabFailLoad.errorCode' },
    { key: 'pages:tabFailLoad.error' },
    { key: 'pages:tabFailLoad.retry' },
  ]);

  const [btns, registerBtnsEvents] = await confirmButtons({
    winId,
    confirmText: t['pages:tabFailLoad.retry'],
    onConfirm: () => {
      abTabs.retryFailed(tabId);
    },
  });

  new Renderer(
    h(
      'div',
      {
        class: c('bg-base-200', 'text-base-content', 'rounded-xl', 'fixed', 'inset-0'),
      },
      h(
        'div',
        {
          class: c(
            'max-w-6xl',
            'mx-auto',
            'flex',
            'flex-col',
            'items-center',
            'justify-center',
            'h-full',
            'gap-4',
          ),
        },
        h('div', {
          innerHTML: alert,
          class: c('w-30', 'h-30', 'text-error', '[&>svg]:w-full', '[&>svg]:h-full'),
        }),
        h('h6', { class: c('font-bold') }, t['pages:tabFailLoad.title']),
        h(
          'p',
          { class: c('w-full', 'truncate', 'text-center', 'px-10') },
          t['pages:tabFailLoad.message'],
        ),
        h(
          'div',
          {
            class: c(
              'bg-base-content/10',
              'text-base-content',
              'p-4',
              'rounded',
              'w-full',
              'max-w-md',
            ),
          },
          h('p', null, t['pages:tabFailLoad.errorCode'], ' ', h('span', { class: 'code' }, code)),
          h(
            'p',
            null,
            t['pages:tabFailLoad.error'],
            ' ',
            h('span', { class: 'description' }, description),
          ),
        ),
        ...btns,
      ),
    ),
  ).render('content', { onRendered: registerBtnsEvents });
</script>
