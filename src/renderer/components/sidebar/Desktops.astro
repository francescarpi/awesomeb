---
---

<div id="desktops"></div>

<script>
  import { type IDesktop } from '~/types';
  import {
    getSearchParams,
    h,
    type VNode,
    c,
    Renderer,
    selectDesktopFromEvent,
    desktopMenuFromEvent,
  } from '#/scripts';

  const { winId } = getSearchParams();

  // Load and render desktops on initialization
  const desktops = await abDesktops.all(winId);
  const renderer = new Renderer(renderDesktops(desktops)).render('desktops');

  // Subscribe to desktop updates
  abDesktops.onRefresh((_event, desktops) => renderer.update(renderDesktops(desktops)));

  /**
   * Renders the list of desktops in the UI
   * @param desktops - Array of desktop entities to render
   */
  function renderDesktops(desktops: IDesktop[]): VNode {
    return h(
      'div',
      { class: 'grid grid-cols-1 sidebar:grid-cols-5 items-center gap-2' },
      ...desktops.map((desktop) =>
        h(
          'div',
          {
            key: desktop.id,
            'data-desktop-id': String(desktop.id),
            class: c(
              'group',
              'relative',
              'hidden',
              'sidebar:block',
              '[.selected]:block',
              desktop.selected && 'selected',
            ),
          },
          h(
            'div',
            {
              class: c(
                'border',
                'rounded-full',
                'relative',
                'sidebar:w-9',
                'sidebar:h-9',
                'sidebar:text-sm',
                'w-7',
                'h-7',
                'text-xs',
                'cursor-pointer',
                'sidebar:flex',
                'items-center',
                'justify-center',
                'flex',
                'select-none',
                'overflow-hidden',
                desktop.requireAttention && 'bg-red-500/20 border-error',
              ),
              style: 'app-region: no-drag;',
              onclick: selectDesktopFromEvent,
              oncontextmenu: desktopMenuFromEvent,
            },
            h('div', {
              class: c(
                'pointer-events-none',
                'absolute',
                'inset-0',
                'rounded-full',
                'bg-white/20',
                'transition-opacity',
                'duration-300',
                'ease-out',
                'motion-reduce:transition-none',
                desktop.selected ? 'opacity-100' : 'opacity-0',
              ),
            }),
            h(
              'span',
              {
                class: c(
                  desktop.selected &&
                    desktop.shortName &&
                    desktop.shortName.trim() !== '' &&
                    'hidden',
                  desktop.shortName && desktop.shortName.trim() !== ''
                    ? 'sidebar:group-hover:hidden'
                    : '',
                ),
              },
              desktop.id,
            ),
            h(
              'div',
              {
                class: c(
                  'w-[3px]',
                  'h-[3px]',
                  'rounded-full',
                  'absolute',
                  'bottom-1',
                  'left-1/2',
                  '-translate-x-1/2',
                  desktop.hasTabs && desktop.hasActiveTabs && 'bg-white',
                  desktop.hasTabs && !desktop.hasActiveTabs && 'bg-white/20',
                ),
              },
              '',
            ),
            h(
              'div',
              {
                class: c(
                  'text-[8px]',
                  'sidebar:text-[10px]',
                  'absolute',
                  'whitespace-nowrap',
                  'left-1/2',
                  '-translate-x-1/2',
                  'sidebar:hidden',
                  desktop.shortName && desktop.shortName.trim() !== ''
                    ? 'sidebar:group-[.selected]:block sidebar:group-hover:block'
                    : '',
                ),
              },
              desktop.shortName || '',
            ),
          ),
        ),
      ),
    );
  }
</script>
