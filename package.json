{
  "name": "AwesomeB.Astro",
  "version": "0.0.1a",
  "description": "",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "pnpm run build:main && pnpm run build:preload && concurrently --kill-others \"astro dev\" \"sleep 1 && electron .\"",
    "build": "pnpm run build:main && pnpm run build:preload && pnpm run build:astro && pnpm run build:electron",
    "build:mac": "pnpm run build:main && pnpm run build:preload && pnpm run build:astro && pnpm run build:electron:mac",
    "build:astro": "astro build",
    "build:electron": "electron-builder",
    "build:electron:mac": "electron-builder --mac",
    "build:main": "tsc --project tsconfig.main.json && tsc-alias -p tsconfig.main.json && pnpm run copy:assets",
    "build:preload": "tsc --project tsconfig.preload.json",
    "copy:assets": "cp -r src/main/assets dist/main",
    "start": "electron .",
    "format": "prettier --write src",
    "test": "vitest",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@eslint/js": "9.39.2",
    "@tailwindcss/vite": "4.1.18",
    "astro": "5.16.12",
    "astro-icon": "1.1.5",
    "concurrently": "9.2.1",
    "daisyui": "5.5.14",
    "electron": "40.0.0",
    "electron-builder": "26.4.0",
    "eslint": "9.39.2",
    "eslint-js": "github:eslint/js",
    "globals": "17.0.0",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.1.18",
    "tsc-alias": "1.8.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vite": "7.3.1",
    "vitest": "4.0.17"
  },
  "dependencies": {
    "electron-log": "5.4.3"
  }
}
