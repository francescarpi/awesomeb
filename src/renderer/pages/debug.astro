---
import BlackBgWithTitle from '#/layouts/BlackBgWithTitle.astro';
---

<BlackBgWithTitle title="pages:debug.title">
  <div>
    <div id="webcontents"></div>
    <div id="tabindex"></div>
  </div>
</BlackBgWithTitle>

<script>
  import { Renderer, h, c, type VNode, bool, radioBtn } from '#/scripts';
  import type { IDebugWebContent, IDebugTabIndex } from '~/types';

  const t = await abI18n.t({}, [
    { key: 'pages:debug.title' },
    { key: 'pages:debug.wcTitle' },
    { key: 'pages:debug.filterByWindow' },
    { key: 'pages:debug.order.no' },
    { key: 'pages:debug.order.mem' },
    { key: 'pages:debug.order.cpu' },
    { key: 'pages:debug.searchTitleURL' },
    { key: 'pages:debug.wcTableColumns.win' },
    { key: 'pages:debug.wcTableColumns.pid' },
    { key: 'pages:debug.wcTableColumns.title' },
    { key: 'pages:debug.wcTableColumns.visible' },
    { key: 'pages:debug.wcTableColumns.profile' },
    { key: 'pages:debug.wcTableColumns.preloads' },
    { key: 'pages:debug.wcTableColumns.memory' },
    { key: 'pages:debug.wcTableColumns.cpu' },
    { key: 'pages:debug.tiTitle' },
    { key: 'pages:debug.tiTableColumns.tabIndex' },
    { key: 'pages:debug.tiTableColumns.window' },
    { key: 'pages:debug.tiTableColumns.desktop' },
    { key: 'pages:debug.tiTableColumns.tabContainer' },
    { key: 'pages:debug.tiTableColumns.tabId' },
    { key: 'pages:debug.tiTableColumns.tabTitle' },
  ]);

  document.title = t['pages:debug.title'];

  const state = {
    rawWcs: [] as IDebugWebContent[],
    filterWinId: -1,
    ordering: 'none' as 'none' | 'mem' | 'cpu',
    orderDir: 'asc' as 'asc' | 'desc',
    searchQuery: '',
    lastUpdated: 0,
    error: null as string | null,
    tabIndexData: [] as IDebugTabIndex[],
  };

  let intervalId: number | null = null;
  let staticSelect: HTMLSelectElement | null = null;

  async function fetchData() {
    try {
      const wcs = await abDebug.webContents();
      const tabIndexData = await abDebug.tabIndex();
      state.rawWcs = wcs;
      state.error = null;
      state.lastUpdated = Date.now();
      state.tabIndexData = tabIndexData;
      updateSelectOptions();
      render();
    } catch (err) {
      console.error('Failed to fetch web contents:', err);
      state.error = err instanceof Error ? err.message : String(err);
      render();
    }
  }

  function updateSelectOptions() {
    if (!staticSelect) return;
    const windowsIDs = [...new Set(state.rawWcs.map((v) => v.winId))].sort((a, b) => a - b);
    const currentValue = staticSelect.value;

    while (staticSelect.options.length > 2) {
      staticSelect.remove(1);
    }

    for (const winID of windowsIDs) {
      const opt = document.createElement('option');
      opt.value = String(winID);
      opt.textContent = String(winID);
      staticSelect.appendChild(opt);
    }

    const stillValid = Array.from(staticSelect.options).some((o) => o.value === currentValue);
    if (stillValid) {
      staticSelect.value = currentValue;
    } else if (currentValue !== '-1') {
      state.filterWinId = -1;
      staticSelect.value = '-1';
    }
  }

  function onFilterChange(e: Event) {
    state.filterWinId = parseInt((e.target as HTMLSelectElement).value, 10);
    render();
  }

  function onChangeOrdering(e: Event) {
    const newOrdering = (e.target as HTMLInputElement).id as 'none' | 'mem' | 'cpu';
    if (state.ordering === newOrdering) {
      if (newOrdering !== 'none') {
        state.orderDir = state.orderDir === 'asc' ? 'desc' : 'asc';
      }
    } else {
      state.ordering = newOrdering;
      state.orderDir = 'asc';
    }
    render();
  }

  function onSearchInput(e: Event) {
    state.searchQuery = (e.target as HTMLInputElement).value;
    render();
  }

  function getRadioIndicator(id: 'none' | 'mem' | 'cpu'): string | undefined {
    if (state.ordering !== id || id === 'none') return undefined;
    return state.orderDir === 'asc' ? '↑' : '↓';
  }

  function renderWCs(): VNode {
    if (state.error) {
      return h('div', { class: c('p-4', 'text-error') }, `Error: ${state.error}`);
    }

    let displayWcs = [...state.rawWcs];

    if (state.filterWinId !== -1) {
      displayWcs = displayWcs.filter((wc) => wc.winId === state.filterWinId);
    }

    const q = state.searchQuery.trim().toLowerCase();
    if (q) {
      displayWcs = displayWcs.filter(
        (wc) =>
          wc.title.toLowerCase().includes(q) ||
          wc.url.toLowerCase().includes(q) ||
          String(wc.pid).includes(q) ||
          wc.preloads.some((p) => p.toLowerCase().includes(q)),
      );
    }

    if (state.ordering !== 'none') {
      const dir = state.orderDir === 'asc' ? 1 : -1;
      displayWcs.sort((a, b) => {
        const valA = state.ordering === 'mem' ? a.memoryValue : a.cpuValue;
        const valB = state.ordering === 'mem' ? b.memoryValue : b.cpuValue;
        return (valA - valB) * dir;
      });
    }

    return h(
      'div',
      null,
      h('p', { class: c('text-sm', 'mb-4') }, t['pages:debug.wcTitle']),
      h(
        'div',
        {
          class: c('mb-2', 'px-1', 'flex', 'justify-between', 'items-center', 'gap-2', 'flex-wrap'),
        },
        h(
          'div',
          { class: c('flex', 'gap-2') },
          h('div', { id: 'select-placeholder', class: c('w-40') }),
          h('input', {
            type: 'text',
            placeholder: t['pages:debug.searchTitleURL'],
            class: c('input', 'input-sm', 'w-80'),
            oninput: onSearchInput,
          }),
        ),
        h(
          'div',
          { class: c('flex', 'items-center', 'gap-2') },
          radioBtn(
            'performance',
            'none',
            t['pages:debug.order.no'],
            state.ordering === 'none',
            onChangeOrdering,
          ),
          radioBtn(
            'performance',
            'mem',
            t['pages:debug.order.mem'],
            state.ordering === 'mem',
            onChangeOrdering,
            getRadioIndicator('mem'),
          ),
          radioBtn(
            'performance',
            'cpu',
            t['pages:debug.order.cpu'],
            state.ordering === 'cpu',
            onChangeOrdering,
            getRadioIndicator('cpu'),
          ),
        ),
      ),
      h(
        'div',
        { class: c('border', 'rounded', 'border-base-content/30', 'overflow-x-auto', 'w-full') },
        h(
          'table',
          { class: c('table', 'table-sm') },
          h(
            'thead',
            null,
            h(
              'tr',
              null,
              h('th', { class: c('w-10', 'font-mono') }, t['pages:debug.wcTableColumns.win']),
              h('th', { class: c('w-16', 'font-mono') }, t['pages:debug.wcTableColumns.pid']),
              h('th', null, t['pages:debug.wcTableColumns.title']),
              h('th', { class: c('text-center', 'w-20') }, t['pages:debug.wcTableColumns.visible']),
              h('th', { class: c('text-left', 'w-40') }, t['pages:debug.wcTableColumns.profile']),
              h('th', { class: c('text-left', 'w-48') }, t['pages:debug.wcTableColumns.preloads']),
              h(
                'th',
                { class: c('text-right', 'w-24', 'font-mono') },
                t['pages:debug.wcTableColumns.memory'],
              ),
              h(
                'th',
                { class: c('text-right', 'w-24', 'font-mono') },
                t['pages:debug.wcTableColumns.cpu'],
              ),
            ),
          ),
          h(
            'tbody',
            null,
            ...displayWcs.map((view) =>
              h(
                'tr',
                null,
                h('td', { class: c('text-center', 'font-mono') }, view.winId),
                h('td', { class: c('font-mono') }, view.pid),
                h(
                  'td',
                  null,
                  h(
                    'div',
                    {
                      class: c('max-w-md', 'truncate'),
                      title: `${view.title}\n${view.url}`,
                    },
                    view.title || view.url,
                  ),
                ),
                h('td', { align: 'center' }, bool(view.visible, { colorized: true })),
                h(
                  'td',
                  { class: c('text-left') },
                  `${view.partition.name} (${view.partition.persistent ? 'disk' : 'memory'})`,
                ),
                h('td', {
                  class: c('text-left', 'truncate', 'max-w-xs'),
                  innerHTML:
                    view.preloads
                      .map((p) => `${p.filePath.split(/[\\\\\\/]/).pop()} (${p.type})`)
                      .join('<br/>') || '-',
                }),
                h(
                  'td',
                  {
                    class: c('text-right', 'font-mono'),
                    title: `Raw: ${view.memoryValue}`,
                  },
                  view.memory,
                ),
                h(
                  'td',
                  {
                    class: c('text-right', 'font-mono', 'whitespace-nowrap'),
                    title: `Raw: ${view.cpuValue}`,
                  },
                  view.cpu,
                ),
              ),
            ),
          ),
        ),
      ),
    );
  }

  const wcRenderer = new Renderer(renderWCs());
  wcRenderer.render('webcontents');
  const tiRenderer = new Renderer(renderTabIndex());
  tiRenderer.render('tabindex');

  const placeholder = document.getElementById('select-placeholder');
  if (placeholder) {
    staticSelect = document.createElement('select');
    staticSelect.className = c('select', 'select-sm', 'w-40');
    staticSelect.addEventListener('change', onFilterChange);

    const defaultOpt = document.createElement('option');
    defaultOpt.value = '-1';
    defaultOpt.textContent = t['pages:debug.filterByWindow'];
    staticSelect.appendChild(defaultOpt);

    placeholder.parentNode!.insertBefore(staticSelect, placeholder);
    placeholder.remove();
  }

  function startInterval() {
    if (intervalId !== null) return;
    fetchData();
    intervalId = window.setInterval(fetchData, 1000);
  }

  function stopInterval() {
    if (intervalId !== null) {
      clearInterval(intervalId);
      intervalId = null;
    }
  }

  function render() {
    wcRenderer.update(renderWCs());
    tiRenderer.update(renderTabIndex());
  }

  startInterval();

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') {
      stopInterval();
    } else {
      startInterval();
    }
  });

  window.addEventListener('pagehide', stopInterval);
  window.addEventListener('beforeunload', stopInterval);

  function renderTabIndex(): VNode {
    return h(
      'div',
      { class: c('mt-3') },
      h('p', { class: c('text-sm', 'mb-2') }, t['pages:debug.tiTitle']),
      h(
        'div',
        { class: c('border', 'rounded', 'border-base-content/30', 'overflow-x-auto', 'w-full') },
        h(
          'table',
          { class: c('table', 'table-sm') },
          h(
            'thead',
            null,
            h(
              'tr',
              null,
              h('th', null, t['pages:debug.tiTableColumns.tabIndex']),
              h('th', null, t['pages:debug.tiTableColumns.window']),
              h('th', null, t['pages:debug.tiTableColumns.desktop']),
              h('th', null, t['pages:debug.tiTableColumns.tabContainer']),
              h('th', null, t['pages:debug.tiTableColumns.tabId']),
              h('th', null, t['pages:debug.tiTableColumns.tabTitle']),
            ),
          ),
          h(
            'tbody',
            null,
            ...state.tabIndexData.map((entry) =>
              h(
                'tr',
                null,
                h('td', null, entry.indexTabId),
                h('td', null, entry.winId),
                h('td', null, entry.desktopId),
                h('td', null, entry.tabContainerID),
                h('td', null, entry.tab.id),
                h('td', null, entry.tab.title),
              ),
            ),
          ),
        ),
      ),
    );
  }
</script>
