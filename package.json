{
  "name": "AwesomeB",
  "version": "0.0.1a",
  "description": "",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "pnpm run build:main && pnpm run build:preload && concurrently \"astro dev\" \"sleep 1 && electron .\"",
    "build": "pnpm run build:main && pnpm run build:preload && pnpm run build:astro && pnpm run build:electron",
    "build:mac": "pnpm run build:main && pnpm run build:preload && pnpm run build:astro && pnpm run build:electron:mac",
    "build:astro": "astro build",
    "build:electron": "electron-builder",
    "build:electron:mac": "electron-builder --mac",
    "build:main": "tsc --project tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "build:preload": "tsc --project tsconfig.preload.json",
    "start": "electron .",
    "format": "prettier --write src",
    "test": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "astro": "5.16.11",
    "concurrently": "9.2.1",
    "electron": "40.0.0",
    "electron-builder": "26.4.0",
    "electron-log": "5.4.3",
    "prettier": "3.8.0",
    "prettier-plugin-astro": "0.14.1",
    "tsc-alias": "1.8.16",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.17"
  }
}
