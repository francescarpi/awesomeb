---
interface Props {
  placeholder: string;
  id: string;
}

const { placeholder, id } = Astro.props;
---

<div class="h-full grid grid-rows-[40px_auto] gap-3" id={id}>
  <input class="input w-full text-black rounded-full" placeholder={placeholder} autofocus />
  <ul class="list border rounded-xl overflow-y-auto mb-9">
    <li class="list-row border-b border-white/50">
      <div>
        <p>Empty...</p>
      </div>
    </li>
  </ul>

  <template id="row-template">
    <li class="list-row border-b border-white/50 grid grid-cols-2">
      <p class="truncate"></p>
      <small class="justify-self-end text-right"></small>
    </li>
  </template>
</div>
