---
import { Icon } from 'astro-icon/components';
---

<div
  class="border border-white/50 w-full h-screen rounded-lg flex gap-2 pl-2 items-center"
  id="url"
>
  <span class="loading loading-spinner loading-xs hidden"></span>
  <Icon name="safe" id="safe-site" class="hidden" />
  <Icon name="unsafe" id="unsafe-site" class="hidden" />
  <input class="outline-0 w-full h-full rounded-lg text-sm" readonly />
</div>

<script>
  const url = document.getElementById('url')!;
  const loading = url.querySelector('span')!;
  const input = url.querySelector('input')!;
  const safeIcon = url.querySelector('#safe-site')!;
  const unsafeIcon = url.querySelector('#unsafe-site')!;

  abUrlBar.onRefresh((_event, data) => {
    if (data.loading) {
      loading.classList.remove('hidden');
    } else {
      loading.classList.add('hidden');
    }

    input.value = data.url;

    if (data.url.trim().length > 0 && !data.loading) {
      if (data.safe) {
        safeIcon.classList.remove('hidden');
        unsafeIcon.classList.add('hidden');
      } else {
        safeIcon.classList.add('hidden');
        unsafeIcon.classList.remove('hidden');
      }
    } else {
      safeIcon.classList.add('hidden');
      unsafeIcon.classList.add('hidden');
    }
  });
</script>
