---
import { Icon } from 'astro-icon/components';

interface Props {
  icon: string;
  className?: string;
}

const { icon, className } = Astro.props;
---

<Icon
  name={icon}
  id={icon}
  class={`text-2xl hover:bg-white/30 rounded cursor-pointer ${className ?? ''}`}
  style="app-region: no-drag;"
/>

<style>
  .disabled {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
