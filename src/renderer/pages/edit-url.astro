---
import Option1 from '#/components/edit-url/Option1.astro';
import Option2 from '#/components/edit-url/Option2.astro';
import Modal from '#/layouts/Modal.astro';
import Title from '#/components/common/Title.astro';
---

<Modal width="800px">
  <Title>Edit URL</Title>
  <div class="h-full flex flex-col gap-4">
    <Option1 />
    <Option2 />
  </div>
  <div class="flex justify-end gap-2 mt-4">
    <button id="btn-cancel" class="btn btn-ghost">Cancel</button>
    <button id="btn-accept" class="btn btn-primary">Accept</button>
  </div>
</Modal>

<script>
  import { ITabEntity } from '~/types';
  import { getSearchParams, inputManager, type TSetValue, type TSetDefault } from '#/scripts';

  const { winId, searchParams } = getSearchParams();
  const tabId = searchParams.get('tabId');

  const fullURLEl = document.querySelector('#input-full-url') as HTMLInputElement;
  const protocolEl = document.querySelector('#input-protocol') as HTMLInputElement;
  const hostnameEl = document.querySelector('#input-hostname') as HTMLInputElement;
  const portEl = document.querySelector('#input-port') as HTMLInputElement;
  const pathnameEl = document.querySelector('#input-pathname') as HTMLInputElement;
  const hashEl = document.querySelector('#input-hash') as HTMLInputElement;

  const queryParamsBody = document.querySelector('#query-params-body') as HTMLTableSectionElement;
  const btnAddQueryParam = document.querySelector('#btn-add-query-param') as HTMLButtonElement;
  const btnCancel = document.querySelector('#btn-cancel') as HTMLButtonElement;
  const btnAccept = document.querySelector('#btn-accept') as HTMLButtonElement;

  let useHashParams = false;

  function getQueryParamsFromDOM(): Array<{ key: string; value: string }> {
    const rows = queryParamsBody.children;
    const params: Array<{ key: string; value: string }> = [];
    Array.from(rows).forEach((row) => {
      const keyInput = row.querySelector('.query-key') as HTMLInputElement;
      const valueInput = row.querySelector('.query-value') as HTMLInputElement;
      params.push({ key: keyInput?.value || '', value: valueInput?.value || '' });
    });
    return params;
  }

  function hasEmptyQueryParamAtEnd(): boolean {
    const params = getQueryParamsFromDOM();
    if (params.length === 0) return false;
    const last = params[params.length - 1];
    return last.key === '' && last.value === '';
  }

  function createQueryParamRow(key: string = '', value: string = '', onChange?: () => void) {
    const container = document.createElement('div');
    container.className = 'flex items-center gap-2';

    const keyLabel = document.createElement('label');
    keyLabel.className = 'input text-black w-full flex-1';

    const keySpan = document.createElement('span');
    keySpan.className = 'w-12';
    keySpan.textContent = 'Key:';
    keyLabel.appendChild(keySpan);

    const keyInput = document.createElement('input');
    keyInput.type = 'text';
    keyInput.className = 'grow query-key';
    keyInput.placeholder = 'Key';
    keyInput.value = key;
    keyInput.addEventListener('input', () => {
      if (onChange) onChange();
    });
    keyLabel.appendChild(keyInput);

    const valueLabel = document.createElement('label');
    valueLabel.className = 'input text-black w-full flex-1';

    const valueSpan = document.createElement('span');
    valueSpan.className = 'w-12';
    valueSpan.textContent = 'Value:';
    valueLabel.appendChild(valueSpan);

    const valueInput = document.createElement('input');
    valueInput.type = 'text';
    valueInput.className = 'grow query-value';
    valueInput.placeholder = 'Value';
    valueInput.value = value;
    valueInput.addEventListener('input', () => {
      if (onChange) onChange();
    });
    valueLabel.appendChild(valueInput);

    const deleteBtn = document.createElement('button');
    deleteBtn.className = 'btn btn-xs btn-ghost text-error';
    deleteBtn.textContent = '×';
    deleteBtn.addEventListener('click', () => {
      container.remove();
      if (onChange) onChange();
    });

    container.appendChild(keyLabel);
    container.appendChild(valueLabel);
    container.appendChild(deleteBtn);

    return container;
  }

  function addQueryParam(onChange?: () => void) {
    if (hasEmptyQueryParamAtEnd()) return;
    const row = createQueryParamRow('', '', onChange);
    queryParamsBody.appendChild(row);
  }

  function buildFullURL(setFullURL?: TSetValue) {
    const protocol = protocolEl.value;
    const hostname = hostnameEl.value;
    const port = portEl.value;
    const pathname = pathnameEl.value;
    const hash = hashEl.value;
    let url = `${protocol}://${hostname}`;
    if (port) {
      url += `:${port}`;
    }

    const params = getQueryParamsFromDOM();
    const filteredParams = params.filter((p) => p.key !== '' || p.value !== '');
    let qs = '';
    if (filteredParams.length > 0) {
      const sp = new URLSearchParams();
      filteredParams.forEach((p) => sp.append(p.key, p.value));
      qs = '?' + sp.toString();
    }

    const hashStr = hash ? (hash.startsWith('#') ? hash : `#${hash}`) : '';

    if (useHashParams) {
      url += pathname + hashStr + qs;
    } else {
      url += pathname + qs + hashStr;
    }

    if (setFullURL) setFullURL(url);
  }

  function parseHashQueryParams(hash: string): {
    base: string;
    params: Array<{ key: string; value: string }>;
  } {
    if (!hash) return { base: '', params: [] };
    const h = hash.startsWith('#') ? hash.slice(1) : hash;
    const qIndex = h.indexOf('?');
    if (qIndex === -1) return { base: h, params: [] };
    const base = h.slice(0, qIndex);
    const searchParams = new URLSearchParams(h.slice(qIndex + 1));
    return {
      base,
      params: Array.from(searchParams.entries()).map(([key, value]) => ({ key, value })),
    };
  }

  function fillOption2(
    url: string,
    setProtocol: TSetValue | TSetDefault,
    setHostname: TSetValue | TSetDefault,
    setPort: TSetValue | TSetDefault,
    setPathname: TSetValue | TSetDefault,
    setHash: TSetValue | TSetDefault,
    setFullURL?: TSetValue,
  ) {
    try {
      const urlObj = new URL(url);
      setProtocol(urlObj.protocol.replace(':', ''));
      setHostname(urlObj.hostname);
      setPort(urlObj.port);
      setPathname(urlObj.pathname);

      queryParamsBody.innerHTML = '';

      const hashInfo = parseHashQueryParams(urlObj.hash);
      const hasHashParams = hashInfo.params.length > 0;
      const hasSearchParams = urlObj.searchParams.toString() !== '';

      if (hasHashParams) {
        useHashParams = true;
        setHash(hashInfo.base);
        hashInfo.params.forEach(({ key, value }) => {
          const row = createQueryParamRow(key, value, () => buildFullURL(setFullURL));
          queryParamsBody.appendChild(row);
        });
      } else if (hasSearchParams) {
        useHashParams = false;
        setHash(urlObj.hash.replace('#', ''));
        urlObj.searchParams.forEach((value, key) => {
          const row = createQueryParamRow(key, value, () => buildFullURL(setFullURL));
          queryParamsBody.appendChild(row);
        });
      } else {
        useHashParams = !!urlObj.hash;
        setHash(urlObj.hash.replace('#', ''));
        const row = createQueryParamRow('', '', () => buildFullURL(setFullURL));
        queryParamsBody.appendChild(row);
      }
    } catch (error) {
      return;
    }
  }

  function fillOption1(setFullURL: TSetValue) {
    buildFullURL(setFullURL);
  }

  async function setup() {
    // Fetch tabs
    const tabsEntitites = (await abEntities.fetch(winId, 'tabs')) as ITabEntity[];

    // Find selected tab
    const selectedTab = tabId
      ? tabsEntitites.find((d: ITabEntity) => d.id === tabId)!
      : tabsEntitites.find((d) => d.selected)!;

    // Button handlers
    btnCancel.addEventListener('click', () => {
      abModal.close(winId);
    });

    btnAccept.addEventListener('click', () => {
      abCommands.perform(winId, 'edit-url', {
        tabId: parseInt(selectedTab.id, 10),
        url: fullURLEl.value,
      });
    });

    // -----------------------------------------------------------------
    // OPTION 1
    const { setDefaultValue: setDefaultFullURL, setValue: setFullURL } = inputManager(
      'input-full-url',
      {
        onAccept: (newValue: string) => {
          abCommands.perform(winId, 'edit-url', {
            tabId: parseInt(selectedTab.id, 10),
            url: newValue,
          });
        },
        onCancel: () => abModal.close(winId),
        onChange: (newValue: string) => {
          fillOption2(
            newValue,
            setProtocol,
            setHostname,
            setPort,
            setPathname,
            setHash,
            setFullURL,
          );
        },
      },
    );

    setDefaultFullURL(selectedTab.url || '', { select: true });

    // Add Query Param button listener
    btnAddQueryParam.addEventListener('click', () => {
      addQueryParam(() => buildFullURL(setFullURL));
    });

    // -----------------------------------------------------------------
    // OPTION 2
    // -----------------------------------------------------------------
    // Protocol
    const { setDefaultValue: setDefaultProtocol, setValue: setProtocol } = inputManager(
      'input-protocol',
      {
        onAccept: () => {
          abCommands.perform(winId, 'edit-url', {
            tabId: parseInt(selectedTab.id, 10),
            url: fullURLEl.value,
          });
        },
        onCancel: () => abModal.close(winId),
        onChange: () => fillOption1(setFullURL),
      },
    );

    // -----------------------------------------------------------------
    // Hostname
    const { setDefaultValue: setDefaultHostname, setValue: setHostname } = inputManager(
      'input-hostname',
      {
        onAccept: () => {
          abCommands.perform(winId, 'edit-url', {
            tabId: parseInt(selectedTab.id, 10),
            url: fullURLEl.value,
          });
        },
        onCancel: () => abModal.close(winId),
        onChange: () => fillOption1(setFullURL),
      },
    );

    // -----------------------------------------------------------------
    // Port
    const { setDefaultValue: setDefaultPort, setValue: setPort } = inputManager('input-port', {
      onAccept: () => {
        abCommands.perform(winId, 'edit-url', {
          tabId: parseInt(selectedTab.id, 10),
          url: fullURLEl.value,
        });
      },
      onCancel: () => abModal.close(winId),
      onChange: () => fillOption1(setFullURL),
      allowEmpty: true,
    });

    // -----------------------------------------------------------------
    // Pathname
    const { setDefaultValue: setDefaultPathname, setValue: setPathname } = inputManager(
      'input-pathname',
      {
        onAccept: () => {
          abCommands.perform(winId, 'edit-url', {
            tabId: parseInt(selectedTab.id, 10),
            url: fullURLEl.value,
          });
        },
        onCancel: () => abModal.close(winId),
        onChange: () => fillOption1(setFullURL),
        allowEmpty: true,
      },
    );

    // -----------------------------------------------------------------
    // Hash
    const { setDefaultValue: setDefaultHash, setValue: setHash } = inputManager('input-hash', {
      onAccept: () => {
        abCommands.perform(winId, 'edit-url', {
          tabId: parseInt(selectedTab.id, 10),
          url: fullURLEl.value,
        });
      },
      onCancel: () => abModal.close(winId),
      onChange: () => fillOption1(setFullURL),
      allowEmpty: true,
    });

    fillOption2(
      selectedTab.url || '',
      setDefaultProtocol,
      setDefaultHostname,
      setDefaultPort,
      setDefaultPathname,
      setDefaultHash,
      setFullURL,
    );
  }

  setup();
</script>
