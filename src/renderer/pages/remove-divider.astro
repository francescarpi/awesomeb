---
import BlackBgWithTitle from '../layouts/BlackBgWithTitle.astro';
import ListWithSearch from '../components/common/ListWithSearch.astro';
---

<BlackBgWithTitle title="Remove Tab Container Divider">
  <ListWithSearch placeholder="Filter and select a tab container..." id="list" />
</BlackBgWithTitle>

<script>
  import { getSearchParams } from '../scripts/url';
  import { listWithSearchManager } from '../scripts/list-with-search';

  const { winId } = getSearchParams();

  listWithSearchManager('list', {
    entity: 'tabContainers',
    onAccept: (item) => {
      abCommands.perform(winId, 'remove-divider', { tabContainerId: parseInt(item.id, 10) });
    },
    onEscape: () => {
      abModal.close(winId);
    },
  });
</script>
