{
  "name": "AwesomeB",
  "version": "0.0.1-alpha",
  "description": "",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "pnpm astro dev",
    "build": "astro build && electron-builder",
    "build:mac": "astro build && electron-builder --mac",
    "build:win": "astro build && electron-builder --win",
    "build:linux": "astro build && electron-builder --linux",
    "start": "electron .",
    "format": "prettier --write src",
    "test": "vitest",
    "lint": "eslint .",
    "tscheck:node": "tsc --noEmit --project tsconfig.node.json --composite false",
    "tscheck:renderer": "tsc --noEmit --project tsconfig.renderer.json --composite false",
    "tscheck": "npm run tscheck:node && npm run tscheck:renderer",
    "husky:install": "husky"
  },
  "lint-staged": {
    "!(*lock*).{ts,astro,js}": [
      "pnpm astro check",
      "bash -c 'pnpm tscheck'",
      "bash -c 'pnpm test run'",
      "pnpm lint"
    ],
    "!(*lock*).{ts,js,json,css,md,astro}": [
      "pnpm exec prettier --write src"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.0",
    "@types/chrome": "0.1.42",
    "@types/mime-types": "3.0.1",
    "astro": "5.18.2",
    "astro-icon": "1.1.5",
    "concurrently": "10.0.3",
    "daisyui": "5.5.20",
    "electron": "42.3.3",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "eslint": "10.4.1",
    "eslint-plugin-astro": "1.7.0",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.7",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.3.0",
    "tsc-alias": "1.8.17",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vite": "8.0.16",
    "vite-plugin-static-copy": "4.1.0",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "@electron-webauthn/macos": "1.3.1",
    "@thednp/color-picker": "2.0.4",
    "astro-electron": "0.5.0",
    "dayjs": "1.11.21",
    "electron-context-menu": "4.1.2",
    "electron-dl": "4.0.0",
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
    "electron-webauthn": "1.3.1",
    "mime-types": "3.0.2",
    "sharp": "0.34.5",
    "slugify": "1.6.9",
    "tldts": "7.4.2",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
