---
import Modal from '#/layouts/Modal.astro';
---

<Modal>
  <div id="container"></div>
</Modal>

<script>
  import { Renderer, h, c, getSearchParams } from '#/scripts';

  const { searchParams, winId } = getSearchParams();

  const message = searchParams.get('message')!;
  const url = new URL(searchParams.get('url')!);
  const defaultValue = searchParams.get('defaultValue');

  new Renderer(
    h(
      'div',
      { classs: c('flex', 'flex-col', 'gap-3') },
      h('h1', { class: c('text-lg') }, `${url.hostname} says`),
      h(
        'fieldset',
        { class: c('fieldset', 'mb-6') },
        h('legend', { class: c('fieldset-legend', 'text-white') }, message),
        h(
          'input',
          {
            type: 'text',
            class: c('input', 'input-sm', 'text-black', 'w-full'),
            value: defaultValue,
            id: 'prompt-input',
          },
          '',
        ),
      ),
      h(
        'div',
        { class: c('flex', 'justify-center', 'gap-3') },
        h(
          'button',
          {
            class: c('btn', 'btn-sm', 'flex-1'),
            onclick: () => abPrompts.response(winId, null),
          },
          'Cancel',
        ),
        h(
          'button',
          {
            class: c('btn', 'btn-primary', 'btn-sm', 'flex-1'),
            onclick: () =>
              abPrompts.response(
                winId,
                (document.getElementById('prompt-input') as HTMLInputElement).value,
              ),
          },
          'OK',
        ),
      ),
    ),
    'container',
  ).render();
</script>
