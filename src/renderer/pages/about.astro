---
import Modal from '#/layouts/Modal.astro';
import logo from '../assets/icon.png';
---

<Modal width="400px" height="320px">
  <div class="flex flex-col items-center justify-center h-full gap-4 text-center">
    <img src={logo.src} alt="AwesomeB" width="64" height="64" class="mt-2" />
    <b>AwesomeB(rowser)</b>
    <p class="text-sm" id="developedBy"></p>
    <div id="content" class="h-38"></div>
  </div>
</Modal>

<script>
  import { getSearchParams, Renderer, h, c, confirmButtons } from '#/scripts';
  import Copy from '#/icons/copy.svg?raw';

  const { winId } = getSearchParams();
  const renderer = new Renderer(h('div', null)).render('content');
  const data = await abBrowser.about(winId);

  const t = await abI18n.t({ winId }, [
    {
      key: 'pages:about.developedBy',
      params: {
        name: 'Francesc Arpi Roca',
        email: 'francesc.arpi@gmail.com',
      },
    },
    {
      key: 'pages:about.version',
      params: {
        version: data.version,
      },
    },
  ]);

  const developedBy = document.getElementById('developedBy') as HTMLParagraphElement;
  developedBy.innerHTML = t['pages:about.developedBy'];

  const [btns, registerBtnsEvents] = await confirmButtons({
    winId,
    onConfirm: () => {
      abModal.close(winId);
    },
  });

  renderer.update(
    h(
      'div',
      { class: c('flex', 'flex-col', 'gap-4') },
      h(
        'div',
        { class: c('flex', 'items-center', 'gap-2') },
        h('p', { class: c('text-xs') }, t['pages:about.version']),
        h('div', {
          class: c(
            'w-3.5',
            'h-3.5',
            '[&>svg]:w-full',
            '[&>svg]:h-full',
            'cursor-pointer',
            'hover:text-blue-700',
          ),
          innerHTML: Copy,
          onclick: () => {
            abCommands.perform(winId, 'copy-version');
          },
        }),
      ),
      h(
        'a',
        {
          class: c('text-xs', 'text-blue-700'),
          href: '#',
          onclick: () => {
            abCommands.perform(winId, 'new-tab', {
              query: 'https://awesomeb.app',
            });
          },
        },
        'https://awesomeb.app',
      ),
      ...btns,
    ),
    { onUpdated: registerBtnsEvents },
  );
</script>
