---
import Layout from '../layouts/Base.astro';
import { Button } from 'accessible-astro-components';
import { Icon } from 'astro-icon/components';
---

<Layout backgroundColor="orange" borderRadius="10px">
  <div>
    <Button type="primary">
      <Icon name="close" size="1rem" />
      Close
    </Button>
  </div>
</Layout>

<style>
  div {
    app-region: no-drag;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
  }
</style>

<script>
  const btn = document.querySelector('button');
  if (btn) {
    btn.addEventListener('click', () => {
      const winId = new URLSearchParams(window.location.search).get('winId');
      if (winId) {
        awesome.closeModal(parseInt(winId, 10));
      }
    });
  }
</script>
