---
import { Icon } from 'astro-icon/components';
import ButtonIcon from '../common/ButtonIcon.astro';
---

<ul id="tabContainers" style="app-region: no-drag;" class="flex flex-col gap-1.5"></ul>

<template id="tab-container-template">
  <li class="flex items-center gap-1">
    <small class="text-xs pl-1 text-white/20 hidden sidebar:block"></small>
    <ul class="w-full"></ul>
  </li>
</template>

<template id="tab-template">
  <li
    class="cursor-pointer hover:bg-white/10 gap-1 items-center rounded-tl-full rounded-bl-full grid grid-cols-[24px_auto_25px] group select-none"
  >
    <div class="justify-center items-center ml-2 hidden sidebar:flex">
      <span class="loading loading-spinner loading-xs hidden"></span>
      <Icon name="image" id="favicon" />
    </div>
    <span class="overflow-hidden text-ellipsis text-sm text-nowrap py-2"></span>
    <div class="hidden sidebar:flex justify-end mr-1">
      <span class="w-1 h-5 partition group-hover:hidden"></span>
      <ButtonIcon
        icon="minus"
        className="suspend hidden group-hover:block group-[.suspended]:hidden"
      />
      <ButtonIcon icon="close" className="close hidden group-hover:block group-[.active]:hidden" />
    </div>
  </li>
</template>

<script>
  import { ITabContainer } from '~/types';
  import { getSearchParams } from '../../scripts/url';

  const { winId } = getSearchParams();
  const tplTabContainers = document.getElementById('tab-container-template') as HTMLTemplateElement;
  const tplTab = document.getElementById('tab-template') as HTMLTemplateElement;

  async function fetchTabContainers() {
    const tabContainers = await abTabs.getTabContainers(winId);
    refreshTabContainers(tabContainers);
  }

  fetchTabContainers();

  abTabs.onRefreshTabContainers((_event, tabContainers) => {
    refreshTabContainers(tabContainers);
  });

  abTabs.onRefreshOne((_event, tab) => {
    const tabLi = document.querySelector(`li[data-tab-id="${tab.id}"]`) as HTMLLIElement;
    if (tabLi) {
      const loading = tabLi.querySelector('span:nth-child(1)') as HTMLSpanElement;
      const tabTitle = tabLi.querySelector('span:nth-child(2)') as HTMLSpanElement;
      const favicon = tabLi.querySelector('#favicon') as HTMLElement;

      tabTitle.textContent = tab.title;

      if (tab.loading) {
        loading.classList.remove('hidden');
        favicon.classList.add('hidden');
      } else {
        loading.classList.add('hidden');
        favicon.classList.remove('hidden');
      }
    }
  });

  //----------------------------------------------------------------
  function refreshTabContainers(tabContainers: ITabContainer[]) {
    // Clear existing tab containers
    const tabContainersList = document.getElementById('tabContainers') as HTMLUListElement;
    tabContainersList.innerHTML = '';

    for (const [idx, tabContainer] of tabContainers.entries()) {
      const tabContainerClone = tplTabContainers.content.cloneNode(true) as DocumentFragment;

      const tabContainerLi = tabContainerClone
        .querySelector('li')!
        .cloneNode(true) as HTMLLIElement;

      const tabContainerNumber = tabContainerLi.querySelector('small') as HTMLDivElement;

      if (idx <= 8) {
        tabContainerNumber.textContent = `${idx + 1}`;
      } else {
        tabContainerNumber.textContent = '';
      }

      tabContainerLi.dataset.containerId = tabContainer.id.toString();

      // if (tabContainer.selected) {
      //   tabContainerLi.classList.add('bg-white');
      // }

      const tabsListElement = tabContainerLi.querySelector('ul') as HTMLUListElement;

      for (const tab of tabContainer.tabs) {
        const tabClone = tplTab.content.cloneNode(true) as DocumentFragment;

        const tabLi = tabClone.querySelector('li')!.cloneNode(true) as HTMLLIElement;
        const tabTitle = tabLi.querySelector('span:nth-child(2)') as HTMLSpanElement;
        const tabProfile = tabLi.querySelector('span.partition') as HTMLSpanElement;
        const btnSuspend = tabLi.querySelector('svg.suspend') as HTMLSpanElement;
        const btnClose = tabLi.querySelector('svg.close') as HTMLSpanElement;
        const favicon = tabLi.querySelector('#favicon') as HTMLElement;

        tabLi.dataset.tabId = tab.id.toString();
        tabTitle.textContent = tab.title;
        tabProfile.style.backgroundColor = tab.partition.color;

        if (tab.selected) {
          tabLi.classList.add('bg-white/20');
        }

        if (tab.suspended) {
          tabLi.classList.add('opacity-50');
          tabLi.classList.add('suspended');
        } else {
          tabLi.classList.add('active');
        }

        tabTitle.onclick = () => {
          abCommands.perform(winId, 'select-tab', { tabId: tab.id });
        };

        favicon.onclick = () => {
          abCommands.perform(winId, 'select-tab', { tabId: tab.id });
        };

        tabTitle.oncontextmenu = () => {
          abMenu.contextMenu(winId, 'tab', { tabId: tab.id });
        };

        favicon.oncontextmenu = () => {
          abMenu.contextMenu(winId, 'tab', { tabId: tab.id });
        };

        btnSuspend.onclick = (e) => {
          e.stopPropagation();
          abCommands.perform(winId, 'suspend-tab', { tabId: tab.id });
        };

        btnClose.onclick = (e) => {
          e.stopPropagation();
          abCommands.perform(winId, 'close-tab', { tabId: tab.id });
        };

        tabsListElement.appendChild(tabLi);
      }

      const tabContainersList = document.getElementById('tabContainers') as HTMLUListElement;
      tabContainersList.appendChild(tabContainerLi);
    }
  }
</script>
