<div id="extensions" class="flex gap-2 mr-8 ml-6 min-w-6"></div>

<script>
  import { IExtension } from '~/types';
  import { getSearchParams } from '#/scripts';

  const { winId } = getSearchParams();

  abExtensions.onRefresh((_event, extensions) => {
    renderExtensions(extensions);
  });

  function renderExtensions(extension: IExtension[]) {
    const container = document.getElementById('extensions')!;
    container.innerHTML = '';

    for (const ext of extension) {
      if (!ext.icon) continue;

      const icon = document.createElement('img');
      icon.src = ext.icon;
      icon.classList.add(
        'w-5',
        'h-5',
        'rounded',
        'object-cover',
        'cursor-pointer',
        'hover:bg-white/15',
        'p-0.5',
      );
      icon.style = 'app-region: no-drag;';
      icon.onclick = () => {
        abExtensions.openPopup(winId, ext.id);
      };

      container.appendChild(icon);
    }
  }
</script>
