---

<ul id="tabContainers" style="app-region: no-drag;"></ul>

<template id="tab-container-template">
  <li class="">
    <ul></ul>
  </li>
</template>

<template id="tab-template">
  <li class="p-2 cursor-pointer hover:bg-white/10 overflow-hidden text-ellipsis text-sm"></li>
</template>

<script>
  import { ITabContainer } from '~/types';
  import { getSearchParams } from '../../scripts/url';

  const { winId } = getSearchParams();
  const tplTabContainers = document.getElementById('tab-container-template') as HTMLTemplateElement;
  const tplTab = document.getElementById('tab-template') as HTMLTemplateElement;

  async function fetchTabContainers() {
    const tabContainers = await abTabs.getTabContainers(winId);
    refreshTabContainers(tabContainers);
  }

  fetchTabContainers();

  abTabs.onRefresh((_event, tabContainers) => {
    refreshTabContainers(tabContainers);
  });

  //----------------------------------------------------------------
  function refreshTabContainers(tabContainers: ITabContainer[]) {
    // Clear existing tab containers
    const tabContainersList = document.getElementById('tabContainers') as HTMLUListElement;
    tabContainersList.innerHTML = '';

    for (const tabContainer of tabContainers) {
      const tabContainerClone = tplTabContainers.content.cloneNode(true) as DocumentFragment;

      const tabContainerLi = tabContainerClone
        .querySelector('li')!
        .cloneNode(true) as HTMLLIElement;

      tabContainerLi.dataset.containerId = tabContainer.id.toString();

      // if (tabContainer.selected) {
      //   tabContainerLi.classList.add('bg-white');
      // }

      const tabsListElement = tabContainerLi.querySelector('ul') as HTMLUListElement;

      for (const tab of tabContainer.tabs) {
        const tabClone = tplTab.content.cloneNode(true) as DocumentFragment;

        const tabLi = tabClone.querySelector('li')!.cloneNode(true) as HTMLLIElement;
        tabLi.textContent = tab.title;
        tabLi.dataset.tabId = tab.id.toString();

        if (tab.selected) {
          tabLi.classList.add('bg-white/20');
        }

        if (tab.suspended) {
          tabLi.classList.add('opacity-50');
        }

        tabLi.onclick = () => {
          abTabs.selectTab(winId, tab.id);
        };

        tabsListElement.appendChild(tabLi);
      }

      const tabContainersList = document.getElementById('tabContainers') as HTMLUListElement;
      tabContainersList.appendChild(tabContainerLi);
    }
  }
</script>
