---
import Modal from '#/layouts/Modal.astro';
---

<Modal>
  <div id="container"></div>
</Modal>

<script>
  import { Renderer, h, c, getSearchParams } from '#/scripts';

  const { searchParams, winId } = getSearchParams();

  const message = searchParams.get('message')!;
  const url = new URL(searchParams.get('url')!);

  new Renderer(
    h(
      'div',
      { classs: c('flex', 'flex-col', 'gap-3') },
      h('h1', { class: c('text-lg') }, `${url.hostname} says`),
      h('p', { class: c('text-md', 'my-6') }, message),
      h(
        'div',
        { class: c('flex', 'justify-center', 'gap-3') },
        h(
          'button',
          {
            class: c('btn', 'btn-sm', 'flex-1'),
            onclick: () => abPrompts.response(winId, false),
          },
          'Cancel',
        ),
        h(
          'button',
          {
            class: c('btn', 'btn-primary', 'btn-sm', 'flex-1'),
            onclick: () => abPrompts.response(winId, true),
          },
          'OK',
        ),
      ),
    ),
  ).render('container', {
    onRendered: () => {
      document.addEventListener('keydown', (e) => {
        const ev = e as KeyboardEvent;
        if (ev.key === 'Enter') {
          abPrompts.response(winId, true);
        } else if (ev.key === 'Escape') {
          abPrompts.response(winId, false);
        }
      });
    },
  });
</script>
