---
import Layout from '#/layouts/Base.astro';
import UrlBarContainer from '#/components/window/UrlBarContainer.astro';
import TabContainer from '#/components/window/TabContainer.astro';
import SidebarContainer from '#/components/window/SidebarContainer.astro';
---

<Layout>
  <div id="main-container" class="fixed inset-0 flex gap-1 p-1">
    <SidebarContainer />
    <div id="url-and-tab-container" class="w-full flex flex-col gap-1">
      <UrlBarContainer />
      <TabContainer />
    </div>
  </div>
</Layout>

<script>
  import { getSearchParams, Renderer, h } from '#/scripts';
  import {
    applyTheme,
    renderShortcuts,
    renderNavUrl,
    renderExtensions,
    renderMenuButton,
    updateLayout,
    renderWindowButtons,
    renderActions,
    renderDesktops,
    renderTabContainers,
    updateSelectedDesktopClass,
    updateTabInContainers,
    renderMediaSession,
  } from '#/scripts/window';
  import type { IURLTabData, ILayoutData } from '~/types';

  const { winId } = getSearchParams();

  const shortcutsRenderer = new Renderer(h('div', {})).render('tab-container');
  const urlNavUrlRenderer = new Renderer(h('div', {})).render('url-nav-url-container');
  const extensionsRenderer = new Renderer(h('div', {})).render('url-extensions-container');
  const menuBtnRenderer = new Renderer(h('div', {})).render('url-menu-btn-container');
  const windowBtnsRenderer = new Renderer(h('div', {})).render('sidebar-window-btns');
  const actionsRenderer = new Renderer(h('div', {})).render('sidebar-actions');
  const desktopsRenderer = new Renderer(h('div', {})).render('sidebar-desktops');
  const tabContainersRenderer = new Renderer(h('div', {})).render('sidebar-tabs');
  const mediaSessionRenderer = new Renderer(h('div', {})).render('sidebar-media');

  abDesktops.getTheme(winId).then((theme) => {
    applyTheme(theme);
    abWindow.readyToShow(winId);
  });

  abDesktops.onThemeRefresh((_e, theme) => applyTheme(theme));

  renderShortcuts(winId, shortcutsRenderer);
  abShortcuts.onChange(() => renderShortcuts(winId, shortcutsRenderer));

  renderNavUrl(winId, urlNavUrlRenderer);
  abUrlBar.onRefresh((_event, data: IURLTabData) => renderNavUrl(winId, urlNavUrlRenderer, data));

  renderExtensions(winId, extensionsRenderer);
  abExtensions.onRefresh((_event, extensions) =>
    renderExtensions(winId, extensionsRenderer, extensions),
  );

  renderMenuButton(winId, menuBtnRenderer);
  renderWindowButtons(winId, windowBtnsRenderer);
  renderActions(winId, actionsRenderer);

  const desktops = await abDesktops.all(winId);
  renderDesktops(desktopsRenderer, desktops);
  abDesktops.onRefresh((_event, desktops) => renderDesktops(desktopsRenderer, desktops));

  abWindow.onRefreshLayoutData((_e, data: ILayoutData) => updateLayout(data));

  const selectedDesktopId = desktops.find((d) => d.selected)!.id;
  updateSelectedDesktopClass(selectedDesktopId);
  abDesktops.onRefreshSelected((_event, selectedDesktopId) => {
    updateSelectedDesktopClass(selectedDesktopId);
  });

  let currentTabContainers = await abTabs.getTabContainers(winId);
  renderTabContainers(winId, tabContainersRenderer, currentTabContainers);

  abTabs.onRefreshOne((_event, tab) => {
    const updated = updateTabInContainers(currentTabContainers, tab);
    if (!updated) {
      return;
    }
    currentTabContainers = updated;
    renderTabContainers(winId, tabContainersRenderer, currentTabContainers);
  });

  abTabs.onRefreshTabContainers((_event, tabContainers) => {
    currentTabContainers = tabContainers;
    renderTabContainers(winId, tabContainersRenderer, currentTabContainers);
  });

  const mediaData = await abMedia.get(winId);
  renderMediaSession(winId, mediaSessionRenderer, mediaData);
  abMedia.onRefresh((_event, data) => renderMediaSession(winId, mediaSessionRenderer, data));
</script>
