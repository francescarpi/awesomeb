---
import ButtonIcon from '../common/ButtonIcon.astro';
---

<ButtonIcon icon="downloads" />

<script>
  import { getSearchParams } from '../../scripts/url';
  import { onClick } from '../../scripts/buttons';

  const { winId } = getSearchParams();
  const downloads = document.getElementById('downloads')!;

  abDownloads.onRefresh((_event, data) => {
    if (data.downloading) {
      downloads.classList.add('animate-pulse', 'text-red-500');
    } else {
      downloads.classList.remove('animate-pulse', 'text-red-500');
    }
  });

  onClick('downloads', () => abDownloads.openPage(winId));
</script>
