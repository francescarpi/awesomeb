---
import Base from '#/layouts/Base.astro';
---

<Base>
  <div class="fixed inset-0 flex flex-col justify-end mr-1 mb-1">
    <div
      class="text-xs bg-base-200 text-base-content border border-base-content p-4 rounded-br-xl rounded-tl-xl"
      id="short-version"
    >
      <span id="short-version-listening"></span>
      <b class="text-primary"><span id="short-version-hold"></span></b>
      <span id="short-version-suffix"></span>
    </div>
    <div
      class="text-xs bg-base-200 text-base-content border border-base-content p-4 rounded-br-xl rounded-tl-xl hidden flex-col gap-4"
      id="full-version"
    >
      <p class="text-lg" id="full-version-title"></p>

      <p id="no-marks"><span id="no-marks-text"></span></p>
      <div id="marks-container"></div>

      <div class="grid grid-cols-[50px_auto] border-t border-t-primary pt-2 mt-2">
        <span class="text-primary">m</span>
        <p id="help-mark"></p>
        <span class="text-primary">n</span>
        <p id="help-delete-one"></p>
        <span class="text-primary">b</span>
        <p id="help-delete-all"></p>
        <span class="text-primary">&lt;letter&gt;</span>
        <p id="help-select"></p>
      </div>
    </div>
  </div>
</Base>

<script>
  import { getSearchParams } from '#/scripts';
  import { ITabMark } from '~/types';
  import { initI18n, t, setText } from '#/scripts/i18n';

  await initI18n();

  function apply() {
    setText('short-version-listening', 'pages.tabMarks.listening');
    setText('short-version-hold', 'pages.tabMarks.listeningHold');
    setText('short-version-suffix', 'pages.tabMarks.listeningSuffix');
    setText('full-version-title', 'pages.tabMarks.availableMarks');
    setText('no-marks-text', 'pages.tabMarks.noMarks');
    setText('help-mark', 'pages.tabMarks.helpMark');
    setText('help-delete-one', 'pages.tabMarks.helpDeleteOne');
    setText('help-delete-all', 'pages.tabMarks.helpDeleteAll');
    setText('help-select', 'pages.tabMarks.helpSelect');
  }
  apply();

  const { winId } = getSearchParams();
  const shortVersion = document.getElementById('short-version')!;
  const fullVersion = document.getElementById('full-version')!;
  const noMarks = document.getElementById('no-marks')!;
  const marksContainer = document.getElementById('marks-container')!;

  let markMode = false;
  let marks: ITabMark[] = [];
  let fullVersionTimeout: NodeJS.Timeout;

  abTabMarks.onChangeVisibility((_event, visible) => {
    if (visible) {
      registerTimeout();
    } else {
      showShortVersion();
    }
  });

  async function loadTabMarks() {
    marks = await abTabMarks.get(winId);
    updateMarks();
  }

  loadTabMarks();

  function handleKeyUp(event: KeyboardEvent) {
    if (event.key === 'Meta') {
      event.preventDefault();
      abTabMarks.close(winId);
    }
  }

  async function handleKeyDown(event: KeyboardEvent) {
    event.preventDefault();
    event.stopPropagation();

    if (event.key === 'b') {
      marks = await abTabMarks.perform(winId, { id: 'deleteAll' });
      updateMarks();
      return;
    }

    if (event.key === 'n') {
      marks = await abTabMarks.perform(winId, { id: 'deleteOne' });
      updateMarks();
      return;
    }

    if (event.key === 'm' && !markMode) {
      markMode = true;
      return;
    }

    if (markMode) {
      markMode = false;
      marks = await abTabMarks.perform(winId, { id: 'add', trigger: event.key });
      updateMarks();
      return;
    }

    const mark = marks.find((m) => m.trigger.toLowerCase() === event.key.toLowerCase());
    if (mark) {
      abTabMarks.perform(winId, { id: 'select', trigger: mark.trigger });
    }
  }

  window.addEventListener('keyup', handleKeyUp);
  window.addEventListener('keydown', handleKeyDown);

  function updateMarks() {
    if (marks.length === 0) {
      noMarks.classList.remove('hidden');
      marksContainer.classList.add('hidden');
      return;
    }

    marksContainer.innerHTML = '';
    noMarks.classList.add('hidden');
    marksContainer.classList.remove('hidden');

    for (const mark of marks) {
      const markElement = document.createElement('div');
      markElement.className = 'flex items-center gap-2';
      markElement.innerHTML = `
        <span class="text-primary">${mark.trigger}</span>
        <p>${mark.title}</p>
      `;
      marksContainer.appendChild(markElement);
    }
  }

  function showFullVersion() {
    shortVersion.classList.add('hidden');
    fullVersion.classList.remove('hidden');
    fullVersion.classList.add('flex');
  }

  function showShortVersion() {
    shortVersion.classList.remove('hidden');
    fullVersion.classList.add('hidden');
    fullVersion.classList.remove('flex');

    if (fullVersionTimeout) {
      clearTimeout(fullVersionTimeout);
    }
  }

  function registerTimeout() {
    clearTimeout(fullVersionTimeout);
    fullVersionTimeout = setTimeout(() => {
      showFullVersion();
    }, 1500);
  }
</script>
