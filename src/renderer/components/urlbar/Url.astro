// TODO It should be an input with preprend
---

<div
  class="border border-white/50 w-full h-screen rounded-lg flex gap-2 pl-2 items-center"
  id="url"
>
  <span class="loading loading-spinner loading-xs hidden"></span>
  <input class="outline-0 w-full h-full rounded-lg text-sm" readonly />
</div>

<script>
  const url = document.getElementById('url')!;
  const loading = url.querySelector('span')!;
  const input = url.querySelector('input')!;

  abUrlBar.onRefresh((_event, data) => {
    if (data.loading) {
      loading.classList.remove('hidden');
    } else {
      loading.classList.add('hidden');
    }
    input.value = data.url;
  });
</script>
