<script>
  import { getSearchParams, type VNode, h, Renderer } from '#/scripts';
  import type { ITheme } from '~/types';

  const { winId } = getSearchParams();

  const t = await abI18n.t({ winId }, [
    { key: 'pages:window.newTabSuffix' },
    { key: 'pages:window.commandsSuffix' },
    { key: 'pages:window.title' },
  ]);

  document.title = t['pages:window.title'];

  const renderer = new Renderer(h('div', {})).render('window-container');
  const state: { theme: ITheme; areaMaximized: boolean; sidebarCollapsed: boolean } = {
    theme: { primary: '#2b7fff', secondary: '#1c398e', degrees: 238 },
    areaMaximized: false,
    sidebarCollapsed: false,
  };

  abDesktops.getTheme(winId).then((theme) => {
    state.theme = theme;
    renderer.update(renderContent());
    abWindow.readyToShow(winId);
  });

  abDesktops.onThemeRefresh((_e, theme) => {
    state.theme = theme;
    renderer.update(renderContent());
  });

  function renderContent(): VNode {
    const left = state.areaMaximized ? 5 : state.sidebarCollapsed ? 40 : 254;
    const top = state.areaMaximized ? 5 : state.sidebarCollapsed ? 34 : 34;

    return h(
      'div',
      {
        class: 'fixed inset-0',
        style: `background-image: linear-gradient(${state.theme.degrees}deg, ${state.theme.primary}, ${state.theme.secondary})`,
      },
      h('div', { class: 'border-2 border-dotted absolute rounded-[14px]' }, ''),
      h(
        'div',
        {
          class: `bg-white/20 rounded-xl text-white opacity-50 flex flex-col items-center justify-center absolute right-1 bottom-1 select-none text-right px-3 py-2 text-sm left-[${left}px] top-[${top}px]`,
        },
        '',
      ),
    );
  }

