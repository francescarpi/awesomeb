---
import fs from 'node:fs/promises';
import path from 'node:path';
import { getMenuItems } from '../../scripts/i18n';

const { locale } = Astro.locals.starlightRoute;

const trans: Record<string, Record<string, string>> = {
  titles: {
    root: 'You can access <b>$</b> through:',
    ca: 'Pots accedir a <b>$</b> a través de:',
    es: 'Puedes acceder a <b>$</b> a través de:',
  },
  menu: {
    root: 'Main menu',
    ca: 'Menú principal',
    es: 'Menú principal',
  },
  shortcut: {
    root: 'Shortcut',
    ca: 'Accés directe',
    es: 'Acceso directo',
  },
  command: {
    root: 'Command',
    ca: 'Comanda',
    es: 'Comando',
  },
  contextMenu: {
    root: 'Context menu',
    ca: 'Menú contextual',
    es: 'Menú contextual',
  },
};

interface Props {
  entity: string;
  menu?: string;
  command?: string;
  macOS: string;
  contextMenu?: string;
}

const { entity, menu, command, contextMenu } = Astro.props as Props;

const txtTitle = trans.titles[locale || 'root'] || trans.titles.root;
const txtMenu = trans.menu[locale || 'root'] || trans.menu.groot;
const txtShortcut = trans.shortcut[locale || 'root'] || trans.shortcut.root;
const txtCommand = trans.command[locale || 'root'] || trans.command.root;
const txtContextMenu = trans.contextMenu[locale || 'root'] || trans.contextMenu.root;

const contextMenuItems = await getMenuItems(locale, contextMenu);
const menuItems = await getMenuItems(locale, menu);

let commandName: undefined | string = undefined;
if (command) {
  const p = path.resolve(`../src/shared/i18n/locales/${locale || 'en'}/commands.json`);
  const f = await fs.readFile(p, 'utf-8');
  const d = JSON.parse(f);
  const cmdData = d[command];
  if (cmdData) {
    commandName = cmdData.name;
  }
}
---

<div class="feature-access">
  <div set:html={txtTitle.replace('$', entity)} />
  <ul class="feature-access-list">
    {
      menuItems.length > 0 && (
        <li>
          <b>{txtMenu}</b>: {menuItems.join(' → ')}
        </li>
      )
    }
    {
      commandName && (
        <li>
          <b>{txtCommand}</b>: {commandName}
        </li>
      )
    }
    {
      contextMenuItems.length > 0 && (
        <li>
          <b>{txtContextMenu}</b>: {contextMenuItems[0]}
        </li>
      )
    }
    {
      Astro.props.macOS && (
        <li>
          <b>{txtShortcut}</b>:
          <ul class="feature-access-list">
            <li>
              macOS: <code dir="auto">{Astro.props.macOS}</code>
            </li>
          </ul>
        </li>
      )
    }
  </ul>
</div>

<style>
  .feature-access {
    background-color: var(--sl-color-blue-low);
    padding: 1rem;
  }

  .feature-access-list {
    margin: 0;
  }

  .feature-access-list li {
    margin-top: 0;
  }
</style>
