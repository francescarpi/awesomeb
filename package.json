{
  "name": "AwesomeB.Astro",
  "version": "0.0.1a",
  "description": "",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "pnpm astro dev",
    "build": "astro build && electron-builder",
    "build:mac": "astro build && electron-builder --mac",
    "build:win": "astro build && electron-builder --win",
    "build:linux": "astro build && electron-builder --linux",
    "start": "electron .",
    "format": "prettier --write src",
    "test": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "tscheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "tscheck:renderer": "tsc --noEmit -p tsconfig.renderer.json --composite false",
    "tscheck": "npm run tscheck:node && npm run tscheck:renderer"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.1.18",
    "astro": "5.17.1",
    "astro-icon": "1.1.5",
    "concurrently": "9.2.1",
    "daisyui": "5.5.18",
    "electron": "40.2.1",
    "electron-builder": "26.7.0",
    "eslint": "10.0.0",
    "eslint-js": "github:eslint/js",
    "globals": "17.3.0",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.1.18",
    "tsc-alias": "1.8.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "7.3.1",
    "vite-plugin-electron-renderer": "0.14.6",
    "vite-plugin-static-copy": "3.2.0",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "astro-electron": "0.5.0",
    "electron-log": "5.4.3",
    "electron-store": "11.0.2",
    "slugify": "^1.6.6"
  }
}
