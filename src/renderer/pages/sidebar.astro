---
import Layout from '#/layouts/Base.astro';
import WindowActions from '#/components/sidebar/WindowActions.astro';
import ButtonIcon from '#/components/common/ButtonIcon.astro';
import Desktops from '#/components/sidebar/Desktops.astro';
import TabContainers from '#/components/sidebar/TabContainers.astro';
import Downloads from '#/components/sidebar/Downloads.astro';
import WindowId from '#/components/sidebar/WindowId.astro';
import MediaSession from '#/components/sidebar/MediaSession.astro';
import AppUpdater from '#/components/sidebar/AppUpdater.astro';
---

<Layout borderRadius="10px 0 0 10px">
  <div class="h-full flex flex-col gap-4 pt-0.5 dragable" id="sidebarContainer">
    <section class="pl-2 pt-2 hidden sidebar:block">
      <WindowActions />
    </section>
    <section class="px-2 mt-2 sidebar:mt-0 flex justify-between items-center">
      <div class="flex gap-2">
        <ButtonIcon icon="sidebar" />
        <ButtonIcon icon="add-circle" />
        <ButtonIcon icon="command" />
      </div>
      <AppUpdater />
    </section>
    <section class="py-1 flex justify-center sidebar:block sidebar:px-2">
      <Desktops />
    </section>
    <section class="flex-1 mt-1 overflow-y-auto">
      <TabContainers />
    </section>
    <MediaSession />
    <section
      class="py-2 flex flex-col gap-1 items-center sidebar:flex-row sidebar:justify-between sidebar:px-2"
    >
      <Downloads />
      <WindowId />
    </section>
  </div>
</Layout>

<script>
  import { onClick, getSearchParams } from '#/scripts';

  document.title = 'Sidebar';

  const { winId, searchParams } = getSearchParams();

  const colorPrimary = searchParams.get('colorPrimary');
  const colorSecondary = searchParams.get('colorSecondary');
  const degrees = searchParams.get('degrees');

  if (colorPrimary && colorSecondary && degrees) {
    const sidebar = document.getElementById('sidebarContainer');
    if (sidebar) {
      const backgroundImage = `linear-gradient(${parseInt(degrees, 10)}deg, ${colorPrimary}, ${colorSecondary})`;
      sidebar.style.backgroundImage = backgroundImage;
      sidebar.style.borderRight = `1px solid rgba(255, 255, 255, 0.4)`;
    }
  }

  onClick('sidebar', () => abCommands.perform(winId, 'toggle-sidebar'));

  onClick('add-circle', () => abModal.open(winId, 'new-tab'));

  onClick('command', () => abModal.open(winId, 'perform-command'));

  abSidebar.onChangeDrag((_event, isDragable) => {
    const sidebar = document.getElementById('sidebarContainer')!;
    if (isDragable) {
      sidebar.classList.add('dragable');
    } else {
      sidebar.classList.remove('dragable');
    }
  });
</script>
