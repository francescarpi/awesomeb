---
import Layout from '../layouts/Base.astro';
---

<Layout>
  <div class="border border-white h-full rounded-lg bg-black/80 text-white text-sm p-2 relative">
    <p id="message">No message provided</p>
    <div id="count" class="fixed bottom-2 right-2 text-xs"></div>
    <div id="countdown" class="fixed bottom-2 left-2 text-xs"></div>
  </div>
</Layout>

<style>
  .container {
    app-region: no-drag;
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const DEFAULT_COUNTER = 5;

  let intervalRef: NodeJS.Timeout | null = null;
  let countdown = DEFAULT_COUNTER;

  abNotifications.onRefreshNotifications((_e, winId, notifications) => {
    if (winId.toString() !== params.get('winId')) {
      return;
    }

    const messageEl: HTMLParagraphElement = document.querySelector('#message')!;
    const countEl: HTMLDivElement = document.querySelector('#count')!;
    const countdownEl: HTMLDivElement = document.querySelector('#countdown')!;

    countEl.textContent = notifications.length > 1 ? notifications.length.toString() : '';
    countEl.style.display = notifications.length > 1 ? 'flex' : 'none';

    // No notifications to show, clear everything
    if (notifications.length === 0) {
      if (intervalRef) {
        clearInterval(intervalRef);
      }
      messageEl.textContent = '';
      countdownEl.textContent = '';
      return;
    }

    messageEl.textContent = notifications[0].message;

    countdown = DEFAULT_COUNTER;
    countdownEl.textContent = countdown.toString();

    if (intervalRef) {
      clearInterval(intervalRef);
    }

    intervalRef = setInterval(() => {
      countdown -= 1;

      if (countdown <= 0) {
        clearInterval(intervalRef!);
        abNotifications.nextNotification(winId);
      }
      countdownEl.textContent = countdown.toString();
    }, 1000);
  });
</script>
