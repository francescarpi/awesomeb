---
import ContextualModal from '#/components/common/ContextualModal.astro';
---

<ContextualModal width="w-[600px]" />

<script>
  import { getSearchParams, Renderer, h } from '#/scripts';

  const { winId } = getSearchParams();

  const renderer = new Renderer(h('div', null)).render('content');

  const t = await abI18n.t({ winId }, [
    { key: 'pages:appUpdater.current' },
    { key: 'pages:appUpdater.new' },
    { key: 'pages:appUpdater.failed' },
  ]);

  const data = await abAppUpdater.versionAvailable(winId);
  if (data) {
    const releases = data.releaseNotes ?? [];
    const skippedCount = Math.max(releases.length - 1, 0);

    let skippedLabel: string | null = null;
    if (skippedCount > 0) {
      const skipped = await abI18n.t({ winId }, [
        { key: 'pages:appUpdater.versionsSkipped', params: { count: skippedCount } },
      ]);
      skippedLabel = skipped['pages:appUpdater.versionsSkipped'];
    }

    renderer.update(
      h(
        'div',
        {},
        h(
          'div',
          { class: 'flex items-center justify-between mb-4' },
          h('span', null, t['pages:appUpdater.current'], h('strong', null, ` ${data.current}`)),
          h('span', null, t['pages:appUpdater.new'], h('strong', null, ` ${data.version}`)),
          h(
            'button',
            {
              class: 'btn btn-primary btn-sm',
              onclick: () => {
                abAppUpdater.download(winId);
              },
            },
            'Update now',
          ),
        ),
        skippedLabel ? h('div', { class: 'text-xs opacity-60 -mt-2 mb-3' }, skippedLabel) : null,
        h(
          'div',
          { class: 'h-90 overflow-y-auto' },
          releases.map((release) =>
            h(
              'div',
              { class: 'mb-4' },
              h('h2', { class: 'font-semibold' }, release.version),
              h('div', { innerHTML: release.notes }),
            ),
          ),
        ),
      ),
    );
  } else {
    renderer.update(h('div', null, t['pages:appUpdater.failed']));
  }
</script>

<style is:global>
  h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
</style>
