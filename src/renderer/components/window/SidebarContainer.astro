<div
  id="sidebar-container"
  class="w-62.5 shrink-0 h-full flex flex-col gap-4 group/sidebar"
  style="app-region: drag;"
>
  <div
    id="sidebar-window-btns"
    class="flex gap-1 mt-1 mx-1 group-[.collapsed]/sidebar:hidden"
  ></div>
  <div id="sidebar-actions" class="flex gap-2 mx-2 group-[.collapsed]/sidebar:ml-0"></div>
  <div
    id="sidebar-desktops"
    class="grid group-[.collapsed]/sidebar:grid-cols-1 grid-cols-5 items-center"
  ></div>
  <div
    id="sidebar-tabs"
    class="flex flex-col flex-1 mt-1 overflow-y-auto gap-1.5 select-none group"
  ></div>
  <div id="sidebar-media"></div>
  <div class="flex justify-between mx-1 mb-1">
    <div id="sidebar-downloads"></div>
    <div id="sidebar-win-id"></div>
  </div>
</div>
