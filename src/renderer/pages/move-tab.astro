---
import ListWithSearch from '#/components/common/ListWithSearch.astro';
import Modal from '#/layouts/Modal.astro';
import Title from '#/components/common/Title.astro';
import Pagination from '#/components/common/Pagination.astro';
---

<Modal width="500px" height="600px">
  <Title><span id="title-tab-move">Move Tab</span></Title>
  <div class="h-full">
    <Pagination />
    <ListWithSearch placeholder="Select a tab..." id="tab" />
    <ListWithSearch placeholder="Select a target" id="target" />
  </div>
</Modal>

<script>
  import { paginatorManager, listWithSearchManager, getSearchParams } from '#/scripts';
  import { IEntity, IPartitionEntity } from '~/types';
  import {
    initI18n,
    setText,
    setPlaceholder,
    setListEmptyText,
    onLocaleChange,
  } from '#/scripts/i18n';

  await initI18n();

  function apply() {
    setText('title-tab-move', 'pages.tabMove.title');
    setPlaceholder('tab', 'pages.tabMove.tabPlaceholder');
    setPlaceholder('target', 'pages.tabMove.targetPlaceholder');
    setListEmptyText();
  }
  apply();
  onLocaleChange(apply);

  const { winId } = getSearchParams();

  const { nextPage, previousPage, refreshPageVisibility, refreshPageIndicator } = paginatorManager(
    'pagesIndicator',
    ['tab', 'target'],
  );

  refreshPageVisibility();
  refreshPageIndicator();

  let tab: IEntity | null = null;
  let target: IPartitionEntity | null = null;

  listWithSearchManager('tab', {
    entity: 'tabs',
    onEscape: () => abModal.close(winId),
    onTab: () => nextPage(),
    onShiftTab: () => previousPage(),
    onChange: async (_inputValue, entity) => {
      tab = entity as IEntity;
    },
    onAccept: () => {
      if (target && tab) {
        abCommands.perform(winId, 'move-tab', {
          targetId: target.id,
          tabId: parseInt(tab.id, 10),
        });
      }
    },
  });

  listWithSearchManager('target', {
    entity: 'targets',
    onEscape: () => abModal.close(winId),
    onTab: () => nextPage(),
    onShiftTab: () => previousPage(),
    onChange: async (_inputValue, entity) => {
      target = entity as IPartitionEntity;
    },
    onAccept: () => {
      if (target && tab) {
        abCommands.perform(winId, 'move-tab', {
          targetId: target.id,
          tabId: parseInt(tab.id, 10),
        });
      }
    },
  });
</script>
