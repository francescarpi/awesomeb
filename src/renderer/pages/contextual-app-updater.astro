---
import ContextualModal from '#/components/common/ContextualModal.astro';
---

<ContextualModal width="w-[500px]" />

<script>
  import { getSearchParams, Renderer, c, h } from '#/scripts';

  const { winId } = getSearchParams();

  const renderer = new Renderer(h('div', null)).render('content');

  const data = await abAppUpdater.versionAvailable(winId);
  if (data) {
    renderer.update(
      h(
        'div',
        {},
        h(
          'div',
          { class: c('flex', 'items-center', 'justify-between', 'mb-4') },
          h('span', null, 'Current:', h('strong', null, ` ${data.current}`)),
          h('span', null, 'New:', h('strong', null, ` ${data.version}`)),
          h(
            'button',
            {
              class: c('btn', 'btn-primary', 'btn-sm'),
              onclick: () => {
                abAppUpdater.download(winId);
              },
            },
            'Update now',
          ),
        ),
        h('div', { class: c('h-90', 'overflow-y-auto'), innerHTML: data.releaseNotes }),
      ),
    );
  } else {
    renderer.update(h('div', null, 'Oops... something went wrong :('));
  }
</script>

<style is:global>
  h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
</style>
