---
import Modal from '#/layouts/Modal.astro';
import ListWithSearch from '#/components/common/ListWithSearch.astro';
import Title from '#/components/common/Title.astro';
---

<Modal width="300px" height="500px">
  <Title>Select Desktop</Title>
  <ListWithSearch placeholder="Filter and select desktop..." id="list" oneColumn />
</Modal>

<script>
  import { getSearchParams, listWithSearchManager } from '#/scripts';

  const { winId } = getSearchParams();

  listWithSearchManager('list', {
    entity: 'desktops',
    onAccept: (item) => {
      abCommands.perform(winId, 'select-desktop', { desktopId: parseInt(item.id, 10) });
    },
    onEscape: () => {
      abModal.close(winId);
    },
  });
</script>
