---
import Layout from '../layouts/Base.astro';
import WindowActions from '../components/sidebar/WindowActions.astro';
import ButtonIcon from '../components/common/ButtonIcon.astro';
import Desktops from '../components/sidebar/Desktops.astro';
import TabContainers from '../components/sidebar/TabContainers.astro';
---

<Layout borderRadius="10px 0 0 10px">
  <div class="h-full flex flex-col gap-4 pt-0.5" style="app-region:drag;" id="sidebarContainer">
    <section class="pl-2 pt-2 hidden sidebar:block">
      <WindowActions />
    </section>
    <section class="px-2 mt-2 sidebar:mt-0">
      <ButtonIcon icon="sidebar" />
    </section>
    <section class="py-1 flex justify-center sidebar:block sidebar:px-2">
      <Desktops />
    </section>
    <TabContainers />
  </div>
</Layout>

<script>
  import { onClick } from '../scripts/buttons';

  import { getSearchParams } from '../scripts/url';
  const { winId, searchParams } = getSearchParams();

  const colorPrimary = searchParams.get('colorPrimary');
  const colorSecondary = searchParams.get('colorSecondary');
  const degrees = searchParams.get('degrees');

  if (colorPrimary && colorSecondary && degrees) {
    const sidebar = document.getElementById('sidebarContainer');
    if (sidebar) {
      const backgroundImage = `linear-gradient(${parseInt(degrees, 10)}deg, ${colorPrimary}, ${colorSecondary})`;
      sidebar.style.backgroundImage = backgroundImage;
      sidebar.style.borderRight = `1px solid rgba(255, 255, 255, 0.4)`;
    }
  }

  onClick('sidebar', () => abCommands.perform(winId, 'toggle-sidebar'));
</script>
