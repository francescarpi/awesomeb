<div id="settings-menu"></div>

<script>
  import { Renderer, h, cls, type VNode } from '#/scripts';

  const menuItems = [
    { name: 'General', hash: ['#/', ''] },
    { name: 'Profiles', hash: ['#/profiles'] },
    { name: 'Themes', hash: ['#/themes'] },
    { name: 'Permissions', hash: ['#/permissions'] },
  ];

  const renderer = new Renderer(renderMenu(), 'settings-menu').render();

  function renderMenu(): VNode {
    return h(
      'ul',
      {
        class: cls('menu menu-horizontal bg-white/10 rounded-box w-full'),
      },
      ...menuItems.map((item) =>
        h(
          'li',
          {},
          h(
            'a',
            {
              onclick: () => handleNavItemClick(item.hash[0]),
              class: cls(item.hash.includes(window.location.hash) && 'menu-active'),
            },
            item.name,
          ),
        ),
      ),
    );
  }

  function handleNavItemClick(hash: string) {
    window.history.pushState({}, '', hash);
    renderer.update(renderMenu());
  }

  document.addEventListener('DOMContentLoaded', renderMenu);
</script>
