---
import Layout from '../layouts/Base.astro';
---

<Layout />

<script>
  import { getSearchParams } from '../scripts/url';
  const { winId } = getSearchParams();

  abDesktops.getTheme(winId).then((theme) => {
    const rootContainer = document.querySelector('.rootContainer') as HTMLDivElement;
    rootContainer.style.backgroundImage = `linear-gradient(${theme.degrees}deg, ${theme.primary}, ${theme.secondary})`;
    abWindow.readyToShow(winId);
  });
</script>
