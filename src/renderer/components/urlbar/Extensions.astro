---

<div id="extensions"></div>

<script>
  import { IExtension } from '~/types';
  import { getSearchParams, Renderer, h, c } from '#/scripts';

  const { winId } = getSearchParams();

  const renderer = new Renderer(renderExtensions([]), 'extensions').render();

  abExtensions.onRefresh((_event, extensions) => renderer.update(renderExtensions(extensions)));

  function renderExtensions(extensions: IExtension[]) {
    if (extensions.length === 0) {
      return h('div', {}, '');
    }

    return h(
      'div',
      { class: c('flex', 'gap-2', 'mr-8', 'ml-3', 'min-w-6') },
      ...extensions.map((extension) =>
        h('img', {
          src: extension.icon,
          class: c(
            'w-5',
            'h-5',
            'rounded',
            'object-cover',
            'cursor-pointer',
            'hover:bg-white/15',
            'p-0.5',
          ),
          style: 'app-region: no-drag;',
          onclick: (e) => {
            const img = e.target as HTMLImageElement;
            const bounds = img.getBoundingClientRect();

            const y = Math.round(bounds.top);
            const x = Math.round(bounds.left);
            abExtensions.openPopup(winId, extension.id, x, y);
          },
        }),
      ),
    );
  }
</script>
