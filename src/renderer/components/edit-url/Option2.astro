---
import QueryParamsTable from './QueryParamsTable.astro';
---

<div class="flex flex-col gap-2 max-h-125 overflow-y-auto">
  <h2>Option 2 <small class="text-gray-500">(Modify url by parts)</small></h2>
  <label class="input text-black w-full">
    Protocol:
    <input class="grow" placeholder="Protocol" id="input-protocol" />
  </label>
  <label class="input text-black w-full">
    Hostname:
    <input class="grow" placeholder="Hostname" id="input-hostname" />
  </label>
  <label class="input text-black w-full">
    Port:
    <input class="grow" placeholder="Port" id="input-port" />
  </label>
  <label class="input text-black w-full">
    Pathname:
    <input class="grow" placeholder="Pathname" id="input-pathname" />
  </label>
  <label class="input text-black w-full">
    Hash:
    <input class="grow" placeholder="Hash" id="input-hash" />
  </label>
  <QueryParamsTable />
</div>
