---
import Layout from '#/layouts/Base.astro';
---

<Layout>
  <div id="container"></div>
</Layout>

<script>
  import { Renderer, h, c, inputManager, getSearchParams, type VNode, btnIcon } from '#/scripts';
  import type { IFindInPageResult } from '~/types';
  import Close from '#/icons/close.svg?raw';
  import Previous from '#/icons/previous.svg?raw';
  import Next from '#/icons/next.svg?raw';
  import { initI18n, t, onLocaleChange } from '#/scripts/i18n';

  await initI18n();

  const { searchParams } = getSearchParams();
  const tabId = parseInt(searchParams.get('tabId')!, 10);

  const renderer = new Renderer(render()).render('container');

  const { inputEl } = inputManager('search', {
    onAccept: (value) => abTabs.findInPageAction(tabId, 'next', value),
    onCancel: () => abTabs.closeFindInTab(tabId),
    onChange: (value) => abTabs.findInPageAction(tabId, 'start', value),
  });

  abTabs.onRefreshFindInPage((_event, result: IFindInPageResult | null) => {
    renderer.update(render(result));
  });

  function render(result?: IFindInPageResult | null): VNode {
    return h(
      'div',
      {
        class: c(
          'flex',
          'items-center',
          'gap-2',
          'p-2',
          'bg-base-200',
          'rounded-xl',
          'text-base-content',
        ),
      },
      btnIcon(Close, {
        classNames: ['text-base-content'],
        onClick: () => abTabs.closeFindInTab(tabId),
      }),
      h(
        'input',
        {
          class: c('input', 'input-xs', 'text-base-content', 'rounded-full'),
          placeholder: t('pages.findInPage.placeholder'),
          autofocus: true,
          onfocus: (event) => (event.target as HTMLInputElement).select(),
          id: 'search',
        },
        '',
      ),
      btnIcon(Previous, {
        classNames: ['text-base-content'],
        onClick: () => abTabs.findInPageAction(tabId, 'previous', inputEl.value),
      }),
      btnIcon(Next, {
        classNames: ['text-base-content'],
        onClick: () => abTabs.findInPageAction(tabId, 'next', inputEl.value),
      }),
      result
        ? h(
            'div',
            { class: c('text-sm', 'ml-4') },
            `${result.activeMatch} of ${result.matches} ${t('pages.findInPage.match', { count: result.matches })}`,
          )
        : null,
    );
  }

  onLocaleChange(() => renderer.update(render()));
</script>
