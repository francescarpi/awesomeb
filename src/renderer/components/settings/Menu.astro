<div id="settings-menu"></div>

<script>
  import { Renderer, h, c, type VNode, settingsMenuItems } from '#/scripts';

  /** Locale is static per session (changing it requires an app restart), so the
   * menu translations are fetched once and reused across navigation re-renders. */
  const cache: { t?: Record<string, string> } = {};

  let renderer: Renderer;

  async function buildMenu(): Promise<VNode> {
    if (!cache.t) {
      cache.t = await abI18n.t(
        -1,
        settingsMenuItems.map((item) => ({ key: item.nameKey })),
      );
    }
    const t = cache.t;

    return h(
      'ul',
      {
        class: c('menu', 'menu-horizontal', 'bg-white/10', 'rounded-box', 'w-full', 'mb-4'),
      },
      ...settingsMenuItems.map((item) =>
        h(
          'li',
          null,
          h(
            'a',
            {
              onclick: () => handleNavItemClick(item.hash[0]),
              class: c(item.hash.includes(window.location.hash) && 'menu-active'),
            },
            t[item.nameKey],
          ),
        ),
      ),
    );
  }

  async function handleNavItemClick(hash: string) {
    window.history.pushState({}, '', hash);
    renderer.update(await buildMenu());
    window.dispatchEvent(new CustomEvent('app:navigate'));
  }

  (async () => {
    renderer = new Renderer(await buildMenu()).render('settings-menu');
  })();
</script>
