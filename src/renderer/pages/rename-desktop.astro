---
import BlackBgWithTitle from '../layouts/BlackBgWithTitle.astro';
---

<BlackBgWithTitle title="Rename Desktop">
  <input
    class="input w-full text-black rounded-full"
    placeholder="Set new desktop name..."
    autofocus
  />
</BlackBgWithTitle>

<script>
  import { IDesktopEntity } from '~/types';
  import { getSearchParams } from '../scripts/url';
  import { inputManager } from '../scripts/inputs';
  const { winId, searchParams } = getSearchParams();
  const desktopId = searchParams.get('desktopId');

  const inputEl = document.querySelector('input')! as HTMLInputElement;

  async function setup() {
    // Fetch desktops
    const desktopEntities = (await abEntities.fetch(winId, 'desktops')) as IDesktopEntity[];

    // Find selected desktop
    const selectedDesktop = desktopId
      ? desktopEntities.find((d: IDesktopEntity) => d.id === desktopId)!
      : desktopEntities.find((d) => d.selected)!;

    const { setDefaultValue } = inputManager(
      inputEl,
      (newValue: string) =>
        abCommands.perform(winId, 'rename-desktop', {
          desktopId: parseInt(selectedDesktop.id, 10),
          name: newValue,
        }),
      () => abModal.close(winId),
    );
    setDefaultValue(selectedDesktop.name || '');
  }

  setup();
</script>
