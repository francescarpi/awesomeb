{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "src/shared/**/*",
    "src/renderer/**/*",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "bundler",
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/main/*"],
      "~/*": ["src/shared/*"]
    }
  }
}
