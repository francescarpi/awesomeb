---
import Modal from '#/layouts/Modal.astro';
import ListWithSearch from '#/components/common/ListWithSearch.astro';
import Title from '#/components/common/Title.astro';
---

<Modal width="600px" height="500px">
  <Title><span id="title-tab-select">Select tab</span></Title>
  <ListWithSearch placeholder="Filter and select a tab..." id="list" />
</Modal>

<script>
  import { getSearchParams, listWithSearchManager } from '#/scripts';
  import {
    initI18n,
    setText,
    setPlaceholder,
    setListEmptyText,
    onLocaleChange,
  } from '#/scripts/i18n';

  await initI18n();

  function apply() {
    setText('title-tab-select', 'pages.tabSelect.title');
    setPlaceholder('list', 'pages.tabSelect.listPlaceholder');
    setListEmptyText();
  }
  apply();
  onLocaleChange(apply);

  const { winId } = getSearchParams();

  listWithSearchManager('list', {
    entity: 'tabs',
    onAccept: (item) => {
      abCommands.perform(winId, 'select-tab', { tabId: parseInt(item.id, 10) });
    },
    onEscape: () => {
      abModal.close(winId);
    },
  });
</script>
