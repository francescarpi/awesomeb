---
import Modal from '#/layouts/Modal.astro';
import Title from '#/components/common/Title.astro';
---

<Modal>
  <Title title="pages:renameTab.title" />
  <div id="content"></div>
</Modal>

<script>
  import { Renderer, h, c, input, getSearchParams, confirmButtons } from '#/scripts';
  import { ITabEntity } from '~/types';

  const { winId, searchParams } = getSearchParams();
  const tabId = searchParams.get('tabId') as string;
  const t = await abI18n.t(winId, [{ key: 'pages:renameTab.name' }]);

  const tabsEntitites = (await abEntities.fetch(winId, 'tabs')) as ITabEntity[];
  const selectedTab = tabId
    ? tabsEntitites.find((d: ITabEntity) => d.id === tabId)!
    : tabsEntitites.find((d) => d.selected)!;

  const [btns, registerBtnsEvents] = await confirmButtons({
    winId,
    onConfirm: () => {
      const nameField = document.getElementById('name') as HTMLInputElement;

      abCommands.perform(winId, 'rename-tab', {
        tabId: parseInt(selectedTab.id, 10),
        name: nameField.value,
      });
    },
    onCancel: () => {
      abModal.close(winId);
    },
  });

  new Renderer(
    h(
      'div',
      { class: c('flex', 'flex-col', 'gap-2') },
      input('name', t['pages:renameTab.name'], selectedTab.label || '', { maxLength: 20 }),
      h('div', { class: c('flex', 'justify-end', 'gap-2', 'mt-4') }, ...btns),
    ),
  ).render('content', {
    onRendered: () => {
      const name = document.getElementById('name') as HTMLInputElement;
      name.focus();
      name.select();
      registerBtnsEvents();
    },
  });
</script>
