---
import Base from '../layouts/Base.astro';
---

<Base>
  <div class="fixed inset-0 flex flex-col justify-end mr-1 mb-1">
    <div class="text-xs bg-black p-4 rounded-br-xl" id="short-version">
      Listening for mark. <b class="text-warning">Hold</b> to see more details...
    </div>
    <div class="text-xs bg-black p-4 rounded-br-xl hidden flex-col gap-4" id="full-version">
      <p class="text-lg">Available tab marks...</p>

      <p id="no-marks">No maks...</p>

      <div class="grid grid-cols-[50px_auto] border-t border-t-warning pt-2 mt-2">
        <span class="text-warning">m</span>
        <p>Press "m" followed by a letter to mark the active tab (e.g., ma, mb, mc, ...)</p>
        <span class="text-warning">n</span>
        <p>Delete the mark from the active tab</p>
        <span class="text-warning">b</span>
        <p>Delete all marks</p>
        <span class="text-warning">&lt;letter&gt;</span>
        <p>Select the tab marked with that letter (e.g., a, b, c, ...)</p>
      </div>
    </div>
  </div>
</Base>

<script>
  import { getSearchParams } from '../scripts/url';
  import { ITabMark } from '~/types';

  const { winId } = getSearchParams();
  const shortVersion = document.getElementById('short-version')!;
  const fullVersion = document.getElementById('full-version')!;

  let markMode = false;
  let marks: ITabMark[] = [];

  async function loadTabMarks() {
    marks = await abTabMarks.get(winId);
    // TODO call render marks
  }

  loadTabMarks();

  function handleKeyUp(event: KeyboardEvent) {
    if (event.key === 'Meta') {
      event.preventDefault();
      abTabMarks.close(winId);
    }
  }

  async function handleKeyDown(event: KeyboardEvent) {
    event.preventDefault();
    event.stopPropagation();

    if (event.key === 'b') {
      marks = await abTabMarks.perform(winId, { id: 'deleteAll' });
      // updateMarks(marksReturned)
      return;
    }

    if (event.key === 'n') {
      marks = await abTabMarks.perform(winId, { id: 'deleteOne' });
      // updateMarks(marksReturned)
      return;
    }

    if (event.key === 'm' && !markMode) {
      markMode = true;
      return;
    }

    if (markMode) {
      markMode = false;
      marks = await abTabMarks.perform(winId, { id: 'add', trigger: event.key });
      // updateMarks(marksReturned)
      return;
    }

    const mark = marks.find((m) => m.trigger.toLowerCase() === event.key.toLowerCase());
    if (mark) {
      abTabMarks.perform(winId, { id: 'select', trigger: mark.trigger });
    }
  }

  window.addEventListener('keyup', handleKeyUp);
  window.addEventListener('keydown', handleKeyDown);

  setTimeout(() => {
    shortVersion.classList.add('hidden');
    fullVersion.classList.remove('hidden');
    fullVersion.classList.add('flex');
  }, 1500);
</script>
