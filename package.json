{
  "name": "AwesomeB",
  "version": "0.14.9-alpha",
  "description": "",
  "main": "dist-electron/main/index.js",
  "repository": "https://github.com/francescarpi/awesomeb.git",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "build": "astro build && electron-vite build && electron-builder",
    "build:mac": "astro build && electron-vite build && electron-builder --mac",
    "build:win": "astro build && electron-vite build && electron-builder --win",
    "build:linux": "astro build && electron-vite build && electron-builder --linux",
    "start": "electron-vite preview",
    "format": "prettier --write src",
    "test": "vitest",
    "lint": "eslint .",
    "tscheck:node": "tsc --noEmit --project tsconfig.node.json --composite false",
    "tscheck:renderer": "tsc --noEmit --project tsconfig.renderer.json --composite false",
    "tscheck": "npm run tscheck:node && npm run tscheck:renderer",
    "husky:install": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,astro,js}": [
      "pnpm astro check",
      "bash -c 'pnpm tscheck'",
      "bash -c 'pnpm test run'",
      "pnpm lint"
    ],
    "src/**/*.{ts,js,json,css,md,astro}": [
      "pnpm exec prettier --write src"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.0",
    "@types/mime-types": "3.0.1",
    "astro": "7.3.5",
    "astro-icon": "1.2.0",
    "concurrently": "10.0.5",
    "daisyui": "5.7.44",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "electron-vite": "6.0.0-beta.1",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.5.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.0.1",
    "tailwindcss": "4.3.3",
    "tsc-alias": "1.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.0.1"
